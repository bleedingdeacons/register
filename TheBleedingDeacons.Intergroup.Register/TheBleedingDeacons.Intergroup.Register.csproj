		</MauiXaml>
	</ItemGroup>

	<ItemGroup>
		<Folder Include="Data\Configurations\" />
		<Folder Include="Resources\Raw\" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\TheBleedingDeacons.Unity.Intergroup\TheBleedingDeacons.Unity.Intergroup.csproj" />
	</ItemGroup>

	<!-- TODO: Re-add Integrity.Client as a NuGet package or relative project reference -->

