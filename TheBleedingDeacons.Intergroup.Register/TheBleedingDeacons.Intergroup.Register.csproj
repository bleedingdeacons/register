<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net9.0-android;net9.0-ios;net9.0-maccatalyst</TargetFrameworks>
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net9.0-windows10.0.19041.0</TargetFrameworks>
		<!-- CI builds only the Android head so it doesn't need the iOS/MacCatalyst
		     workloads. Pass -p:RegisterAndroidOnly=true (see .github/workflows/ci.yml).
		     This override is last so it wins when the flag is set; local builds
		     without the flag keep the full framework set above. -->
		<TargetFrameworks Condition="'$(RegisterAndroidOnly)' == 'true'">net9.0-android</TargetFrameworks>

		<OutputType>Exe</OutputType>
		<RootNamespace>TheBleedingDeacons.Intergroup.Register</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!--
			Compile XAML bindings that set Source (mostly {x:Reference} bindings
			in Controls/*.xaml). Off by default in MAUI 9 so it doesn't silently
			change existing apps; each such binding needs an x:DataType matching
			the *Source's* type rather than the surrounding BindingContext.
			A mismatch is not fatal — XamlC warns and falls back to a reflection
			binding — but compiled bindings stop being optional once iOS release
			builds turn on full trimming / NativeAOT, so keep this clean.
		-->
		<MauiEnableXamlCBindingWithSourceCompilation>true</MauiEnableXamlCBindingWithSourceCompilation>

		<!--
			All XAML bindings compile as of the change that introduced this, so
			hold that line: a binding that silently drops back to reflection is
			both slower and unsafe under the full trimming that iOS release
			builds use. XC0045 (property not found on the x:DataType) is the one
			that catches actual typos.

			XC0103 is deliberately absent: it fires on markup extensions, which
			can arrive from a package update rather than from this repo.
		-->
		<WarningsAsErrors>$(WarningsAsErrors);XC0022;XC0023;XC0024;XC0025;XC0045</WarningsAsErrors>

		<!-- Display name -->
		<ApplicationTitle>Intergroup Register</ApplicationTitle>

		<!-- App Identifier -->
		<ApplicationId>com.thebleedingdeacons.intergroup.register</ApplicationId>

		<!--
			Versions. ApplicationDisplayVersion must stay unconditional: it feeds
			PackageVersion, which NuGet requires to have a single value across all
			target frameworks.

			It previously defaulted to 1.0 here and was overridden to 1.0.26 in eight
			per-Configuration/TargetFramework/Platform groups that all tested
			Platform=='AnyCPU'. Visual Studio evaluates with the solution platform
			'Any CPU' — with a space — so those conditions missed and the default 1.0
			applied, while other evaluations got 1.0.26. NuGet then saw both 1.0.0 and
			1.0.26 across the target frameworks and failed the restore with NU1105.
			A command-line build never hit it, because there Platform defaults to the
			'AnyCPU' declared below.

			Visual Studio's project-properties version editor writes those per-config
			groups back. If it does, collapse them here again rather than leaving the
			value split.
		-->
		<ApplicationDisplayVersion>1.0.26</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">11.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">13.1</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
		<DefaultLanguage>en-gb</DefaultLanguage>
		<Copyright>Don't take yourself too damn seriously</Copyright>
		<AssemblyVersion>1.0.6.1</AssemblyVersion>
		<FileVersion>1.0.6.1</FileVersion>
		<Platforms>AnyCPU</Platforms>
		<AndroidSigningKeyStore>register.keystore</AndroidSigningKeyStore>
	</PropertyGroup>

	<PropertyGroup>
		<UseDevCredentials Condition="'$(UseDevCredentials)' == ''">true</UseDevCredentials>
		<DefineConstants Condition="'$(UseDevCredentials)' == 'true'">$(DefineConstants);USE_DEV_CREDENTIALS</DefineConstants>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Release|net9.0-android|AnyCPU'">
		<AndroidPackageFormat>apk</AndroidPackageFormat>
		<AndroidUseAapt2>True</AndroidUseAapt2>
		<AndroidCreatePackagePerAbi>False</AndroidCreatePackagePerAbi>
		<DebugSymbols>True</DebugSymbols>
		<AndroidKeyStore>True</AndroidKeyStore>
	</PropertyGroup>

	<ItemGroup>
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" ForegroundScale="0.66" Color="#F4F7FA" />
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#3977C3" BaseSize="128,128" />
		<MauiImage Include="Resources\Images\*" />
		<MauiFont Include="Resources\Fonts\*" />
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<AndroidResource Remove="Platforms\Android\Resources\values\styles.xml" />
	</ItemGroup>

	<ItemGroup>
		<None Remove="Platforms\Android\Resources\xml\file_paths.xml" />
		<None Remove="Templates\ComplianceAcceptanceEmail.html" />
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Include="Templates\ComplianceAcceptanceEmail.html" />
		<EmbeddedResource Include="Templates\WelcomeEmail.html" />
		<EmbeddedResource Include="appsettings.json" />
		<None Remove="appsettings.json" />
	</ItemGroup>

	<!-- Dev credentials: only embedded when UseDevCredentials=true (the default).
	     Production builds pass -p:UseDevCredentials=false so this file is never
	     touched and cannot leak into the APK. -->
	<ItemGroup Condition="'$(UseDevCredentials)' == 'true'">
		<EmbeddedResource Include="devsettings.json" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Ben.Demystifier" Version="0.4.1" />
		<PackageReference Include="libphonenumber-csharp" Version="9.0.28" />
		<PackageReference Include="MailKit" Version="4.16.0" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="9.0.9" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="9.0.9">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="EPPlus" Version="8.2.0" />
		<PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="9.0.9" />
		<PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="9.0.9" />
		<PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="9.0.9" />
		<PackageReference Include="Microsoft.Maui.Controls" Version="9.0.120" />
		<PackageReference Include="Microsoft.Maui.Controls.Compatibility" Version="9.0.120" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="9.0.9" />
		<PackageReference Include="CommunityToolkit.Maui" Version="12.2.0" />
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
		<PackageReference Include="Serilog" Version="4.3.0" />
		<PackageReference Include="Serilog.Settings.Configuration" Version="9.0.0" />
		<PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
		<PackageReference Include="Serilog.Sinks.Debug" Version="3.0.0" />
		<PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
		<!--
			Durable HTTP sink replaces BetterStack.Logs.Serilog so that log
			events survive loss of internet and hard app kills. Events are
			written to a rolling on-disk buffer first, then shipped to
			Better Stack in the background. If the device is offline the
			buffer just grows until connectivity returns. See
			Support/BetterStackDurable/*.cs for the thin glue layer
			(auth header + NDJSON formatter).
		-->
		<PackageReference Include="Serilog.Sinks.Http" Version="9.2.0" />
		<PackageReference Include="Serilog.Extensions.Logging" Version="9.0.0" />
		<PackageReference Include="SonarAnalyzer.CSharp" Version="10.15.0.120848">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="System.Formats.Asn1" Version="9.0.9" />
		<PackageReference Include="System.Security.Cryptography.Xml" Version="9.0.18" />
		<PackageReference Include="System.Text.Json" Version="9.0.9" />
	</ItemGroup>
	<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
		<PackageReference Include="System.Net.Http.WinHttpHandler" Version="9.0.0" />
	</ItemGroup>
	<ItemGroup>
		<MauiXaml Update="Controls\ClearableEntry.xaml">
			<Generator>MSBuild:Compile</Generator>
		</MauiXaml>
		<MauiXaml Update="Controls\CloseableEntry.xaml">
			<Generator>MSBuild:Compile</Generator>
		</MauiXaml>
		<MauiXaml Update="Controls\MaskedRevealLabel.xaml">
			<Generator>MSBuild:Compile</Generator>
		</MauiXaml>
		<MauiXaml Update="Controls\GroupMemberCard.xaml">
			<Generator>MSBuild:Compile</Generator>
		</MauiXaml>
		<MauiXaml Update="Controls\PositionMemberCard.xaml">
			<Generator>MSBuild:Compile</Generator>
		</MauiXaml>
		<MauiXaml Update="Views\DatabaseBackupPage.xaml">
			<Generator>MSBuild:Compile</Generator>
		</MauiXaml>
		<MauiXaml Update="Views\DaySelectionPage.xaml">
			<Generator>MSBuild:Compile</Generator>
		</MauiXaml>
		<MauiXaml Update="Views\EmailStatusPage.xaml">
			<Generator>MSBuild:Compile</Generator>
		</MauiXaml>
		<MauiXaml Update="Views\GroupSelectionPage.xaml">
			<Generator>MSBuild:Compile</Generator>
		</MauiXaml>
		<MauiXaml Update="Views\GroupEditPage.xaml">
			<Generator>MSBuild:Compile</Generator>
		</MauiXaml>
		<MauiXaml Update="Views\PositionEditPage.xaml">
			<Generator>MSBuild:Compile</Generator>
		</MauiXaml>
		<MauiXaml Update="Views\PositionSelectionPage.xaml">
			<Generator>MSBuild:Compile</Generator>
		</MauiXaml>
		<MauiXaml Update="Views\PositionVerifyPage.xaml">
			<Generator>MSBuild:Compile</Generator>
		</MauiXaml>
		<MauiXaml Update="Views\RegistrationOverviewPage.xaml">
			<Generator>MSBuild:Compile</Generator>
		</MauiXaml>
		<MauiXaml Update="Views\SettingsPage.xaml">
			<Generator>MSBuild:Compile</Generator>
		</MauiXaml>
		<MauiXaml Update="Views\TypeSelectionPage.xaml">
			<Generator>MSBuild:Compile</Generator>
		</MauiXaml>
	</ItemGroup>

	<ItemGroup>
		<Folder Include="Data\Configurations\" />
		<Folder Include="Resources\Raw\" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\TheBleedingDeacons.Unity.Intergroup\TheBleedingDeacons.Unity.Intergroup.csproj" />
	</ItemGroup>

	<!-- TODO: Re-add Integrity.Client as a NuGet package or relative project reference -->

	<ItemGroup>
		<Compile Update="Controls\InteractiveEntry.xaml.cs">
		  <DependentUpon>InteractiveEntry.xaml</DependentUpon>
		</Compile>
		<Compile Update="Views\GroupEditPage.xaml.cs">
			<DependentUpon>GroupEditPage.xaml</DependentUpon>
		</Compile>
		<Compile Update="Views\DatabaseBackupPage.xaml.cs">
			<DependentUpon>DatabaseBackupPage.xaml</DependentUpon>
		</Compile>
		<Compile Update="Views\GroupSelectionPage.xaml.cs">
			<DependentUpon>GroupSelectionPage.xaml</DependentUpon>
		</Compile>
	</ItemGroup>

</Project>