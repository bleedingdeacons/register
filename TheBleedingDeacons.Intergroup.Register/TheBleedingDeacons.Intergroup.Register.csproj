<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net10.0-android;net10.0-ios;net10.0-maccatalyst</TargetFrameworks>
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>
		<!-- CI builds one head per job so neither runner needs the workloads for
		     the others. Pass -p:RegisterAndroidOnly=true or
		     -p:RegisterWindowsOnly=true (see .github/workflows/ci.yml).

		     Do NOT reach for the -f (framework) option instead: that sets
		     TargetFramework as a global property, which forces the chosen TFM onto
		     the net10.0-only projects in this repo and breaks their restore with
		     NU1105. These
		     flags narrow only this project's TargetFrameworks, leaving each
		     project reference free to resolve its own.

		     These overrides are last so they win when a flag is set; local builds
		     without either flag keep the full framework set above. -->
		<TargetFrameworks Condition="'$(RegisterAndroidOnly)' == 'true'">net10.0-android</TargetFrameworks>
		<TargetFrameworks Condition="'$(RegisterWindowsOnly)' == 'true'">net10.0-windows10.0.19041.0</TargetFrameworks>

		<OutputType>Exe</OutputType>
		<RootNamespace>TheBleedingDeacons.Intergroup.Register</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!--
			Compile XAML bindings that set Source (mostly {x:Reference} bindings
			in Controls/*.xaml). Off by default in MAUI 9 so it doesn't silently
			change existing apps; each such binding needs an x:DataType matching
			the *Source's* type rather than the surrounding BindingContext.
			A mismatch is not fatal — XamlC warns and falls back to a reflection
			binding — but compiled bindings stop being optional once iOS release
			builds turn on full trimming / NativeAOT, so keep this clean.
		-->
		<MauiEnableXamlCBindingWithSourceCompilation>true</MauiEnableXamlCBindingWithSourceCompilation>

		<!--
			All XAML bindings compile as of the change that introduced this, so
			hold that line: a binding that silently drops back to reflection is
			both slower and unsafe under the full trimming that iOS release
			builds use. XC0045 (property not found on the x:DataType) is the one
			that catches actual typos.

			XC0103 is deliberately absent: it fires on markup extensions, which
			can arrive from a package update rather than from this repo.
		-->
		<WarningsAsErrors>$(WarningsAsErrors);XC0022;XC0023;XC0024;XC0025;XC0045</WarningsAsErrors>

		<!-- Display name -->
		<ApplicationTitle>Intergroup Register</ApplicationTitle>

		<!-- App Identifier -->
		<ApplicationId>com.thebleedingdeacons.intergroup.register</ApplicationId>

		<!--
			Versions. ApplicationDisplayVersion must stay unconditional: it feeds
			PackageVersion, which NuGet requires to have a single value across all
			target frameworks.

			It previously defaulted to 1.0 here and was overridden to 1.0.26 in eight
			per-Configuration/TargetFramework/Platform groups that all tested
			Platform=='AnyCPU'. Visual Studio evaluates with the solution platform
			'Any CPU' — with a space — so those conditions missed and the default 1.0
			applied, while other evaluations got 1.0.26. NuGet then saw both 1.0.0 and
			1.0.26 across the target frameworks and failed the restore with NU1105.
			A command-line build never hit it, because there Platform defaults to the
			'AnyCPU' declared below.

			Visual Studio's project-properties version editor writes those per-config
			groups back. If it does, collapse them here again rather than leaving the
			value split.

			Version must be set here too, and not left to the MAUI targets. Only the
			Android head derives Version from ApplicationDisplayVersion; the Windows
			head leaves it at the default VersionPrefix of 1.0.0. PackageVersion
			follows Version, so the two heads disagreed and NU1105 came back. A
			command-line restore does not run NuGet's cross-framework consistency
			check, so this only ever shows up in Visual Studio.
		-->
		<ApplicationDisplayVersion>1.2.1</ApplicationDisplayVersion>
		<Version>$(ApplicationDisplayVersion)</Version>
		<ApplicationVersion>7</ApplicationVersion>

		<!--
			Platform floors, raised for .NET 10.

			android 21 -> 24: the .NET 10 templates moved the default to 24
			(Nougat) because API 21-23 hit "desugaring" runtime crashes when a
			dependency uses Java default interface methods. 21 is still
			*supported*, but it is the configuration that crashes.

			ios 11.0 -> 15.0 and maccatalyst 13.1 -> 15.0: 11.0 was below even
			the .NET 9 floor (12.2) and only went unnoticed because no CI job
			builds these heads. 15.0/15.0 is what the .NET 10 templates use and
			what CommunityToolkit.Maui is built against.
		-->
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
		<DefaultLanguage>en-gb</DefaultLanguage>
		<Copyright>Don't take yourself too damn seriously</Copyright>
		<!--
			Derived, not hand-written. These were stuck at 1.0.6.1 while the
			display version had moved on to 1.0.28, and that was not cosmetic:
			MauiProgram.AppVersion() reads FileVersion from the running process
			on Windows, so the Windows head stamped 1.0.6.1 onto every log event
			sent to Better Stack and onto the main page, while Android reported
			the real version. Two heads of the same build disagreeing about
			which build they are.

			Deriving from ApplicationDisplayVersion means one number to bump.
			The trailing .0 makes the four-part version the attributes want out
			of the three-part display string — so keep ApplicationDisplayVersion
			three-part, or this produces five parts and the build fails.
		-->
		<AssemblyVersion>$(ApplicationDisplayVersion).0</AssemblyVersion>
		<FileVersion>$(ApplicationDisplayVersion).0</FileVersion>

		<!--
			When this build was made, to the second, stamped at build time.

			It goes in InformationalVersion because that is the only one of the
			three that can hold it. AssemblyVersion and FileVersion are four
			16-bit fields capped at 65534 each — a yyyyMMddHHmmss stamp is about
			202 billion, and AssemblyVersion fails the build outright rather
			than warning. InformationalVersion is a free-form string with no
			numeric limits, which is exactly what SemVer build metadata is for.

			Stamped UTC so builds either side of a BST change still sort and
			compare honestly. BuildInfo converts it to the device's local time
			for display, which is the form an operator can act on.

			IncludeSourceRevisionInInformationalVersion is off because the SDK
			would otherwise append '+<commit sha>' of its own, and the result
			would carry two '+' segments — BuildInfo parses on the first one.

			Cost worth knowing: this value changes every build, so the generated
			AssemblyInfo.cs changes every build, so this assembly recompiles even
			when nothing else has. Condition it on Release if that churn ever
			outweighs knowing exactly which build is on a tablet.
		-->
		<BuildTimestampUtc>$([System.DateTime]::UtcNow.ToString("yyyyMMddHHmmss"))</BuildTimestampUtc>
		<InformationalVersion>$(ApplicationDisplayVersion)+$(BuildTimestampUtc)</InformationalVersion>
		<IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>

		<Platforms>AnyCPU</Platforms>
	</PropertyGroup>

	<PropertyGroup>
		<UseDevCredentials Condition="'$(UseDevCredentials)' == ''">true</UseDevCredentials>
		<DefineConstants Condition="'$(UseDevCredentials)' == 'true'">$(DefineConstants);USE_DEV_CREDENTIALS</DefineConstants>
	</PropertyGroup>

	<!--
		Ship one ABI.

		The Android SDK defaults RuntimeIdentifiers to 'android-arm64;android-x64'
		when it is unset, and the 1.0.26 APK proves the cost: 45.2 MB of arm64-v8a
		and 45.2 MB of x86_64, an exact half of the payload spent on an ABI that
		only an emulator ever loads. Restricting Release takes the download from
		~57 MB to ~31 MB with no change to the code that actually runs on a tablet.

		Release only — Debug keeps both ABIs so emulator debugging is unaffected.
		To install a Release build on an emulator, override on the command line:
		    -p:RuntimeIdentifiers="android-arm64;android-x64"

		Deliberately NOT placed in the Release|<tfm>|AnyCPU group below: that
		condition tests $(Platform), which Visual Studio evaluates as 'Any CPU'
		— with a space — so it silently misses there while matching on the command
		line via the <Platforms>AnyCPU</Platforms> above. See the long note on
		ApplicationDisplayVersion for the last time that cost us a day. A VS
		Release build would quietly keep both ABIs. GetTargetPlatformIdentifier
		is the form already used for SupportedOSPlatformVersion and has no such
		trap.
	-->
	<PropertyGroup Condition="'$(Configuration)' == 'Release' and $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
		<RuntimeIdentifiers>android-arm64</RuntimeIdentifiers>

		<!--
			Sign only when a keystore is actually supplied.

			This used to be an unconditional AndroidKeyStore=True alongside
			AndroidSigningKeyStore=register.keystore — a file that has never
			existed in this repo. The real signing key is badi.keystore, which
			lives outside the tree and is passed in by build-register.ps1, so
			the declared default was dead weight that only ever fired as
			XA4310 ("keystore file could not be found") the moment anyone ran a
			plain `dotnet publish -c Release`. Signing a release is a
			deliberate act with a password attached; it should not be the
			accidental default of every Release build.

			Naming a keystore is the opt-in, and it is taken at face value: if
			the file turns out to be missing the build fails with XA4310 rather
			than quietly emitting an unsigned APK, because someone who passed a
			key path meant to sign and should hear about a typo. Only the
			no-keystore case goes unsigned, which is what CI and any local
			size/verification build actually wants.

			Explicit values always win, so build-register.ps1 — which passes
			AndroidKeyStore=true along with the key path and passwords — is
			untouched by either condition.
		-->
		<AndroidKeyStore Condition="'$(AndroidKeyStore)' == '' and '$(AndroidSigningKeyStore)' != ''">true</AndroidKeyStore>
		<AndroidKeyStore Condition="'$(AndroidKeyStore)' == ''">false</AndroidKeyStore>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Release|net10.0-android|AnyCPU'">
		<AndroidPackageFormat>apk</AndroidPackageFormat>
		<AndroidUseAapt2>True</AndroidUseAapt2>
		<AndroidCreatePackagePerAbi>False</AndroidCreatePackagePerAbi>
		<DebugSymbols>True</DebugSymbols>
		<!-- AndroidKeyStore moved to the group above: it belongs with the
		     keystore-presence logic, and this group's $(Platform) condition is
		     the one Visual Studio misses. -->
	</PropertyGroup>

	<ItemGroup>
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" ForegroundScale="0.66" Color="#F4F7FA" />
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#3977C3" BaseSize="128,128" />
		<MauiImage Include="Resources\Images\*" />
		<MauiFont Include="Resources\Fonts\*" />
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<AndroidResource Remove="Platforms\Android\Resources\values\styles.xml" />
	</ItemGroup>

	<ItemGroup>
		<None Remove="Platforms\Android\Resources\xml\file_paths.xml" />
		<None Remove="Templates\ComplianceAcceptanceEmail.html" />
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Include="Templates\ComplianceAcceptanceEmail.html" />
		<EmbeddedResource Include="Templates\WelcomeEmail.html" />
		<EmbeddedResource Include="appsettings.json" />
		<None Remove="appsettings.json" />
	</ItemGroup>

	<!-- Dev credentials: only embedded when UseDevCredentials=true (the default).
	     Production builds pass -p:UseDevCredentials=false so this file is never
	     touched and cannot leak into the APK. -->
	<ItemGroup Condition="'$(UseDevCredentials)' == 'true'">
		<EmbeddedResource Include="devsettings.json" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Ben.Demystifier" Version="0.4.1" />
		<PackageReference Include="libphonenumber-csharp" Version="9.0.36" />
		<PackageReference Include="MailKit" Version="4.17.0" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.10" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.10">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="EPPlus" Version="8.6.3" />
		<PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="10.0.10" />
		<PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.10" />
		<PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.10" />
		<PackageReference Include="Microsoft.Maui.Controls" Version="10.0.90" />
		<PackageReference Include="Microsoft.Maui.Controls.Compatibility" Version="10.0.90" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.10" />
		<PackageReference Include="CommunityToolkit.Maui" Version="15.0.0" />
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
		<PackageReference Include="Serilog" Version="4.4.0" />
		<PackageReference Include="Serilog.Settings.Configuration" Version="10.0.1" />
		<PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
		<PackageReference Include="Serilog.Sinks.Debug" Version="3.0.0" />
		<PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
		<!--
			Durable HTTP sink replaces BetterStack.Logs.Serilog so that log
			events survive loss of internet and hard app kills. Events are
			written to a rolling on-disk buffer first, then shipped to
			Better Stack in the background. If the device is offline the
			buffer just grows until connectivity returns. See
			Support/BetterStackDurable/*.cs for the thin glue layer
			(auth header + NDJSON formatter).
		-->
		<PackageReference Include="Serilog.Sinks.Http" Version="9.2.1" />
		<PackageReference Include="Serilog.Extensions.Logging" Version="10.0.0" />
		<PackageReference Include="SonarAnalyzer.CSharp" Version="10.31.0.145097">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<!--
			System.Formats.Asn1 and System.Text.Json used to be referenced here
			to force patched versions over what the graph resolved. On net10.0
			both ship in the shared framework, so the references did nothing but
			shadow it — which is precisely what NU1510 reports. Removed.

			System.Security.Cryptography.Xml is NOT in-box and stays.
		-->
		<PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.10" />
	</ItemGroup>
	<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
		<PackageReference Include="System.Net.Http.WinHttpHandler" Version="10.0.10" />
	</ItemGroup>
	<ItemGroup>
		<MauiXaml Update="Controls\ClearableEntry.xaml">
			<Generator>MSBuild:Compile</Generator>
		</MauiXaml>
		<MauiXaml Update="Controls\CloseableEntry.xaml">
			<Generator>MSBuild:Compile</Generator>
		</MauiXaml>
		<MauiXaml Update="Controls\MaskedRevealLabel.xaml">
			<Generator>MSBuild:Compile</Generator>
		</MauiXaml>
		<MauiXaml Update="Controls\GroupMemberCard.xaml">
			<Generator>MSBuild:Compile</Generator>
		</MauiXaml>
