<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="TheBleedingDeacons.Intergroup.Register.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:TheBleedingDeacons.Intergroup.Register.Views"
    Shell.FlyoutBehavior="Flyout">

    <ShellContent
        Title="Home"
        ContentTemplate="{DataTemplate local:MainPage}"
        Icon="home.png"
        Route="MainPage" />

    <ShellContent
        Title="Registrations"
        ContentTemplate="{DataTemplate local:RegistrationOverviewPage}"
        Icon="registrations.png"
        Route="RegistrationOverviewPage" />

    <ShellContent
        Title="Administration"
        ContentTemplate="{DataTemplate local:AdminPage}"
        Icon="admin.png"
        Route="AdminPage" />

    <ShellContent
        Title="Settings"
        ContentTemplate="{DataTemplate local:SettingsPage}"
        Icon="settings.png"
        Route="SettingsPage" />

</Shell>
