<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="TheBleedingDeacons.Intergroup.Register.Views.AdminPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:TheBleedingDeacons.Intergroup.Register.Controls"
    xmlns:entities="clr-namespace:TheBleedingDeacons.Unity.Intergroup.Entities;assembly=TheBleedingDeacons.Unity.Intergroup"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:vm="clr-namespace:TheBleedingDeacons.Intergroup.Register.ViewModels"
    Title="Administration"
    x:DataType="vm:AdminViewModel">

    <ContentPage.Behaviors>
        <toolkit:StatusBarBehavior StatusBarColor="{AppThemeBinding Light=White, Dark=Black}" StatusBarStyle="{AppThemeBinding Light=DarkContent, Dark=LightContent}" />
    </ContentPage.Behaviors>

    <controls:PageScaffold>
        <controls:PageScaffold.ContentBody>
            <ScrollView>
                <VerticalStackLayout Spacing="20">

                    <!--
                        ═══════════════════════════════════════════════════════
                        STATUS BANNER (Syncing / Finishing / errors)
                        InfoBannerStyle by default; swaps to DangerBannerStyle
                        when IsStatusError is true.
                        ═══════════════════════════════════════════════════════
                    -->
                    <Border IsVisible="{Binding IsStatusVisible}">
                        <Border.Style>
                            <Style BasedOn="{StaticResource InfoBannerStyle}" TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger
                                        Binding="{Binding IsStatusError}"
                                        TargetType="Border"
                                        Value="True">
                                        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource DangerBanner}, Dark={StaticResource DangerBannerDim}}" />
                                        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DangerDark}}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid
                            ColumnDefinitions="Auto,*,Auto"
                            ColumnSpacing="12"
                            VerticalOptions="Center">
                            <ActivityIndicator
                                Grid.Column="0"
                                IsRunning="{Binding IsBusy}"
                                IsVisible="{Binding IsBusy}"
                                VerticalOptions="Center"
                                Color="{AppThemeBinding Light={StaticResource Primary},
                                                        Dark={StaticResource PrimaryDark}}" />
                            <Label
                                Grid.Column="1"
                                FontSize="14"
                                LineBreakMode="WordWrap"
                                Text="{Binding StatusMessage}"
                                TextColor="{AppThemeBinding Light={StaticResource TextBody},
                                                            Dark={StaticResource TextBodyDim}}"
                                VerticalOptions="Center" />
                            <!--
                                Sync Again — visible only on the meeting-selection screen, so the
                                user can re-pull from Unity without leaving the page. Disabled
                                automatically by SyncAgainCommand.CanExecute when offline or once
                                an intergroup meeting has been committed to.
                            -->
                            <Button
                                Grid.Column="2"
                                Command="{Binding SyncAgainCommand}"
                                IsVisible="{Binding IsSelectingMeeting}"
                                Style="{StaticResource M3TextButtonStyle}"
                                Text="Sync Again"
                                VerticalOptions="Center" />
                        </Grid>
                    </Border>


                    <!--
                        ═══════════════════════════════════════════════════════
                        PHASE: NotStarted — Start / Retry
                        ═══════════════════════════════════════════════════════
                    -->
                    <VerticalStackLayout IsVisible="{Binding IsNotStarted}" Spacing="12">

                        <!--  Offline warning — visible only while disconnected; explains why the buttons below are disabled.  -->
                        <Border IsVisible="{Binding IsOnline, Converter={StaticResource InvertedBoolConverter}}" Style="{StaticResource WarningBannerStyle}">
                            <Grid
                                ColumnDefinitions="Auto,*"
                                ColumnSpacing="12"
                                VerticalOptions="Center">
                                <Label
                                    Grid.Column="0"
                                    FontSize="22"
                                    Text="📡"
                                    VerticalOptions="Center" />
                                <Label
                                    Grid.Column="1"
                                    FontSize="14"
                                    LineBreakMode="WordWrap"
                                    Text="No internet connection. Connect to a network to sync with Unity and start the meeting."
                                    TextColor="{AppThemeBinding Light={StaticResource TextBody},
                                                                Dark={StaticResource TextBodyDim}}"
                                    VerticalOptions="Center" />
                            </Grid>
                        </Border>

                        <Label
                            HorizontalOptions="Center"
                            Style="{StaticResource M3EmptyStateTitleStyle}"
                            Text="Ready to Begin" />

                        <Label
                            Margin="20,0,20,8"
                            Style="{StaticResource M3EmptyStateSubtitleStyle}"
                            Text="Tap Start Meeting to sync data from Unity and select today's intergroup meeting." />

                        <Button
                            Command="{Binding StartMeetingCommand}"
                            IsVisible="{Binding HasSyncError, Converter={StaticResource InvertedBoolConverter}}"
                            Style="{StaticResource M3PrimaryButtonStyle}"
                            Text="Start Meeting" />

                        <Button
                            Command="{Binding RetrySyncCommand}"
                            IsVisible="{Binding HasSyncError}"
                            Style="{StaticResource M3SecondaryButtonStyle}"
                            Text="Retry Sync" />
                    </VerticalStackLayout>


                    <!--
                        ═══════════════════════════════════════════════════════
                        PHASE: Syncing — busy state (status banner shows detail)
                        ═══════════════════════════════════════════════════════
                    -->
                    <VerticalStackLayout
                        IsVisible="{Binding IsSyncing}"
                        Spacing="16"
                        VerticalOptions="Center">
                        <Label
                            Margin="0,40,0,0"
                            HorizontalOptions="Center"
                            Style="{StaticResource M3EmptyStateTitleStyle}"
                            Text="Preparing…" />
                        <ActivityIndicator
                            HorizontalOptions="Center"
                            IsRunning="True"
                            Scale="2"
                            Color="{AppThemeBinding Light={StaticResource Primary},
                                                    Dark={StaticResource PrimaryDark}}" />
                    </VerticalStackLayout>


                    <!--
                        ═══════════════════════════════════════════════════════
                        PHASE: SelectMeeting — list of today's meetings
                        ═══════════════════════════════════════════════════════
                    -->
                    <VerticalStackLayout IsVisible="{Binding IsSelectingMeeting}" Spacing="12">

                        <Label Style="{StaticResource HeaderLabelStyle}" Text="Select Today's Meeting" />

                        <CollectionView ItemsSource="{Binding Meetings}" SelectionMode="None">
                            <CollectionView.EmptyView>
                                <VerticalStackLayout Padding="24,40" VerticalOptions="Center">
                                    <Label Style="{StaticResource M3EmptyStateIconStyle}" Text="📅" />
                                    <Label Style="{StaticResource M3EmptyStateTitleStyle}" Text="No Intergroup Meetings Found" />
                                    <Label Style="{StaticResource M3EmptyStateSubtitleStyle}" Text="No meetings were found in the synced data. Check that intergroup meetings exist in Unity, then try again." />
                                    <Button
                                        Margin="0,20,0,0"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:AdminViewModel}}, Path=StartMeetingCommand}"
                                        Style="{StaticResource M3PrimaryButtonStyle}"
                                        Text="Start Meeting" />
                                </VerticalStackLayout>
                            </CollectionView.EmptyView>
                            <CollectionView.ItemsLayout>
                                <LinearItemsLayout ItemSpacing="0" Orientation="Vertical" />
                            </CollectionView.ItemsLayout>
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="entities:IntergroupMeeting">
                                    <Border Padding="0" Style="{StaticResource M3ListItemCardStyle}">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:AdminViewModel}}, Path=SelectMeetingCommand}" CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>

                                        <Grid
                                            Padding="16,14"
                                            ColumnDefinitions="*,Auto"
                                            RowDefinitions="Auto,Auto">

                                            <Label
                                                Grid.Row="0"
                                                Grid.Column="0"
                                                Grid.ColumnSpan="2"
                                                IsVisible="{Binding Title, Converter={toolkit:IsNotNullConverter}}"
                                                Style="{StaticResource FieldLabelStyle}"
                                                Text="{Binding Title}" />

                                            <Label
                                                Grid.Row="1"
                                                Grid.Column="0"
                                                Style="{StaticResource ValueLabelStyle}"
                                                Text="{Binding Date}" />

                                            <Label
                                                Grid.Row="1"
                                                Grid.Column="1"
                                                FontSize="20"
                                                Text="›"
                                                TextColor="{AppThemeBinding Light={StaticResource Gray400},
                                                                            Dark={StaticResource Gray500}}"
                                                VerticalOptions="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>


                    <!--
                        ═══════════════════════════════════════════════════════
                        PHASE: InProgress — active meeting banner + Finish
                        ═══════════════════════════════════════════════════════
                    -->
                    <VerticalStackLayout IsVisible="{Binding IsInProgress}" Spacing="16">

                        <!--  Active meeting banner — uses success palette tokens  -->
                        <Border Style="{StaticResource SuccessBannerStyle}">
                            <Grid
                                ColumnDefinitions="Auto,*"
                                ColumnSpacing="12"
                                VerticalOptions="Center">
                                <Label
                                    Grid.Column="0"
                                    FontSize="28"
                                    Text="✅"
                                    VerticalOptions="Center" />
                                <VerticalStackLayout
                                    Grid.Column="1"
                                    Spacing="2"
                                    VerticalOptions="Center">
                                    <Label
                                        Margin="0"
                                        Style="{StaticResource FieldLabelStyle}"
                                        Text="Meeting In Progress"
                                        TextColor="{AppThemeBinding Light={StaticResource SuccessText},
                                                                    Dark={StaticResource SuccessTextDim}}" />
                                    <Label
                                        FontAttributes="Bold"
                                        FontSize="16"
                                        IsVisible="{Binding ActiveMeetingTitle, Converter={toolkit:IsNotNullConverter}}"
                                        Text="{Binding ActiveMeetingTitle}"
                                        TextColor="{AppThemeBinding Light={StaticResource SuccessText},
                                                                    Dark={StaticResource SuccessTextDim}}" />
                                    <Label
                                        Style="{StaticResource ValueLabelStyle}"
                                        Text="{Binding ActiveMeetingDate}"
                                        TextColor="{AppThemeBinding Light={StaticResource SuccessText},
                                                                    Dark={StaticResource SuccessTextDim}}" />
                                </VerticalStackLayout>
                            </Grid>
                        </Border>

                        <Label
                            Margin="4,4"
                            HorizontalTextAlignment="Center"
                            Style="{StaticResource SecondaryTextStyle}"
                            Text="Registrations and member edits are being recorded locally. When you're done, tap Finish Meeting to push everything to Unity." />

                        <Button
                            Command="{Binding FinishMeetingCommand}"
                            Style="{StaticResource M3PrimaryButtonStyle}"
                            Text="Finish Meeting" />
                    </VerticalStackLayout>


                    <!--
                        ═══════════════════════════════════════════════════════
                        PHASE: Finishing — busy state with retry on error
                        ═══════════════════════════════════════════════════════
                    -->
                    <VerticalStackLayout IsVisible="{Binding IsFinishing}" Spacing="16">
                        <Label
                            Margin="0,40,0,0"
                            HorizontalOptions="Center"
                            Style="{StaticResource M3EmptyStateTitleStyle}"
                            Text="Finishing…" />
                        <ActivityIndicator
                            HorizontalOptions="Center"
                            IsRunning="True"
                            IsVisible="{Binding HasFinishSyncError, Converter={StaticResource InvertedBoolConverter}}"
                            Scale="2"
                            Color="{AppThemeBinding Light={StaticResource Primary},
                                                    Dark={StaticResource PrimaryDark}}" />

                        <Button
                            Command="{Binding RetryFinishCommand}"
                            IsVisible="{Binding HasFinishSyncError}"
                            Style="{StaticResource M3SecondaryButtonStyle}"
                            Text="Retry Sync" />
                    </VerticalStackLayout>


                    <!--
                        ═══════════════════════════════════════════════════════
                        PHASE: Completed — summary card + destructive purge
                        ═══════════════════════════════════════════════════════
                    -->
                    <VerticalStackLayout IsVisible="{Binding IsCompleted}" Spacing="12">

                        <Label
                            HorizontalOptions="Center"
                            Style="{StaticResource M3EmptyStateTitleStyle}"
                            Text="Meeting Complete" />

                        <Border Style="{StaticResource M3CardStyle}">
                            <Label
                                FontSize="15"
                                LineBreakMode="WordWrap"
                                Text="{Binding FinishSummary}"
                                TextColor="{AppThemeBinding Light={StaticResource TextBody},
                                                            Dark={StaticResource TextBodyDim}}" />
                        </Border>

                        <Button
                            Command="{Binding PurgeDatabaseCommand}"
                            Style="{StaticResource DangerButtonStyle}"
                            Text="Purge Database" />
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </ScrollView>
        </controls:PageScaffold.ContentBody>
    </controls:PageScaffold>

</ContentPage>
