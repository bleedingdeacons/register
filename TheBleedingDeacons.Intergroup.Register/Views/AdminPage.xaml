<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="TheBleedingDeacons.Intergroup.Register.Views.AdminPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:TheBleedingDeacons.Intergroup.Register.ViewModels"
             xmlns:entities="clr-namespace:TheBleedingDeacons.Unity.Intergroup.Entities;assembly=TheBleedingDeacons.Unity.Intergroup"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:DataType="vm:AdminViewModel"
             Title="Meeting Admin">

    <ContentPage.Resources>
        <ResourceDictionary>
            <Style x:Key="HeaderLabelStyle" TargetType="Label">
                <Setter Property="FontSize" Value="24"/>
                <Setter Property="FontAttributes" Value="Bold"/>
                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"/>
                <Setter Property="Margin" Value="0,0,0,10"/>
            </Style>

            <Style x:Key="FieldLabelStyle" TargetType="Label">
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontAttributes" Value="Bold"/>
                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}"/>
                <Setter Property="Margin" Value="0,0,0,4"/>
            </Style>

            <Style x:Key="ValueLabelStyle" TargetType="Label">
                <Setter Property="FontSize" Value="22"/>
                <Setter Property="FontAttributes" Value="Bold"/>
                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Gray900}, Dark=White}"/>
            </Style>

            <Style x:Key="BigButtonStyle" TargetType="Button">
                <Setter Property="FontSize" Value="20"/>
                <Setter Property="FontAttributes" Value="Bold"/>
                <Setter Property="TextColor" Value="White"/>
                <Setter Property="CornerRadius" Value="12"/>
                <Setter Property="HeightRequest" Value="70"/>
                <Setter Property="Margin" Value="0,10,0,0"/>
            </Style>

            <toolkit:InvertedBoolConverter x:Key="InvertedBoolConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <ContentPage.Behaviors>
        <toolkit:StatusBarBehavior StatusBarColor="{AppThemeBinding Light=White, Dark=Black}"
                                   StatusBarStyle="{AppThemeBinding Light=DarkContent, Dark=LightContent}" />
    </ContentPage.Behaviors>

    <ScrollView>
        <StackLayout Padding="20,10" Spacing="16">

            <!-- ═══════════════════════════════════════════════════════
                 STATUS BANNER (shown during Syncing/Finishing or errors)
                 ═══════════════════════════════════════════════════════ -->
            <Border IsVisible="{Binding IsStatusVisible}"
                    StrokeShape="RoundRectangle 10"
                    StrokeThickness="2"
                    Padding="15,12">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#E8F5E9, Dark=#1B5E20}"/>
                        <Setter Property="Stroke" Value="{AppThemeBinding Light=#4CAF50, Dark=#66BB6A}"/>
                        <Style.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding IsStatusError}" Value="True">
                                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#FFEBEE, Dark=#4A0000}"/>
                                <Setter Property="Stroke" Value="{AppThemeBinding Light=#F44336, Dark=#EF9A9A}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackLayout Orientation="Horizontal" Spacing="12">
                    <ActivityIndicator IsVisible="{Binding IsBusy}"
                                       IsRunning="{Binding IsBusy}"
                                       VerticalOptions="Center"
                                       Color="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"/>
                    <Label Text="{Binding StatusMessage}"
                           FontSize="15"
                           VerticalOptions="Center"
                           LineBreakMode="WordWrap"/>
                </StackLayout>
            </Border>


            <!-- ═══════════════════════════════════════════════════════
                 PHASE: NotStarted — Show Start Meeting button
                 ═══════════════════════════════════════════════════════ -->
            <StackLayout IsVisible="{Binding IsNotStarted}" Spacing="16">

                <Label Text="📋"
                       FontSize="80"
                       HorizontalOptions="Center"
                       Margin="0,40,0,0"/>

                <Label Text="Ready to Begin"
                       FontSize="28"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"/>

                <Label Text="Tap Start Meeting to sync data from Unity and select today's intergroup meeting."
                       FontSize="16"
                       HorizontalTextAlignment="Center"
                       HorizontalOptions="Center"
                       TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}"
                       Margin="20,0"/>

                <Button Text="Start Meeting"
                        Style="{StaticResource BigButtonStyle}"
                        BackgroundColor="{AppThemeBinding Light=#4CAF50, Dark=#388E3C}"
                        Command="{Binding StartMeetingCommand}"/>
            </StackLayout>


            <!-- ═══════════════════════════════════════════════════════
                 PHASE: Syncing — Loading indicator (handled by status banner)
                 ═══════════════════════════════════════════════════════ -->
            <StackLayout IsVisible="{Binding IsSyncing}" Spacing="16">
                <Label Text="Preparing..."
                       FontSize="22"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"
                       Margin="0,40,0,0"/>
                <ActivityIndicator IsRunning="True"
                                   HorizontalOptions="Center"
                                   Scale="2"
                                   Color="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"/>
            </StackLayout>


            <!-- ═══════════════════════════════════════════════════════
                 PHASE: SelectMeeting — Show meeting list
                 ═══════════════════════════════════════════════════════ -->
            <StackLayout IsVisible="{Binding IsSelectingMeeting}" Spacing="12">

                <Label Text="Select Today's Meeting"
                       Style="{StaticResource HeaderLabelStyle}"/>

                <CollectionView ItemsSource="{Binding Meetings}"
                                SelectionMode="None">
                    <CollectionView.EmptyView>
                        <StackLayout Padding="40" VerticalOptions="Center">
                            <Label Text="📅"
                                   FontSize="64"
                                   HorizontalOptions="Center"
                                   TextColor="{StaticResource Gray300}"/>
                            <Label Text="No Intergroup Meetings Found"
                                   FontSize="20"
                                   FontAttributes="Bold"
                                   HorizontalOptions="Center"
                                   TextColor="{StaticResource Gray500}"
                                   Margin="0,20,0,0"/>
                            <Label Text="No meetings were found in the synced data. Check that intergroup meetings exist in Unity."
                                   FontSize="15"
                                   HorizontalOptions="Center"
                                   TextColor="{StaticResource Gray400}"
                                   HorizontalTextAlignment="Center"
                                   Margin="0,10,0,0"/>
                        </StackLayout>
                    </CollectionView.EmptyView>
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Vertical" ItemSpacing="8"/>
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="entities:IntergroupMeeting">
                            <Border StrokeShape="RoundRectangle 10"
                                    StrokeThickness="2"
                                    Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#555}"
                                    BackgroundColor="{AppThemeBinding Light=White, Dark=#2D2D30}"
                                    Padding="0">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:AdminViewModel}}, Path=SelectMeetingCommand}"
                                        CommandParameter="{Binding .}"/>
                                </Border.GestureRecognizers>

                                <Grid Padding="15,12"
                                      ColumnDefinitions="*,Auto"
                                      RowDefinitions="Auto,Auto">

                                    <Label Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                                           Text="{Binding Title}"
                                           Style="{StaticResource FieldLabelStyle}"
                                           Margin="0,0,0,2"
                                           IsVisible="{Binding Title, Converter={toolkit:IsNotNullConverter}}"/>

                                    <Label Grid.Row="1" Grid.Column="0"
                                           Text="{Binding Date}"
                                           Style="{StaticResource ValueLabelStyle}"/>

                                    <Label Grid.Row="1" Grid.Column="1"
                                           Text="▶"
                                           FontSize="24"
                                           VerticalOptions="Center"
                                           TextColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray500}}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </StackLayout>


            <!-- ═══════════════════════════════════════════════════════
                 PHASE: InProgress — Active meeting banner + Finish button
                 ═══════════════════════════════════════════════════════ -->
            <StackLayout IsVisible="{Binding IsInProgress}" Spacing="16">

                <!-- Active meeting banner -->
                <Border BackgroundColor="{AppThemeBinding Light=#E8F5E9, Dark=#1B5E20}"
                        Stroke="{AppThemeBinding Light=#4CAF50, Dark=#66BB6A}"
                        StrokeShape="RoundRectangle 10"
                        StrokeThickness="2"
                        Padding="15,12">
                    <StackLayout Orientation="Horizontal" Spacing="12">
                        <Label Text="✅"
                               FontSize="28"
                               VerticalOptions="Center"/>
                        <StackLayout VerticalOptions="Center" Spacing="2">
                            <Label Text="Meeting In Progress"
                                   Style="{StaticResource FieldLabelStyle}"
                                   Margin="0"
                                   TextColor="{AppThemeBinding Light=#2E7D32, Dark=#A5D6A7}"/>
                            <Label Text="{Binding ActiveMeetingTitle}"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light=#1B5E20, Dark=#C8E6C9}"
                                   IsVisible="{Binding ActiveMeetingTitle, Converter={toolkit:IsNotNullConverter}}"/>
                            <Label Text="{Binding ActiveMeetingDate}"
                                   Style="{StaticResource ValueLabelStyle}"
                                   TextColor="{AppThemeBinding Light=#1B5E20, Dark=#C8E6C9}"/>
                        </StackLayout>
                    </StackLayout>
                </Border>

                <Label Text="Registrations and member edits are being recorded locally. When you're done, tap Finish Meeting to push everything to Unity."
                       FontSize="15"
                       TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}"
                       HorizontalTextAlignment="Center"
                       Margin="10,10"/>

                <Button Text="Finish Meeting"
                        Style="{StaticResource BigButtonStyle}"
                        BackgroundColor="{AppThemeBinding Light=#FF6F00, Dark=#FFA726}"
                        Command="{Binding FinishMeetingCommand}"/>
            </StackLayout>


            <!-- ═══════════════════════════════════════════════════════
                 PHASE: Finishing — Loading indicator
                 ═══════════════════════════════════════════════════════ -->
            <StackLayout IsVisible="{Binding IsFinishing}" Spacing="16">
                <Label Text="Finishing..."
                       FontSize="22"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"
                       Margin="0,40,0,0"/>
                <ActivityIndicator IsRunning="True"
                                   HorizontalOptions="Center"
                                   Scale="2"
                                   Color="{AppThemeBinding Light=#FF6F00, Dark=#FFA726}"/>
            </StackLayout>


            <!-- ═══════════════════════════════════════════════════════
                 PHASE: Completed — Summary + New Session button
                 ═══════════════════════════════════════════════════════ -->
            <StackLayout IsVisible="{Binding IsCompleted}" Spacing="16">

                <Label Text="🎉"
                       FontSize="80"
                       HorizontalOptions="Center"
                       Margin="0,20,0,0"/>

                <Label Text="Meeting Complete"
                       FontSize="28"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"/>

                <Border BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#2D2D30}"
                        StrokeShape="RoundRectangle 10"
                        StrokeThickness="1"
                        Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#555}"
                        Padding="20">
                    <Label Text="{Binding FinishSummary}"
                           FontSize="15"
                           LineBreakMode="WordWrap"/>
                </Border>

                <Button Text="New Session"
                        Style="{StaticResource BigButtonStyle}"
                        BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                        Command="{Binding NewSessionCommand}"/>
            </StackLayout>

        </StackLayout>
    </ScrollView>

</ContentPage>
