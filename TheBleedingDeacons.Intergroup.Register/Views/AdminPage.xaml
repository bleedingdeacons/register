<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="TheBleedingDeacons.Intergroup.Register.Views.AdminPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:entities="clr-namespace:TheBleedingDeacons.Unity.Intergroup.Entities;assembly=TheBleedingDeacons.Unity.Intergroup"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:vm="clr-namespace:TheBleedingDeacons.Intergroup.Register.ViewModels"
    Title="Administration"
    x:DataType="vm:AdminViewModel">

    <ContentPage.Behaviors>
        <toolkit:StatusBarBehavior StatusBarColor="{AppThemeBinding Light=White, Dark=Black}" StatusBarStyle="{AppThemeBinding Light=DarkContent, Dark=LightContent}" />
    </ContentPage.Behaviors>

    <ScrollView>
        <StackLayout Padding="20,10" Spacing="16">

            <!--
                ═══════════════════════════════════════════════════════
                STATUS BANNER (shown during Syncing/Finishing or errors)
                ═══════════════════════════════════════════════════════
            -->
            <Border
                Padding="15,12"
                IsVisible="{Binding IsStatusVisible}"
                StrokeShape="RoundRectangle 10"
                StrokeThickness="2">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#E8F5E9, Dark=#1B5E20}" />
                        <Setter Property="Stroke" Value="{AppThemeBinding Light=#4CAF50, Dark=#66BB6A}" />
                        <Style.Triggers>
                            <DataTrigger
                                Binding="{Binding IsStatusError}"
                                TargetType="Border"
                                Value="True">
                                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#FFEBEE, Dark=#4A0000}" />
                                <Setter Property="Stroke" Value="{AppThemeBinding Light=#F44336, Dark=#EF9A9A}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackLayout Orientation="Horizontal" Spacing="12">
                    <ActivityIndicator
                        IsRunning="{Binding IsBusy}"
                        IsVisible="{Binding IsBusy}"
                        VerticalOptions="Center"
                        Color="{AppThemeBinding Light={StaticResource Primary},
                                                Dark={StaticResource PrimaryDark}}" />
                    <Label
                        FontSize="15"
                        LineBreakMode="WordWrap"
                        Text="{Binding StatusMessage}"
                        VerticalOptions="Center" />
                </StackLayout>
            </Border>


            <!--
                ═══════════════════════════════════════════════════════
                PHASE: NotStarted — Show Start Meeting button
                ═══════════════════════════════════════════════════════
            -->
            <StackLayout IsVisible="{Binding IsNotStarted}" Spacing="16">

                <Label
                    Margin="0,40,0,0"
                    FontSize="80"
                    HorizontalOptions="Center"
                    Text="📋" />

                <Label
                    FontAttributes="Bold"
                    FontSize="28"
                    HorizontalOptions="Center"
                    Text="Ready to Begin" />

                <Label
                    Margin="20,0"
                    FontSize="16"
                    HorizontalOptions="Center"
                    HorizontalTextAlignment="Center"
                    Text="Tap Start Meeting to sync data from Unity and select today's intergroup meeting."
                    TextColor="{AppThemeBinding Light={StaticResource Gray600},
                                                Dark={StaticResource Gray300}}" />

                <Button
                    BackgroundColor="{AppThemeBinding Light=#4CAF50,
                                                      Dark=#388E3C}"
                    Command="{Binding StartMeetingCommand}"
                    IsVisible="{Binding HasSyncError, Converter={toolkit:InvertedBoolConverter}}"
                    Style="{StaticResource BigButtonStyle}"
                    Text="Start Meeting" />

                <Button
                    BackgroundColor="{AppThemeBinding Light=#FF6F00,
                                                      Dark=#FFA726}"
                    Command="{Binding RetrySyncCommand}"
                    IsVisible="{Binding HasSyncError}"
                    Style="{StaticResource BigButtonStyle}"
                    Text="Retry Sync" />
            </StackLayout>


            <!--
                ═══════════════════════════════════════════════════════
                PHASE: Syncing — Loading indicator (handled by status banner)
                ═══════════════════════════════════════════════════════
            -->
            <StackLayout IsVisible="{Binding IsSyncing}" Spacing="16">
                <Label
                    Margin="0,40,0,0"
                    FontAttributes="Bold"
                    FontSize="22"
                    HorizontalOptions="Center"
                    Text="Preparing..." />
                <ActivityIndicator
                    HorizontalOptions="Center"
                    IsRunning="True"
                    Scale="2"
                    Color="{AppThemeBinding Light={StaticResource Primary},
                                            Dark={StaticResource PrimaryDark}}" />
            </StackLayout>


            <!--
                ═══════════════════════════════════════════════════════
                PHASE: SelectMeeting — Show meeting list
                ═══════════════════════════════════════════════════════
            -->
            <StackLayout IsVisible="{Binding IsSelectingMeeting}" Spacing="12">

                <Label Style="{StaticResource HeaderLabelStyle}" Text="Select Today's Meeting" />

                <CollectionView ItemsSource="{Binding Meetings}" SelectionMode="None">
                    <CollectionView.EmptyView>
                        <StackLayout Padding="40" VerticalOptions="Center">
                            <Label
                                FontSize="64"
                                HorizontalOptions="Center"
                                Text="📅"
                                TextColor="{StaticResource Gray300}" />
                            <Label
                                Margin="0,20,0,0"
                                FontAttributes="Bold"
                                FontSize="20"
                                HorizontalOptions="Center"
                                Text="No Intergroup Meetings Found"
                                TextColor="{StaticResource Gray500}" />
                            <Label
                                Margin="0,10,0,0"
                                FontSize="15"
                                HorizontalOptions="Center"
                                HorizontalTextAlignment="Center"
                                Text="No meetings were found in the synced data. Check that intergroup meetings exist in Unity, then try again."
                                TextColor="{StaticResource Gray400}" />
                            <Button
                                Margin="0,20,0,0"
                                BackgroundColor="{AppThemeBinding Light=#4CAF50,
                                                                  Dark=#388E3C}"
                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:AdminViewModel}}, Path=StartMeetingCommand}"
                                Style="{StaticResource BigButtonStyle}"
                                Text="Start Meeting" />
                        </StackLayout>
                    </CollectionView.EmptyView>
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout ItemSpacing="8" Orientation="Vertical" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="entities:IntergroupMeeting">
                            <Border
                                Padding="0"
                                BackgroundColor="{AppThemeBinding Light=White,
                                                                  Dark=#2D2D30}"
                                Stroke="{AppThemeBinding Light=#E0E0E0,
                                                         Dark=#555}"
                                StrokeShape="RoundRectangle 10"
                                StrokeThickness="2">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:AdminViewModel}}, Path=SelectMeetingCommand}" CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>

                                <Grid
                                    Padding="15,12"
                                    ColumnDefinitions="*,Auto"
                                    RowDefinitions="Auto,Auto">

                                    <Label
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Grid.ColumnSpan="2"
                                        Margin="0,0,0,2"
                                        IsVisible="{Binding Title, Converter={toolkit:IsNotNullConverter}}"
                                        Style="{StaticResource FieldLabelStyle}"
                                        Text="{Binding Title}" />

                                    <Label
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        Style="{StaticResource ValueLabelStyle}"
                                        Text="{Binding Date}" />

                                    <Label
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        FontSize="24"
                                        Text="▶"
                                        TextColor="{AppThemeBinding Light={StaticResource Gray400},
                                                                    Dark={StaticResource Gray500}}"
                                        VerticalOptions="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </StackLayout>


            <!--
                ═══════════════════════════════════════════════════════
                PHASE: InProgress — Active meeting banner + Finish button
                ═══════════════════════════════════════════════════════
            -->
            <StackLayout IsVisible="{Binding IsInProgress}" Spacing="16">

                <!--  Active meeting banner  -->
                <Border
                    Padding="15,12"
                    BackgroundColor="{AppThemeBinding Light=#E8F5E9,
                                                      Dark=#1B5E20}"
                    Stroke="{AppThemeBinding Light=#4CAF50,
                                             Dark=#66BB6A}"
                    StrokeShape="RoundRectangle 10"
                    StrokeThickness="2">
                    <StackLayout Orientation="Horizontal" Spacing="12">
                        <Label
                            FontSize="28"
                            Text="✅"
                            VerticalOptions="Center" />
                        <StackLayout Spacing="2" VerticalOptions="Center">
                            <Label
                                Margin="0"
                                Style="{StaticResource FieldLabelStyle}"
                                Text="Meeting In Progress"
                                TextColor="{AppThemeBinding Light=#2E7D32,
                                                            Dark=#A5D6A7}" />
                            <Label
                                FontAttributes="Bold"
                                FontSize="16"
                                IsVisible="{Binding ActiveMeetingTitle, Converter={toolkit:IsNotNullConverter}}"
                                Text="{Binding ActiveMeetingTitle}"
                                TextColor="{AppThemeBinding Light=#1B5E20,
                                                            Dark=#C8E6C9}" />
                            <Label
                                Style="{StaticResource ValueLabelStyle}"
                                Text="{Binding ActiveMeetingDate}"
                                TextColor="{AppThemeBinding Light=#1B5E20,
                                                            Dark=#C8E6C9}" />
                        </StackLayout>
                    </StackLayout>
                </Border>

                <Label
                    Margin="10,10"
                    FontSize="15"
                    HorizontalTextAlignment="Center"
                    Text="Registrations and member edits are being recorded locally. When you're done, tap Finish Meeting to push everything to Unity."
                    TextColor="{AppThemeBinding Light={StaticResource Gray600},
                                                Dark={StaticResource Gray300}}" />

                <Button
                    BackgroundColor="{AppThemeBinding Light=#FF6F00,
                                                      Dark=#FFA726}"
                    Command="{Binding FinishMeetingCommand}"
                    Style="{StaticResource BigButtonStyle}"
                    Text="Finish Meeting" />
            </StackLayout>


            <!--
                ═══════════════════════════════════════════════════════
                PHASE: Finishing — Loading indicator
                ═══════════════════════════════════════════════════════
            -->
            <StackLayout IsVisible="{Binding IsFinishing}" Spacing="16">
                <Label
                    Margin="0,40,0,0"
                    FontAttributes="Bold"
                    FontSize="22"
                    HorizontalOptions="Center"
                    Text="Finishing..." />
                <ActivityIndicator
                    HorizontalOptions="Center"
                    IsRunning="True"
                    IsVisible="{Binding HasFinishSyncError, Converter={toolkit:InvertedBoolConverter}}"
                    Scale="2"
                    Color="{AppThemeBinding Light=#FF6F00,
                                            Dark=#FFA726}" />

                <Button
                    BackgroundColor="{AppThemeBinding Light=#FF6F00,
                                                      Dark=#FFA726}"
                    Command="{Binding RetryFinishCommand}"
                    IsVisible="{Binding HasFinishSyncError}"
                    Style="{StaticResource BigButtonStyle}"
                    Text="Retry Sync" />
            </StackLayout>


            <!--
                ═══════════════════════════════════════════════════════
                PHASE: Completed — Summary + New Session button
                ═══════════════════════════════════════════════════════
            -->
            <StackLayout IsVisible="{Binding IsCompleted}" Spacing="16">

                <Label
                    Margin="0,20,0,0"
                    FontSize="80"
                    HorizontalOptions="Center"
                    Text="🎉" />

                <Label
                    FontAttributes="Bold"
                    FontSize="28"
                    HorizontalOptions="Center"
                    Text="Meeting Complete" />

                <Border
                    Padding="20"
                    BackgroundColor="{AppThemeBinding Light=#F5F5F5,
                                                      Dark=#2D2D30}"
                    Stroke="{AppThemeBinding Light=#E0E0E0,
                                             Dark=#555}"
                    StrokeShape="RoundRectangle 10"
                    StrokeThickness="1">
                    <Label
                        FontSize="15"
                        LineBreakMode="WordWrap"
                        Text="{Binding FinishSummary}" />
                </Border>

                <Button
                    BackgroundColor="{AppThemeBinding Light=#D32F2F,
                                                      Dark=#C62828}"
                    Command="{Binding PurgeDatabaseCommand}"
                    Style="{StaticResource BigButtonStyle}"
                    Text="Purge Database"
                    TextColor="White" />
            </StackLayout>

        </StackLayout>
    </ScrollView>

</ContentPage>
