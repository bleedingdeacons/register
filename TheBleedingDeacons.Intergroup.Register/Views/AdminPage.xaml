<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="TheBleedingDeacons.Intergroup.Register.Views.AdminPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:TheBleedingDeacons.Intergroup.Register.Controls"
    xmlns:entities="clr-namespace:TheBleedingDeacons.Unity.Intergroup.Entities;assembly=TheBleedingDeacons.Unity.Intergroup"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:vm="clr-namespace:TheBleedingDeacons.Intergroup.Register.ViewModels"
    Title="Administration"
    x:DataType="vm:AdminViewModel">

    <ContentPage.Behaviors>
        <toolkit:StatusBarBehavior StatusBarColor="{AppThemeBinding Light=White, Dark=Black}" StatusBarStyle="{AppThemeBinding Light=DarkContent, Dark=LightContent}" />
    </ContentPage.Behaviors>

    <controls:PageScaffold HasActionBar="{Binding IsSelectingMeeting}">
        <controls:PageScaffold.ContentBody>
            <ScrollView>
                <VerticalStackLayout Spacing="20">

                    <!--
                        ═══════════════════════════════════════════════════════
                        STATUS BANNER (Syncing / Finishing / errors)
                        InfoBannerStyle by default; swaps to DangerBannerStyle
                        when IsStatusError is true.
                        ═══════════════════════════════════════════════════════
                    -->
                    <Border IsVisible="{Binding IsStatusVisible}">
                        <Border.Style>
                            <Style BasedOn="{StaticResource InfoBannerStyle}" TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger
                                        Binding="{Binding IsStatusError}"
                                        TargetType="Border"
                                        Value="True">
                                        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource DangerBanner}, Dark={StaticResource DangerBannerDim}}" />
                                        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DangerDark}}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid
                            ColumnDefinitions="Auto,*,Auto"
                            ColumnSpacing="12"
                            VerticalOptions="Center">
                            <ActivityIndicator
                                Grid.Column="0"
                                IsRunning="{Binding IsBusy}"
                                IsVisible="{Binding IsBusy}"
                                VerticalOptions="Center"
                                Color="{AppThemeBinding Light={StaticResource Primary},
                                                        Dark={StaticResource PrimaryDark}}" />
                            <Label
                                Grid.Column="1"
                                FontSize="14"
                                LineBreakMode="WordWrap"
                                Text="{Binding StatusMessage}"
                                TextColor="{AppThemeBinding Light={StaticResource TextBody},
                                                            Dark={StaticResource TextBodyDim}}"
                                VerticalOptions="Center" />
                            <!--
                                Sync Again — visible only on the meeting-selection screen, so the
                                user can re-pull from Unity without leaving the page. Disabled
                                automatically by SyncAgainCommand.CanExecute when offline or once
                                an intergroup meeting has been committed to.
                            -->
                            <Button
                                Grid.Column="2"
                                Command="{Binding SyncAgainCommand}"
                                IsVisible="{Binding IsSelectingMeeting}"
                                Style="{StaticResource M3TextButtonStyle}"
                                Text="Sync Again"
                                VerticalOptions="Center" />
                        </Grid>
                    </Border>


                    <!--
                        ═══════════════════════════════════════════════════════
                        PHASE: NotStarted — Start / Retry
                        ═══════════════════════════════════════════════════════
                    -->
                    <VerticalStackLayout IsVisible="{Binding IsNotStarted}" Spacing="12">

                        <!--  Offline warning — visible only while disconnected; explains why the buttons below are disabled.  -->
                        <Border IsVisible="{Binding IsOnline, Converter={StaticResource InvertedBoolConverter}}" Style="{StaticResource WarningBannerStyle}">
                            <Grid
                                ColumnDefinitions="Auto,*"
                                ColumnSpacing="12"
                                VerticalOptions="Center">
                                <Label
                                    Grid.Column="0"
                                    FontSize="22"
                                    Text="📡"
                                    VerticalOptions="Center" />
                                <Label
                                    Grid.Column="1"
                                    FontSize="14"
                                    LineBreakMode="WordWrap"
                                    Text="No internet connection. Connect to a network to sync with Unity and start the meeting."
                                    TextColor="{AppThemeBinding Light={StaticResource TextBody},
                                                                Dark={StaticResource TextBodyDim}}"
                                    VerticalOptions="Center" />
                            </Grid>
                        </Border>

                        <Label
                            HorizontalOptions="Center"
                            Style="{StaticResource M3EmptyStateTitleStyle}"
                            Text="Ready to Begin" />

                        <Label
                            Margin="20,0,20,8"
                            Style="{StaticResource M3EmptyStateSubtitleStyle}"
                            Text="Tap Load Unity to sync data from Unity, then pick today's intergroup meeting and tap Start Meeting." />

                        <Button
                            Command="{Binding LoadUnityCommand}"
                            IsVisible="{Binding HasSyncError, Converter={StaticResource InvertedBoolConverter}}"
                            Style="{StaticResource M3PrimaryButtonStyle}"
                            Text="Load Unity" />

                        <Button
                            Command="{Binding RetrySyncCommand}"
                            IsVisible="{Binding HasSyncError}"
                            Style="{StaticResource M3SecondaryButtonStyle}"
                            Text="Retry Sync" />
                    </VerticalStackLayout>


                    <!--
                        ═══════════════════════════════════════════════════════
                        PHASE: Syncing — busy state with detailed progress
                        
                        The progress block has three rows:
                        1. Static "Syncing…" headline so the screen has a
                        stable anchor when ProgressMessage churns rapidly
                        during pagination loops.
                        2. ProgressMessage — the live per-step description
                        coming out of the SyncProgress reports.
                        3. A determinate ProgressBar + "n / N" label OR an
                        indeterminate ActivityIndicator, swapped via
                        IsProgressDeterminate. Determinate stages
                        (paginated fetch, push loops) get the bar;
                        indeterminate stages (DB write, snapshot capture)
                        fall back to the spinner the page used to show.
                        ═══════════════════════════════════════════════════════
                    -->
                    <VerticalStackLayout
                        IsVisible="{Binding IsSyncing}"
                        Spacing="16"
                        VerticalOptions="Center">
                        <Label
                            Margin="0,40,0,0"
                            HorizontalOptions="Center"
                            Style="{StaticResource M3EmptyStateTitleStyle}"
                            Text="{Binding ProgressMessage}" />

                        <!--<Label
                            Margin="20,0"
                            HorizontalOptions="Center"
                            HorizontalTextAlignment="Center"
                            IsVisible="{Binding ProgressMessage, Converter={toolkit:IsStringNotNullOrEmptyConverter}}"
                            LineBreakMode="WordWrap"
                            Style="{StaticResource SecondaryTextStyle}"
                            Text="{Binding ProgressMessage}" />-->

                        <!--  Determinate: thin bar + count.  -->
                        <VerticalStackLayout
                            Margin="40,0"
                            IsVisible="{Binding IsProgressDeterminate}"
                            Spacing="6">
                            <ProgressBar
                                HeightRequest="6"
                                Progress="{Binding ProgressFraction}"
                                ProgressColor="{AppThemeBinding Light={StaticResource Primary},
                                                                Dark={StaticResource PrimaryDark}}" />
                            <Label
                                FontSize="12"
                                HorizontalOptions="Center"
                                Style="{StaticResource SecondaryTextStyle}"
                                Text="{Binding ProgressCountLabel}" />
                        </VerticalStackLayout>

                        <!--  Indeterminate fallback — same spinner the page used to show.  -->
                        <ActivityIndicator
                            HorizontalOptions="Center"
                            IsRunning="{Binding IsProgressDeterminate, Converter={StaticResource InvertedBoolConverter}}"
                            IsVisible="{Binding IsProgressDeterminate, Converter={StaticResource InvertedBoolConverter}}"
                            Scale="2"
                            Color="{AppThemeBinding Light={StaticResource Primary},
                                                    Dark={StaticResource PrimaryDark}}" />
                    </VerticalStackLayout>


                    <!--
                        ═══════════════════════════════════════════════════════
                        PHASE: SelectMeeting — list of today's meetings
                        
                        Each row is single-select via a CheckBox bound to the
                        row-VM's IsSelected. Both the checkbox and the
                        surrounding card are wired to ToggleSelectMeetingCommand
                        so a tap anywhere on the row toggles the selection.
                        The Start Meeting button below the list commits the
                        choice; CanExecute keeps it disabled until something
                        is ticked.
                        ═══════════════════════════════════════════════════════
                    -->
                    <VerticalStackLayout IsVisible="{Binding IsSelectingMeeting}" Spacing="12">

                        <Label Style="{StaticResource HeaderLabelStyle}" Text="Select Today's Meeting" />

                        <CollectionView ItemsSource="{Binding Meetings}" SelectionMode="None">
                            <CollectionView.EmptyView>
                                <VerticalStackLayout Padding="24,40" VerticalOptions="Center">
                                    <Label Style="{StaticResource M3EmptyStateIconStyle}" Text="📅" />
                                    <Label Style="{StaticResource M3EmptyStateTitleStyle}" Text="No Intergroup Meetings Found" />
                                    <Label Style="{StaticResource M3EmptyStateSubtitleStyle}" Text="No meetings were found in the synced data. Check that intergroup meetings exist in Unity, then try again." />
                                    <Button
                                        Margin="0,20,0,0"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:AdminViewModel}}, Path=LoadUnityCommand}"
                                        Style="{StaticResource M3PrimaryButtonStyle}"
                                        Text="Load Unity" />
                                </VerticalStackLayout>
                            </CollectionView.EmptyView>
                            <CollectionView.ItemsLayout>
                                <LinearItemsLayout ItemSpacing="0" Orientation="Vertical" />
                            </CollectionView.ItemsLayout>
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="vm:IntergroupMeetingRow">
                                    <Border Padding="0" Style="{StaticResource M3ListItemCardStyle}">
                                        <Border.GestureRecognizers>
                                            <!--  Tapping the card body toggles selection — same code path as tapping the checkbox.  -->
                                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:AdminViewModel}}, Path=ToggleSelectMeetingCommand}" CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>

                                        <Grid
                                            Padding="16,14"
                                            ColumnDefinitions="Auto,*,Auto"
                                            ColumnSpacing="12"
                                            RowDefinitions="Auto,Auto">

                                            <!--
                                                Single-select checkbox. Two-way bound to
                                                IsSelected; the AdminViewModel listens on
                                                each row's PropertyChanged to enforce the
                                                single-select invariant whenever any
                                                checkbox flips, so we don't need a
                                                CheckedChanged behavior here.
                                            -->
                                            <CheckBox
                                                Grid.Row="0"
                                                Grid.RowSpan="2"
                                                Grid.Column="0"
                                                IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                VerticalOptions="Center"
                                                Color="{AppThemeBinding Light={StaticResource Primary},
                                                                        Dark={StaticResource PrimaryDark}}" />

                                            <Label
                                                Grid.Row="0"
                                                Grid.Column="1"
                                                Grid.ColumnSpan="2"
                                                IsVisible="{Binding Meeting.Title, Converter={toolkit:IsNotNullConverter}}"
                                                Style="{StaticResource FieldLabelStyle}"
                                                Text="{Binding Meeting.Title}" />

                                            <Label
                                                Grid.Row="1"
                                                Grid.Column="1"
                                                Style="{StaticResource ValueLabelStyle}"
                                                Text="{Binding Meeting.Date}" />

                                            <Label
                                                Grid.Row="1"
                                                Grid.Column="2"
                                                FontSize="20"
                                                Text="›"
                                                TextColor="{AppThemeBinding Light={StaticResource Gray400},
                                                                            Dark={StaticResource Gray500}}"
                                                VerticalOptions="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>


                    <!--
                        ═══════════════════════════════════════════════════════
                        PHASE: InProgress — active meeting banner + Finish
                        ═══════════════════════════════════════════════════════
                    -->
                    <VerticalStackLayout IsVisible="{Binding IsInProgress}" Spacing="16">

                        <!--  Active meeting banner — uses info palette tokens  -->
                        <Border Style="{StaticResource InfoBannerStyle}">
                            <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                                <Label
                                    Margin="0"
                                    Style="{StaticResource FieldLabelStyle}"
                                    Text="Meeting In Progress"
                                    TextColor="{AppThemeBinding Light={StaticResource TextBody},
                                                                Dark={StaticResource TextBodyDim}}" />
                                <Label
                                    FontAttributes="Bold"
                                    FontSize="16"
                                    IsVisible="{Binding ActiveMeetingTitle, Converter={toolkit:IsNotNullConverter}}"
                                    Text="{Binding ActiveMeetingTitle}"
                                    TextColor="{AppThemeBinding Light={StaticResource TextBody},
                                                                Dark={StaticResource TextBodyDim}}" />
                                <Label
                                    Style="{StaticResource ValueLabelStyle}"
                                    Text="{Binding ActiveMeetingDate}"
                                    TextColor="{AppThemeBinding Light={StaticResource TextBody},
                                                                Dark={StaticResource TextBodyDim}}" />
                            </VerticalStackLayout>
                        </Border>

                        <Label
                            Margin="4,4"
                            HorizontalTextAlignment="Center"
                            Style="{StaticResource SecondaryTextStyle}"
                            Text="Registrations and member edits are being recorded locally. When you're done, tap Finish Meeting to push everything to Unity." />

                        <Button
                            Command="{Binding FinishMeetingCommand}"
                            Style="{StaticResource M3PrimaryButtonStyle}"
                            Text="Finish Meeting" />
                    </VerticalStackLayout>


                    <!--
                        ═══════════════════════════════════════════════════════
                        PHASE: Finishing — busy state with retry on error
                        
                        Mirrors the Syncing block's progress UI: a headline,
                        the live ProgressMessage, then either a determinate
                        bar with count or the indeterminate spinner. The
                        whole progress group is hidden when an error has
                        been raised so the retry button isn't competing
                        with a half-filled bar.
                        ═══════════════════════════════════════════════════════
                    -->
                    <VerticalStackLayout IsVisible="{Binding IsFinishing}" Spacing="16">
                        <Label
                            Margin="0,40,0,0"
                            HorizontalOptions="Center"
                            Style="{StaticResource M3EmptyStateTitleStyle}"
                            Text="Finishing…" />

                        <VerticalStackLayout IsVisible="{Binding HasFinishSyncError, Converter={StaticResource InvertedBoolConverter}}" Spacing="16">
                            <Label
                                Margin="20,0"
                                HorizontalOptions="Center"
                                HorizontalTextAlignment="Center"
                                IsVisible="{Binding ProgressMessage, Converter={toolkit:IsStringNotNullOrEmptyConverter}}"
                                LineBreakMode="WordWrap"
                                Style="{StaticResource SecondaryTextStyle}"
                                Text="{Binding ProgressMessage}" />

                            <VerticalStackLayout
                                Margin="40,0"
                                IsVisible="{Binding IsProgressDeterminate}"
                                Spacing="6">
                                <ProgressBar
                                    HeightRequest="6"
                                    Progress="{Binding ProgressFraction}"
                                    ProgressColor="{AppThemeBinding Light={StaticResource Primary},
                                                                    Dark={StaticResource PrimaryDark}}" />
                                <Label
                                    FontSize="12"
                                    HorizontalOptions="Center"
                                    Style="{StaticResource SecondaryTextStyle}"
                                    Text="{Binding ProgressCountLabel}" />
                            </VerticalStackLayout>

                            <ActivityIndicator
                                HorizontalOptions="Center"
                                IsRunning="{Binding IsProgressDeterminate, Converter={StaticResource InvertedBoolConverter}}"
                                IsVisible="{Binding IsProgressDeterminate, Converter={StaticResource InvertedBoolConverter}}"
                                Scale="2"
                                Color="{AppThemeBinding Light={StaticResource Primary},
                                                        Dark={StaticResource PrimaryDark}}" />
                        </VerticalStackLayout>

                        <Button
                            Command="{Binding RetryFinishCommand}"
                            IsVisible="{Binding HasFinishSyncError}"
                            Style="{StaticResource M3SecondaryButtonStyle}"
                            Text="Retry Sync" />
                    </VerticalStackLayout>


                    <!--
                        ═══════════════════════════════════════════════════════
                        PHASE: Completed — summary card + destructive purge
                        ═══════════════════════════════════════════════════════
                    -->
                    <VerticalStackLayout IsVisible="{Binding IsCompleted}" Spacing="12">

                        <Label
                            HorizontalOptions="Center"
                            Style="{StaticResource M3EmptyStateTitleStyle}"
                            Text="Meeting Complete" />

                        <Border Style="{StaticResource M3CardStyle}">
                            <Label
                                FontSize="15"
                                LineBreakMode="WordWrap"
                                Text="{Binding FinishSummary}"
                                TextColor="{AppThemeBinding Light={StaticResource TextBody},
                                                            Dark={StaticResource TextBodyDim}}" />
                        </Border>

                        <Button
                            Command="{Binding PurgeDatabaseCommand}"
                            Style="{StaticResource DangerButtonStyle}"
                            Text="Purge Database" />
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </ScrollView>
        </controls:PageScaffold.ContentBody>

        <!--
            ═══════════════════════════════════════════════════════════
            Fixed-position action bar — Start Meeting button.
            
            Lives outside the body's ScrollView/CollectionView entirely.
            Earlier attempts placed this button after the meetings
            CollectionView in the scrollable body, but a CollectionView
            inside a ScrollView has unreliable height behaviour in MAUI:
            the Button below it could be pushed off-screen, given zero
            measured height, or fail to lay out at all on some
            platforms. PageScaffold's ActionBar slot is rendered in a
            separate Grid row at the bottom of the page, sized
            independently, and is the project's established pattern for
            page-level actions (see EditGroupPage, VerifyGroupPage).
            
            HasActionBar is bound to IsSelectingMeeting on the scaffold
            element so this bar is only present during meeting
            selection — the other phases continue to use their own
            in-body buttons (Finish Meeting, Purge Database, etc.).
            
            StartMeetingCommand.CanExecute keeps the button disabled
            until SelectedMeetingRow is non-null, so it's safe to
            render unconditionally during the SelectMeeting phase.
            ═══════════════════════════════════════════════════════════
        -->
        <controls:PageScaffold.ActionBarBody>
            <Button
                Command="{Binding StartMeetingCommand}"
                Style="{StaticResource M3PrimaryButtonStyle}"
                Text="Start Meeting" />
        </controls:PageScaffold.ActionBarBody>

    </controls:PageScaffold>

</ContentPage>
