<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="TheBleedingDeacons.Intergroup.Register.Views.ImportExportPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:TheBleedingDeacons.Intergroup.Register.ViewModels"
             x:DataType="vm:ImportExportViewModel"
             Title="{Binding Title}">

    <ScrollView>
        <Grid ColumnSpacing="15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Style="{StaticResource PrimaryButtonStyle}"
                Text="Import from Excel" 
                ImageSource="dataimport.png"
                Command="{Binding ImportExcelCommand}"
                IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
                HeightRequest="120"
                CornerRadius="10" />

            <Button Grid.Column="1" Style="{StaticResource PrimaryButtonStyle}"
                Text="Export to Excel"
                ImageSource="dataexport.png"
                Command="{Binding ExportExcelCommand}"
                IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
                HeightRequest="120"
                CornerRadius="10" />
        </Grid>
    </ScrollView>

</ContentPage>