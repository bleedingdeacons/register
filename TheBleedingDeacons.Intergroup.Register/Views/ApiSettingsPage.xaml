<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="TheBleedingDeacons.Intergroup.Register.Views.ApiSettingsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:tc="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:vm="clr-namespace:TheBleedingDeacons.Intergroup.Register.ViewModels"
    Title="API Settings"
    x:DataType="vm:ApiSettingsViewModel">

    <ContentPage.Resources>
        <tc:BoolToObjectConverter
            x:Key="BoolToColorConverter"
            FalseObject="Green"
            TrueObject="Red" />
        <tc:BoolToObjectConverter
            x:Key="BoolToTestButtonTextConverter"
            FalseObject="Test Connection"
            TrueObject="Testing Connection..." />
        <tc:InvertedBoolConverter x:Key="InvertedBoolConverter" />
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">

            <Label
                FontAttributes="Bold"
                FontSize="24"
                Text="API Settings" />

            <!--
                ═══════════════════════════════════════════════════════
                Freedom: where every credential and endpoint comes from.
                Hidden when the build names no Freedom site.
                ═══════════════════════════════════════════════════════
            -->
            <Frame
                BackgroundColor="{AppThemeBinding Light=White, Dark=#2D2D30}"
                BorderColor="{AppThemeBinding Light=LightGray, Dark=Gray}"
                IsVisible="{Binding IsFreedomAvailable}">
                <VerticalStackLayout Spacing="10">
                    <Label
                        FontAttributes="Bold"
                        FontSize="18"
                        Text="Freedom" />
                    <Label FontSize="13" Text="Sign this tablet in with a Google account the intergroup has set up (a tablet account or your own). Its mail, Unity and logging settings come from the site and nowhere else." />
                    <Label Text="{Binding FreedomStatus}" />
                    <HorizontalStackLayout Spacing="10">
                        <Button
                            Command="{Binding SignInToFreedomCommand}"
                            IsEnabled="{Binding IsFreedomIdle}"
                            Text="Sign in" />
                        <Button
                            Command="{Binding SyncFreedomCommand}"
                            IsEnabled="{Binding IsFreedomIdle}"
                            Text="Check now" />
                        <Button
                            Command="{Binding SignOutOfFreedomCommand}"
                            IsEnabled="{Binding IsFreedomIdle}"
                            Text="Sign out" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Frame>

            <Frame
                Padding="15"
                BackgroundColor="{AppThemeBinding Light=#FFF3E0, Dark=#4E342E}"
                BorderColor="{AppThemeBinding Light=#FB8C00, Dark=#FFB74D}"
                IsVisible="{Binding IsFreedomAvailable, Converter={StaticResource InvertedBoolConverter}}">
                <Label Text="This build names no Freedom site, so the tablet has no Unity or logging settings. Settings come only from Freedom: the build's appsettings.json needs a Freedom section." />
            </Frame>

            <!--
                ═══════════════════════════════════════════════════════
                Unity API
                ═══════════════════════════════════════════════════════
            -->
            <Label
                Margin="0,10,0,0"
                FontAttributes="Bold"
                FontSize="20"
                Text="Unity API" />

            <Frame
                Padding="15"
                BackgroundColor="{Binding IsUnityStatusError, Converter={StaticResource BoolToColorConverter}}"
                BorderColor="Transparent"
                IsVisible="{Binding IsUnityStatusVisible}">
                <Label
                    FontAttributes="Bold"
                    Text="{Binding UnityStatusMessage}"
                    TextColor="White" />
            </Frame>

            <Frame BackgroundColor="{AppThemeBinding Light=White, Dark=#2D2D30}" BorderColor="{AppThemeBinding Light=LightGray, Dark=Gray}">
                <Grid
                    ColumnDefinitions="Auto,*"
                    ColumnSpacing="20"
                    RowDefinitions="Auto,Auto"
                    RowSpacing="12">
                    <Label Grid.Row="0" FontAttributes="Bold" Text="Site" />
                    <Label Grid.Row="0" Grid.Column="1" Text="{Binding UnityBaseUrl}" />
                    <Label Grid.Row="1" FontAttributes="Bold" Text="API key" />
                    <Label Grid.Row="1" Grid.Column="1" Text="{Binding UnityApiKey}" />
                </Grid>
            </Frame>

            <Button
                BackgroundColor="{AppThemeBinding Light=#4CAF50,
                                                  Dark=#22C55E}"
                Command="{Binding TestUnityConnectionCommand}"
                Text="{Binding IsUnityTesting, Converter={StaticResource BoolToTestButtonTextConverter}}"
                TextColor="White">
                <Button.Triggers>
                    <DataTrigger
                        Binding="{Binding IsUnityTesting}"
                        TargetType="Button"
                        Value="True">
                        <Setter Property="BackgroundColor" Value="Gray" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>

            <BoxView
                Margin="0,15,0,5"
                HeightRequest="1"
                Color="{AppThemeBinding Light=#E0E0E0,
                                        Dark=#424242}" />

            <!--
                ═══════════════════════════════════════════════════════
                Better Stack
                ═══════════════════════════════════════════════════════
            -->
            <Label
                FontAttributes="Bold"
                FontSize="20"
                Text="Better Stack" />

            <Frame
                Padding="15"
                BackgroundColor="{Binding IsBetterStackStatusError, Converter={StaticResource BoolToColorConverter}}"
                BorderColor="Transparent"
                IsVisible="{Binding IsBetterStackStatusVisible}">
                <Label
                    FontAttributes="Bold"
                    Text="{Binding BetterStackStatusMessage}"
                    TextColor="White" />
            </Frame>

            <Frame BackgroundColor="{AppThemeBinding Light=White, Dark=#2D2D30}" BorderColor="{AppThemeBinding Light=LightGray, Dark=Gray}">
                <Grid
                    ColumnDefinitions="Auto,*"
                    ColumnSpacing="20"
                    RowDefinitions="Auto,Auto"
                    RowSpacing="12">
                    <Label Grid.Row="0" FontAttributes="Bold" Text="Endpoint" />
                    <Label Grid.Row="0" Grid.Column="1" Text="{Binding BetterStackEndpoint}" />
                    <Label Grid.Row="1" FontAttributes="Bold" Text="Source token" />
                    <Label Grid.Row="1" Grid.Column="1" Text="{Binding BetterStackSourceToken}" />
                </Grid>
            </Frame>

            <Button
                BackgroundColor="{AppThemeBinding Light=#4CAF50,
                                                  Dark=#22C55E}"
                Command="{Binding TestBetterStackConnectionCommand}"
                Text="{Binding IsBetterStackTesting, Converter={StaticResource BoolToTestButtonTextConverter}}"
                TextColor="White">
                <Button.Triggers>
                    <DataTrigger
                        Binding="{Binding IsBetterStackTesting}"
                        TargetType="Button"
                        Value="True">
                        <Setter Property="BackgroundColor" Value="Gray" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
