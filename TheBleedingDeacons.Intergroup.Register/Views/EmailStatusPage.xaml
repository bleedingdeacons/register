<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="TheBleedingDeacons.Intergroup.Register.Views.EmailStatusPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:TheBleedingDeacons.Intergroup.Register.ViewModels"
             xmlns:models="clr-namespace:TheBleedingDeacons.Intergroup.Register.Models"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:DataType="vm:EmailStatusViewModel"
             Title="Email Queue Status">

    <ContentPage.Resources>
        <ResourceDictionary>
            <!-- For online status colors -->
            <toolkit:BoolToObjectConverter x:Key="OnlineStatusToColorConverter" 
                                           TrueObject="Green" 
                                           FalseObject="Red" />

            <!--
                Action label for the offline-toggle button. The button
                advertises what tapping it will DO, not the current state
                — so when we're online, the label reads "Go Offline", and
                vice versa. Mirrors the existing color-converter pattern.
            -->
            <toolkit:BoolToObjectConverter x:Key="OnlineToToggleLabelConverter"
                                           TrueObject="Go Offline"
                                           FalseObject="Go Online" />

            <!--
                Action label for the online status text. Reads the current
                state plainly ("Online" / "Offline") rather than the bool's
                string form. The original markup bound StringFormat='{0}'
                directly which printed "True" / "False".
            -->
            <toolkit:BoolToObjectConverter x:Key="OnlineToStatusLabelConverter"
                                           TrueObject="Online"
                                           FalseObject="Offline" />

            <!-- Data templates -->
            <DataTemplate x:Key="EmailItemTemplate" x:DataType="vm:EmailDisplayModel">
                <SwipeView>
                    <!-- Swipe actions -->
                    <SwipeView.RightItems>
                        <SwipeItems>
                            <SwipeItem Text="Retry" 
                                       BackgroundColor="Orange"
                                       IsVisible="{Binding CanRetry}"
                                       Command="{Binding Source={RelativeSource AncestorType={x:Type vm:EmailStatusViewModel}}, Path=RetryEmailCommand}"
                                       CommandParameter="{Binding .}" />
                            <SwipeItem Text="Delete" 
                                       BackgroundColor="Red"
                                       Command="{Binding Source={RelativeSource AncestorType={x:Type vm:EmailStatusViewModel}}, Path=DeleteEmailCommand}"
                                       CommandParameter="{Binding .}" />
                        </SwipeItems>
                    </SwipeView.RightItems>

                    <Border Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#404040}"
                            StrokeThickness="1"
                            BackgroundColor="{AppThemeBinding Light=White, Dark=#2D2D30}"
                            Padding="12"
                            Margin="8,4">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8" />
                        </Border.StrokeShape>

                        <Grid RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="*,Auto">
                            <!-- Header row -->
                            <StackLayout Grid.Row="0" Grid.Column="0" Orientation="Horizontal">
                                <Label Text="{Binding To}" 
                                       FontAttributes="Bold" 
                                       FontSize="16"
                                       TextColor="{AppThemeBinding Light=Black, Dark=White}" />
                                <Label Text="{Binding StatusText}" 
                                       FontSize="12"
                                       FontAttributes="Bold"
                                       TextColor="{Binding StatusColor}"
                                       Margin="8,0,0,0" />
                            </StackLayout>

                            <Label Grid.Row="0" Grid.Column="1"
                                   Text="{Binding AttemptText}"
                                   FontSize="12"
                                   TextColor="{AppThemeBinding Light=#666666, Dark=#CCCCCC}"
                                   VerticalOptions="Center" />

                            <!-- Subject -->
                            <Label Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                   Text="{Binding ShortSubject}"
                                   FontSize="14"
                                   TextColor="{AppThemeBinding Light=#333333, Dark=#DDDDDD}"
                                   Margin="0,4,0,0" />

                            <!-- Timestamps -->
                            <StackLayout Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" 
                                         Orientation="Horizontal" 
                                         Margin="0,4,0,0">
                                <Label Text="Created:" 
                                       FontSize="12" 
                                       TextColor="{AppThemeBinding Light=#666666, Dark=#CCCCCC}" />
                                <Label Text="{Binding CreatedAtText}" 
                                       FontSize="12" 
                                       TextColor="{AppThemeBinding Light=#666666, Dark=#CCCCCC}" 
                                       Margin="4,0,12,0" />
                                <Label Text="Last Attempt:" 
                                       FontSize="12" 
                                       TextColor="{AppThemeBinding Light=#666666, Dark=#CCCCCC}" />
                                <Label Text="{Binding LastAttemptText}" 
                                       FontSize="12" 
                                       TextColor="{AppThemeBinding Light=#666666, Dark=#CCCCCC}" 
                                       Margin="4,0,0,0" />
                            </StackLayout>

                            <!-- Error message -->
                            <Label Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"
                                   Text="{Binding LastError}"
                                   FontSize="12"
                                   TextColor="Red"
                                   IsVisible="{Binding HasError}"
                                   Margin="0,4,0,0" />
                        </Grid>
                    </Border>
                </SwipeView>
            </DataTemplate>
        </ResourceDictionary>
    </ContentPage.Resources>

    <!--
        Two-column layout. The left column holds all status / list /
        empty-state UI; the right column is a docked action sidebar so
        the FAB-style overlay no longer sits on top of the email list
        and the buttons can carry plain-English labels rather than
        emoji-only tooltips.
    -->
    <Grid ColumnDefinitions="*,220" RowDefinitions="Auto,Auto,*">
        <!-- Status Bar -->
        <Border Grid.Row="0"
                Grid.Column="0"
                BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#1E1E1E}"
                Padding="16,12">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="0" />
            </Border.StrokeShape>
            <!-- Bottom border effect -->
            <Border.Shadow>
                <Shadow Brush="{AppThemeBinding Light=#E0E0E0, Dark=#404040}" 
                        Offset="0,1" 
                        Radius="0" 
                        Opacity="1" />
            </Border.Shadow>

            <Grid ColumnDefinitions="Auto,*,Auto">
                <!-- Online/Offline Status -->
                <StackLayout Grid.Column="0" Orientation="Horizontal">
                    <Ellipse WidthRequest="12" 
                             HeightRequest="12" 
                             Fill="{Binding IsOnline, Converter={StaticResource OnlineStatusToColorConverter}}" 
                             VerticalOptions="Center" />
                    <Label Text="{Binding IsOnline, Converter={StaticResource OnlineToStatusLabelConverter}}" 
                           FontAttributes="Bold"
                           FontSize="14"
                           TextColor="{Binding IsOnline, Converter={StaticResource OnlineStatusToColorConverter}}"
                           Margin="8,0,0,0"
                           VerticalOptions="Center" />
                </StackLayout>

                <!-- Status Message -->
                <Label Grid.Column="1"
                       Text="{Binding StatusMessage}"
                       FontSize="12"
                       TextColor="{AppThemeBinding Light=#666666, Dark=#CCCCCC}"
                       HorizontalOptions="Center"
                       VerticalOptions="Center" />

                <!-- Refresh Button -->
                <Button Grid.Column="2"
                        Text="↻"
                        FontSize="16"
                        WidthRequest="40"
                        HeightRequest="40"
                        BackgroundColor="Transparent"
                        TextColor="{AppThemeBinding Light=#007ACC, Dark=#4FC3F7}"
                        Command="{Binding RefreshEmailsCommand}"
                        ToolTipProperties.Text="Refresh"
                        IsEnabled="{Binding IsLoading, Converter={StaticResource InvertedBoolConverter}}" />
            </Grid>
        </Border>

        <!-- Statistics Bar -->
        <Border Grid.Row="1"
                Grid.Column="0"
                BackgroundColor="{AppThemeBinding Light=White, Dark=#2D2D30}"
                Padding="16,8">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="0" />
            </Border.StrokeShape>
            <!-- Bottom border effect -->
            <Border.Shadow>
                <Shadow Brush="{AppThemeBinding Light=#E0E0E0, Dark=#404040}" 
                        Offset="0,1" 
                        Radius="0" 
                        Opacity="1" />
            </Border.Shadow>

            <Grid ColumnDefinitions="*,*,*,*">
                <StackLayout Grid.Column="0" HorizontalOptions="Center">
                    <Label Text="{Binding TotalEmails}" 
                           FontAttributes="Bold" 
                           FontSize="18" 
                           HorizontalOptions="Center"
                           TextColor="{AppThemeBinding Light=Black, Dark=White}" />
                    <Label Text="Total" 
                           FontSize="12" 
                           HorizontalOptions="Center"
                           TextColor="{AppThemeBinding Light=#666666, Dark=#CCCCCC}" />
                </StackLayout>

                <StackLayout Grid.Column="1" HorizontalOptions="Center">
                    <Label Text="{Binding PendingEmails}" 
                           FontAttributes="Bold" 
                           FontSize="18" 
                           HorizontalOptions="Center"
                           TextColor="Orange" />
                    <Label Text="Pending" 
                           FontSize="12" 
                           HorizontalOptions="Center"
                           TextColor="{AppThemeBinding Light=#666666, Dark=#CCCCCC}" />
                </StackLayout>

                <StackLayout Grid.Column="2" HorizontalOptions="Center">
                    <Label Text="{Binding SentEmails}" 
                           FontAttributes="Bold" 
                           FontSize="18" 
                           HorizontalOptions="Center"
                           TextColor="Green" />
                    <Label Text="Sent" 
                           FontSize="12" 
                           HorizontalOptions="Center"
                           TextColor="{AppThemeBinding Light=#666666, Dark=#CCCCCC}" />
                </StackLayout>

                <StackLayout Grid.Column="3" HorizontalOptions="Center">
                    <Label Text="{Binding FailedEmails}" 
                           FontAttributes="Bold" 
                           FontSize="18" 
                           HorizontalOptions="Center"
                           TextColor="Red" />
                    <Label Text="Failed" 
                           FontSize="12" 
                           HorizontalOptions="Center"
                           TextColor="{AppThemeBinding Light=#666666, Dark=#CCCCCC}" />
                </StackLayout>
            </Grid>
        </Border>

        <!-- Email List -->
        <RefreshView Grid.Row="2"
                     Grid.Column="0"
                     IsRefreshing="{Binding IsRefreshing}"
                     Command="{Binding RefreshEmailsCommand}">

            <CollectionView ItemsSource="{Binding Emails}"
                            ItemTemplate="{StaticResource EmailItemTemplate}"
                            BackgroundColor="{AppThemeBinding Light=#F8F8F8, Dark=#1E1E1E}"
                            SelectionMode="Single"
                            SelectedItem="{Binding SelectedEmail}">

                <CollectionView.EmptyView>
                    <StackLayout HorizontalOptions="Center" 
                                 VerticalOptions="Center"
                                 Padding="20">
                        <Label Text="📧" 
                               FontSize="48" 
                               HorizontalOptions="Center" 
                               TextColor="{AppThemeBinding Light=#CCCCCC, Dark=#666666}" />
                        <Label Text="No emails in queue" 
                               FontSize="16" 
                               HorizontalOptions="Center"
                               TextColor="{AppThemeBinding Light=#666666, Dark=#CCCCCC}" />
                        <Button Text="Refresh" 
                                Command="{Binding LoadEmailsCommand}"
                                HorizontalOptions="Center"
                                Margin="0,16,0,0" />
                    </StackLayout>
                </CollectionView.EmptyView>
            </CollectionView>
        </RefreshView>

        <!--
            Action sidebar. Spans all three rows of the left column so the
            buttons stay reachable regardless of where the email list is
            scrolled. Each button carries an explicit verb so the function
            is clear without relying on tooltip hover (which doesn't fire
            on touch). Clear Sent uses the secondary style as a soft
            destructive cue, and is gated by a confirmation in the VM.
        -->
        <Border Grid.Row="0"
                Grid.RowSpan="3"
                Grid.Column="1"
                BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#1E1E1E}"
                Padding="12,16">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="0" />
            </Border.StrokeShape>
            <Border.Shadow>
                <Shadow Brush="{AppThemeBinding Light=#E0E0E0, Dark=#404040}"
                        Offset="-1,0"
                        Radius="0"
                        Opacity="1" />
            </Border.Shadow>

            <ScrollView>
                <VerticalStackLayout Spacing="10">
                    <Label Text="Actions"
                           FontAttributes="Bold"
                           FontSize="14"
                           TextColor="{AppThemeBinding Light=#666666, Dark=#CCCCCC}"
                           Margin="4,0,0,4" />

                    <!--  Send everything in the queue right now.  -->
                    <Button Text="Send Now"
                            Style="{StaticResource M3PrimaryButtonStyle}"
                            Command="{Binding ProcessQueueCommand}" />

                    <!--  Reset attempt counters on every email and re-process.  -->
                    <Button Text="Retry All"
                            Style="{StaticResource M3PrimaryButtonStyle}"
                            Command="{Binding RetryAllEmailsCommand}" />

                    <!--  Reset attempt counters on Failed-status emails only.  -->
                    <Button Text="Retry Failed"
                            Style="{StaticResource M3PrimaryButtonStyle}"
                            Command="{Binding RetryFailedEmailsCommand}" />

                    <!--
                        Destructive: removes successfully-sent emails from the
                        local queue. Secondary style softens the visual weight,
                        and the VM gates the action with a confirmation dialog.
                    -->
                    <Button Text="Clear Sent"
                            Style="{StaticResource M3SecondaryButtonStyle}"
                            Command="{Binding ClearSentEmailsCommand}" />

                    <!--  Spacer divider before the mode toggle.  -->
                    <BoxView HeightRequest="1"
                             Color="{AppThemeBinding Light=#E0E0E0, Dark=#404040}"
                             Margin="0,8" />

                    <!--
                        Toggle reads as the action it will perform — when we
                        are online the label says "Go Offline", and vice versa
                        — instead of stringifying the IsOnline bool.
                    -->
                    <Button Text="{Binding IsOnline, Converter={StaticResource OnlineToToggleLabelConverter}}"
                            Style="{StaticResource M3SecondaryButtonStyle}"
                            Command="{Binding ToggleOfflineModeCommand}" />
                </VerticalStackLayout>
            </ScrollView>
        </Border>

        <!-- Loading Overlay -->
        <Border Grid.Row="0" Grid.RowSpan="3"
                Grid.Column="0" Grid.ColumnSpan="2"
                BackgroundColor="#80000000"
                IsVisible="{Binding IsLoading}">
            <ActivityIndicator IsRunning="{Binding IsLoading}"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"
                               Color="{AppThemeBinding Light=#007ACC, Dark=#4FC3F7}" />
        </Border>
    </Grid>

</ContentPage>