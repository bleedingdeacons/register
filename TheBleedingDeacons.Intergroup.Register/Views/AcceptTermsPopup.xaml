<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup
    x:Class="TheBleedingDeacons.Intergroup.Register.Views.AcceptTermsPopup"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:vm="clr-namespace:TheBleedingDeacons.Intergroup.Register.ViewModels"
    x:DataType="vm:AcceptTermsPopupViewModel"
    BackgroundColor="Transparent"
    CanBeDismissedByTappingOutsideOfPopup="False">

    <Border
        Margin="50"
        x:DataType="vm:AcceptTermsPopupViewModel"
        HeightRequest="560"
        Style="{StaticResource M3CardStyle}"
        WidthRequest="896">

        <Grid
            Padding="24"
            RowDefinitions="Auto,*,Auto,Auto"
            RowSpacing="24">

            <!--  Title  -->
            <Label
                Grid.Row="0"
                FontAttributes="Bold"
                FontSize="32"
                HorizontalOptions="Center"
                HorizontalTextAlignment="Center"
                LineBreakMode="WordWrap"
                Text="{Binding Title}"
                TextColor="{AppThemeBinding Light={StaticResource Gray900},
                                            Dark={StaticResource Gray100}}" />

            <!--
                Body area: scrollable policy text plus an overlay
                "jump to end" affordance for long policies. The button
                sits in the bottom-right of the scroll region (it shares
                the cell, not the ScrollView itself, so it doesn't move
                with the content). It hides itself once the user has
                already reached the end — no point offering a shortcut
                that's no longer useful — by binding IsVisible to the
                inverse of HasScrolledToEnd via the existing
                InvertedBoolConverter.
                
                Scrollbar is pinned Always-on so the user has a constant
                visual cue that more policy text exists below the fold —
                otherwise on platforms with auto-hiding scrollbars they
                may not realise scrolling is required before the
                I-Agree button can enable.
            -->
            <Grid Grid.Row="1">
                <!--
                    The ScrollView sits inside a Border so the policy
                    region has a visible frame distinct from the rest of
                    the dialog body. Padding lives on the Border (not the
                    ScrollView) so the stroke wraps the scrollbar too;
                    inner Label margin keeps the text off the stroke
                    while the scrollbar still rides flush against the
                    right edge as users expect. StrokeShape's corner
                    radius matches the M3 card aesthetic of the outer
                    dialog without copying its full elevation.
                -->
                <Border
                    Padding="12"
                    Stroke="{AppThemeBinding Light={StaticResource Gray300},
                                             Dark={StaticResource Gray600}}"
                    StrokeThickness="1">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="8" />
                    </Border.StrokeShape>
                    <ScrollView x:Name="PolicyScrollView" VerticalScrollBarVisibility="Always">
                        <Label
                            FontSize="18"
                            HorizontalOptions="Fill"
                            HorizontalTextAlignment="Start"
                            LineBreakMode="WordWrap"
                            Text="{Binding Message}"
                            TextColor="{AppThemeBinding Light={StaticResource Gray900},
                                                        Dark={StaticResource Gray100}}" />
                    </ScrollView>
                </Border>

                <!--
                    Nudged up and down by the code-behind while the policy
                    still needs scrolling — see StartScrollHint. The consent
                    row below is disabled until the user reaches the bottom,
                    and a static arrow was not saying so loudly enough.
                    TranslationY is the animated property, so nothing here
                    may set it.
                -->
                <Button
                    x:Name="JumpToEndButton"
                    Margin="0,0,0,00"
                    Padding="0"
                    BackgroundColor="{AppThemeBinding Light={StaticResource Primary},
                                                      Dark={StaticResource PrimaryDark}}"
                    Clicked="OnJumpToEndClicked"
                    CornerRadius="22"
                    FontAttributes="Bold"
                    FontSize="20"
                    HeightRequest="44"
                    HorizontalOptions="Center"
                    IsVisible="{Binding HasScrolledToEnd, Converter={StaticResource InvertedBoolConverter}}"
                    Shadow="{StaticResource M3Elevation2}"
                    Text="↓"
                    TextColor="White"
                    ToolTipProperties.Text="Jump to end"
                    VerticalOptions="End"
                    WidthRequest="44" />
            </Grid>

            <!--
                Consent checkbox. Two-way bound to HasAgreed; combined with
                HasScrolledToEnd in the view model, this gates AcceptCommand.
                The CheckBox itself handles taps natively. The surrounding
                Grid carries a TapGestureRecognizer so taps on the label
                (or the spacing between glyph and label) also toggle the
                state — children consume their own input first, so the
                native CheckBox click behaviour is preserved.
                
                The whole row is disabled until HasScrolledToEnd flips
                true, so the user cannot tick the box before they've
                reached the bottom of the policy. IsEnabled propagates to
                child controls in MAUI, so binding it on the row covers
                the CheckBox, the Label, and the row's TapGestureRecognizer
                in a single binding.
            -->
            <Grid
                Grid.Row="2"
                ColumnDefinitions="Auto,*"
                ColumnSpacing="8"
                HorizontalOptions="Start"
                IsEnabled="{Binding HasScrolledToEnd}"
                VerticalOptions="Center">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnAgreementRowTapped" />
                </Grid.GestureRecognizers>
                <CheckBox
                    x:Name="AgreementCheckBox"
                    Grid.Column="0"
                    IsChecked="{Binding HasAgreed, Mode=TwoWay}"
                    VerticalOptions="Center" />
                <Label
                    Grid.Column="1"
                    FontSize="16"
                    LineBreakMode="WordWrap"
                    Text="I have read and understood the Privacy Policy and agree to its terms."
                    TextColor="{AppThemeBinding Light={StaticResource Gray900},
                                                Dark={StaticResource Gray100}}"
                    VerticalOptions="Center"
                    VerticalTextAlignment="Center" />
            </Grid>

            <!--  Decline / Accept buttons  -->
            <Grid
                Grid.Row="3"
                ColumnDefinitions="*,*"
                ColumnSpacing="16">

                <Button
                    Grid.Column="0"
                    Command="{Binding DeclineCommand}"
                    Style="{StaticResource M3SecondaryButtonStyle}"
                    Text="Decline" />

                <Button
                    Grid.Column="1"
                    Command="{Binding AcceptCommand}"
                    Style="{StaticResource M3PrimaryButtonStyle}"
                    Text="I Agree" />
            </Grid>

        </Grid>
    </Border>
</toolkit:Popup>
