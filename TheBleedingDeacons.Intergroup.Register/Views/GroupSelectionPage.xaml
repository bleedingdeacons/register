<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="TheBleedingDeacons.Intergroup.Register.Views.GroupSelectionPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:TheBleedingDeacons.Intergroup.Register.ViewModels"
             xmlns:models="clr-namespace:TheBleedingDeacons.Intergroup.Register.Models"
             x:DataType="vm:GroupSelectionViewModel"
             Title="{Binding Title}">

    <Grid>
        <!-- Main content - hidden while loading -->
        <Grid RowDefinitions="Auto,Auto,*" IsVisible="{Binding IsDataLoaded}">

            <!-- Header with selected day -->
            <Border Grid.Row="0" 
                    BackgroundColor="{StaticResource Primary}"
                    Padding="20,15"
                    Margin="0,0,0,10">
                <StackLayout Orientation="Horizontal" 
                            HorizontalOptions="CenterAndExpand"
                            Spacing="10">
                    <Label Text="📅" 
                           FontSize="24" 
                           VerticalOptions="Center" />
                    <Label Text="{Binding Header}" 
                           FontSize="20" 
                           FontAttributes="Bold"
                           TextColor="White" 
                           VerticalOptions="Center" />
                </StackLayout>
            </Border>

            <!-- Groups list -->
            <CollectionView Grid.Row="2"
                           ItemsSource="{Binding Groups}"
                           SelectionMode="None">

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Group">
                        <Border BackgroundColor="White"
                               StrokeShape="RoundRectangle 8"
                               Stroke="{StaticResource Gray200}"
                               StrokeThickness="1"
                               Margin="15,5">

                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:GroupSelectionViewModel}}, Path=SelectGroupCommand}"
                                                     CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>

                            <Grid Padding="15" 
                                  RowDefinitions="Auto,Auto,Auto,Auto" 
                                  ColumnDefinitions="*,Auto">

                                <!-- Group Name -->
                                <Label Grid.Row="0" Grid.Column="0"
                                       Text="{Binding Name}"
                                       FontSize="24"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource Gray900}" />

                                <Label Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                       Text="{Binding Time}"
                                       FontSize="18"                                       
                                       TextColor="{StaticResource Primary}"
                                       Margin="0,5,0,0" />

                                <StackLayout Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                           Orientation="Horizontal"
                                           Spacing="5"
                                           Margin="0,8,0,0">
                                    <Label Text="Location:"
                                           FontSize="18"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource Gray600}" />
                                    <Label Text="{Binding Location}"
                                           FontSize="18"
                                           TextColor="{StaticResource Gray700}" />
                                    <Label Text="Address:"
                                           FontSize="18"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource Gray600}" />
                                    <Label Text="{Binding Address}"
                                           FontSize="18"
                                           TextColor="{StaticResource Gray700}" />
                                </StackLayout>

                                <!-- Contact Info -->
                                <StackLayout Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"
                                           Spacing="2"
                                           Margin="0,8,0,0">

                                </StackLayout>

                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>

            <!-- Empty state -->
            <StackLayout Grid.Row="2"
                        Padding="40"
                        VerticalOptions="Center"
                        IsVisible="{Binding IsDataLoaded, Converter={StaticResource InvertedBoolConverter}}">

                <!--<Label Text="📋"
                       FontSize="64"
                       HorizontalOptions="Center"
                       TextColor="{StaticResource Gray300}" />

                <Label Text="No Groups Found"
                       FontSize="20"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"
                       TextColor="{StaticResource Gray500}"
                       Margin="0,20,0,0" />-->

                <!--<Label FontSize="16"
                       HorizontalOptions="Center"
                       TextColor="{StaticResource Gray400}"
                       HorizontalTextAlignment="Center"
                       Margin="0,10,0,20">
                    <Label.Text>
                        <MultiBinding StringFormat="No groups found for {0}.{1}Add a new group or import from Excel.">
                            <Binding Path="SelectedDay" />
                            <Binding Source="&#x0A;" />
                        </MultiBinding>
                    </Label.Text>
                </Label>-->

                <!--<Button Text="Add First Group"
                        Command="{Binding AddGroupCommand}"
                        BackgroundColor="{StaticResource Primary}"
                        TextColor="White"
                        FontSize="16"
                        HorizontalOptions="Center"
                        Padding="30,15" />-->

            </StackLayout>

        </Grid>

        <!-- Loading indicator - centered and visible while loading -->
        <StackLayout IsVisible="{Binding IsLoading}"
                     VerticalOptions="CenterAndExpand"
                     HorizontalOptions="CenterAndExpand">
            <ActivityIndicator IsRunning="{Binding IsLoading}"
                              Color="{StaticResource Primary}"
                              Scale="1.5" />
            <Label Text="Finding groups..."
                   HorizontalOptions="Center"
                   Margin="0,20,0,0"
                   FontSize="16"
                   TextColor="{StaticResource Gray600}" />
        </StackLayout>

    </Grid>

</ContentPage>