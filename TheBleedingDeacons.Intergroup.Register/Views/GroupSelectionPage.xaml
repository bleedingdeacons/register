<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="TheBleedingDeacons.Intergroup.Register.Views.GroupSelectionPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:TheBleedingDeacons.Intergroup.Register.ViewModels"
             xmlns:entities="clr-namespace:TheBleedingDeacons.Unity.Intergroup.Entities;assembly=TheBleedingDeacons.Unity.Intergroup"
             xmlns:controls="clr-namespace:TheBleedingDeacons.Intergroup.Register.Controls"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:DataType="vm:GroupSelectionViewModel"
             Title="{Binding Title}">

    <ContentPage.Behaviors>
        <toolkit:StatusBarBehavior StatusBarColor="{AppThemeBinding Light=White, Dark=Black}"
                                   StatusBarStyle="{AppThemeBinding Light=DarkContent, Dark=LightContent}"/>
    </ContentPage.Behaviors>

    <controls:PageScaffold IsBusy="{Binding IsLoading}"
                           BusyMessage="Finding groups..."
                           ContentPadding="0">
        <controls:PageScaffold.ContentBody>
            <CollectionView ItemsSource="{Binding Groups}"
                            IsVisible="{Binding IsDataLoaded}"
                            SelectionMode="None">

                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="8"/>
                </CollectionView.ItemsLayout>

                <CollectionView.Header>
                    <Grid HeightRequest="8"/>
                </CollectionView.Header>

                <CollectionView.Footer>
                    <Grid HeightRequest="16"/>
                </CollectionView.Footer>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="entities:Group">
                        <Border Style="{StaticResource M3ListItemCardStyle}"
                            Margin="16,0,16,16"
                            HorizontalOptions="Center"
                            WidthRequest="560"
                            MaximumWidthRequest="560">

                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:GroupSelectionViewModel}}, Path=SelectGroupCommand}"
                                                      CommandParameter="{Binding .}"/>
                            </Border.GestureRecognizers>

                            <Grid ColumnDefinitions="Auto,*,Auto,Auto"
                                  ColumnSpacing="12"
                                  RowDefinitions="Auto,Auto">

                                <!-- Leading registered tick -->
                                <Label Grid.Row="0" Grid.RowSpan="2" Grid.Column="0"
                                       Text="✓"
                                       FontSize="22"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light={StaticResource SuccessAccent}, Dark={StaticResource SuccessAccentDim}}"
                                       VerticalOptions="Center"
                                       IsVisible="{Binding Registered}"
                                       WidthRequest="24"
                                       HorizontalTextAlignment="Center"/>

                                <!-- Spacer when not registered so titles align -->
                                <BoxView Grid.Row="0" Grid.RowSpan="2" Grid.Column="0"
                                         WidthRequest="24"
                                         Color="Transparent"
                                         IsVisible="{Binding Registered, Converter={StaticResource InvertedBoolConverter}}"/>

                                <!-- Group name -->
                                <Label Grid.Row="0" Grid.Column="1"
                                       Text="{Binding Name}"
                                       FontSize="17"
                                       FontAttributes="Bold"
                                       LineBreakMode="TailTruncation"
                                       TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource Gray100}}"
                                       VerticalOptions="Center"/>

                                <!-- Registered chip -->
                                <Border Grid.Row="1" Grid.Column="1"
                                        Style="{StaticResource M3RegisteredChipStyle}"
                                        IsVisible="{Binding Registered}"
                                        Margin="0,4,0,0">
                                    <Label Text="Registered"
                                           Style="{StaticResource M3RegisteredChipLabelStyle}"/>
                                </Border>

                                <!-- Trailing chevron -->
                                <Label Grid.Row="0" Grid.RowSpan="2" Grid.Column="3"
                                       Text="›"
                                       FontSize="28"
                                       TextColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray500}}"
                                       VerticalOptions="Center"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

                <CollectionView.EmptyView>
                    <VerticalStackLayout Padding="40,60"
                                         VerticalOptions="Center"
                                         HorizontalOptions="Center"
                                         Spacing="0">
                        <Label Text="👥"
                               Style="{StaticResource M3EmptyStateIconStyle}"/>
                        <Label Text="No groups found"
                               Style="{StaticResource M3EmptyStateTitleStyle}"/>
                        <Label Text="No groups for this day and meeting type."
                               Style="{StaticResource M3EmptyStateSubtitleStyle}"/>
                    </VerticalStackLayout>
                </CollectionView.EmptyView>

            </CollectionView>
        </controls:PageScaffold.ContentBody>
    </controls:PageScaffold>

</ContentPage>