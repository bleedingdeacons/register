<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="TheBleedingDeacons.Intergroup.Register.Views.GroupSelectionPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:TheBleedingDeacons.Intergroup.Register.ViewModels"
             xmlns:entities="clr-namespace:TheBleedingDeacons.Unity.Intergroup.Entities;assembly=TheBleedingDeacons.Unity.Intergroup"
             x:DataType="vm:GroupSelectionViewModel"
             Title="{Binding Title}">

    <Grid>
        <!-- Main content - hidden while loading -->
        <Grid RowDefinitions="*" IsVisible="{Binding IsDataLoaded}" Margin="10">

            <!-- Groups list -->
            <CollectionView ItemsSource="{Binding Groups}"
                           SelectionMode="None">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="5" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="entities:Group">
                        <Border StrokeShape="RoundRectangle 15"
                Stroke="#80FFFFFF"
                StrokeThickness="1"
                BackgroundColor="#0071BB"
                Margin="15,5">

                            <Border.Shadow>
                                <Shadow Brush="Black"
                        Opacity="0.25"
                        Radius="12"
                        Offset="0,6" />
                            </Border.Shadow>

                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:GroupSelectionViewModel}}, Path=SelectGroupCommand}"
                                     CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>

                            <Grid Padding="14,10"
                  RowDefinitions="Auto,Auto"
                  ColumnDefinitions="Auto,*,Auto">

                                <!-- Registered indicator -->
                                <Label Grid.Row="0" Grid.RowSpan="2" Grid.Column="0"
                       Text="✓"
                       FontSize="28"
                       FontAttributes="Bold"
                       TextColor="#A5D6A7"
                       VerticalOptions="Center"
                       Margin="0,0,12,0"
                       IsVisible="{Binding Registered}" />

                                <!-- Group Name -->
                                <Label Grid.Row="0" Grid.Column="1"
                       Text="{Binding Name}"
                       FontFamily="OpenSansRegular"
                       FontSize="24"
                       FontAttributes="Bold"
                       TextColor="White"
                       VerticalOptions="Center" />

                                <!-- Registered status text -->
                                <Label Grid.Row="1" Grid.Column="1"
                       Text="Registered"
                       FontSize="14"
                       FontAttributes="Bold"
                       TextColor="#C8E6C9"
                       IsVisible="{Binding Registered}" />

                                <!-- Arrow indicator -->
                                <Label Grid.Row="0" Grid.RowSpan="2" Grid.Column="2"
                       Text="›"
                       FontSize="32"
                       FontAttributes="Bold"
                       TextColor="White"
                       VerticalOptions="Center" />

                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

                <!-- Empty state -->
                <CollectionView.EmptyView>
                    <StackLayout Padding="40"
                                VerticalOptions="Center"
                                HorizontalOptions="Center">
                        <Label Text="No groups found for this day and type."
                               FontSize="18"
                               HorizontalOptions="Center"
                               HorizontalTextAlignment="Center"
                               TextColor="{StaticResource Gray500}" />
                    </StackLayout>
                </CollectionView.EmptyView>

            </CollectionView>

        </Grid>

        <!-- Loading indicator - centered and visible while loading -->
        <StackLayout IsVisible="{Binding IsLoading}"
                     VerticalOptions="CenterAndExpand"
                     HorizontalOptions="CenterAndExpand">
            <ActivityIndicator IsRunning="{Binding IsLoading}"
                              Color="{StaticResource Primary}"
                              Scale="1.5" />
            <Label Text="Finding groups..."
                   HorizontalOptions="Center"
                   Margin="0,20,0,0"
                   FontSize="16"
                   TextColor="{StaticResource Gray600}" />
        </StackLayout>

    </Grid>

</ContentPage>
