<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="TheBleedingDeacons.Intergroup.Register.Views.MainPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:TheBleedingDeacons.Intergroup.Register.ViewModels"
             x:DataType="vm:MainPageViewModel"
             Title="{Binding Title}">

    <Shell.TitleView>
        <Grid>
            <Label FontSize="Large" Text="{Binding AppVersion}"
                   Opacity="0.5"
                   VerticalOptions="Center"
                   HorizontalOptions="End"
                   Margin="0,0,8,0" TextColor="Yellow" />
        </Grid>
    </Shell.TitleView>

    <!-- Outer Grid: Row 0 = admin warning, Row 1 = existing content -->
    <Grid RowDefinitions="Auto,*">

        <!-- Row 0: Admin warning section -->
        <StackLayout Grid.Row="0"
                     IsVisible="{Binding IsMeetingSelected, Converter={StaticResource InvertedBoolConverter}}">
            <Border BackgroundColor="{AppThemeBinding Light=#FFC107, Dark=#FFB300}"
                    Padding="15,12">
                <Grid ColumnDefinitions="Auto,*,Auto"
                      ColumnSpacing="10"
                      VerticalOptions="Center">

                    <!-- Warning icon -->
                    <Label Grid.Column="0"
                           Text="⚠️"
                           FontSize="20"
                           VerticalOptions="Center"/>

                    <!-- Warning text aligned left -->
                    <Label Grid.Column="1"
                           Text="Meeting not started, go to Admin to start today's meeting. Internet connection is required."
                           FontSize="Large"
                           VerticalOptions="Center"
                           HorizontalOptions="Start"
                           TextColor="{AppThemeBinding Light=#5D4037, Dark=#FFE082}"
                           LineBreakMode="WordWrap"/>

                    <!-- Admin button aligned right with black border -->
                    <Button Grid.Column="2"
                            Text="Admin"
                            Command="{Binding GoToAdminCommand}"
                            FontSize="Medium"
                            HeightRequest="40"
                            Padding="20,0"
                            BackgroundColor="{AppThemeBinding Light=#FFF8E1, Dark=#4A3700}"
                            TextColor="{AppThemeBinding Light=#5D4037, Dark=#3E2723}"
                            BorderColor="Black"
                            BorderWidth="1"
                            CornerRadius="8"
                            HorizontalOptions="End"
                            VerticalOptions="Center"/>
                </Grid>
            </Border>
        </StackLayout>

        <!-- Row 1: Existing content grid -->
        <Grid Grid.Row="1"
              RowDefinitions="Auto,*,Auto,Auto"
              Padding="20,20,20,20">

            <!-- Row 0: Header -->
            <Label Grid.Row="0"
                   Text="Attendance Register 👆"
                   FontSize="Title"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"/>

            <!-- Row 1: Center image (flexible) -->
            <Image Grid.Row="1"
                   Source="badi.png"
                   HeightRequest="185"
                   Aspect="AspectFit"
                   VerticalOptions="Center" />

            <!-- Row 2: Welcome label -->
            <Label x:Name="WelcomeLabel"
                   Grid.Row="2"
                   FontSize="Large"
                   FontAttributes="Bold"
                   Text="Welcome to Bristol and District Intergroup"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center"
                   Margin="0,0,0,15"/>

            <!-- Row 3: Main action buttons -->
            <FlexLayout Grid.Row="3"
                        Direction="Row"
                        Wrap="Wrap"
                        JustifyContent="SpaceBetween"
                        AlignItems="Stretch"
                        AlignContent="Start">

                <Button x:Name="RegisterBtn" Style="{StaticResource PrimaryButtonStyle}"
                        Text="Group Service Representative"
                        Command="{Binding SelectTypeCommand}"
                        IsEnabled="{Binding IsButtonsEnabled}"
                        HeightRequest="180"
                        FlexLayout.Basis="48%"
                        Margin="0,0,5,0" />

                <Button x:Name="RegisterLOBtn" Style="{StaticResource PrimaryButtonStyle}"
                        Text="Intergroup Officer"
                        Command="{Binding SelectPositionCommand}"
                        IsEnabled="{Binding IsButtonsEnabled}"
                        HeightRequest="180"
                        FlexLayout.Basis="48%"
                        Margin="5,0,0,0" />

            </FlexLayout>

        </Grid>

    </Grid>

</ContentPage>
