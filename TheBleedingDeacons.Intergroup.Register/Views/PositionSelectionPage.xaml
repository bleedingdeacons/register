<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="TheBleedingDeacons.Intergroup.Register.Views.PositionSelectionPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:TheBleedingDeacons.Intergroup.Register.Controls"
    xmlns:entities="clr-namespace:TheBleedingDeacons.Unity.Intergroup.Entities;assembly=TheBleedingDeacons.Unity.Intergroup"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:vm="clr-namespace:TheBleedingDeacons.Intergroup.Register.ViewModels"
    Title="{Binding Title}"
    x:DataType="vm:PositionSelectionViewModel">

    <ContentPage.Behaviors>
        <toolkit:StatusBarBehavior StatusBarColor="{AppThemeBinding Light=White, Dark=Black}" StatusBarStyle="{AppThemeBinding Light=DarkContent, Dark=LightContent}" />
    </ContentPage.Behaviors>

    <controls:PageScaffold
        BusyMessage="Loading positions..."
        ContentPadding="0"
        IsBusy="{Binding IsLoading}">
        <controls:PageScaffold.ContentBody>
            <CollectionView
                IsVisible="{Binding IsDataLoaded}"
                ItemsSource="{Binding Positions}"
                SelectionMode="None">

                <CollectionView.ItemsLayout>
                    <LinearItemsLayout ItemSpacing="8" Orientation="Vertical" />
                </CollectionView.ItemsLayout>

                <CollectionView.Header>
                    <Grid HeightRequest="8" />
                </CollectionView.Header>

                <CollectionView.Footer>
                    <Grid HeightRequest="16" />
                </CollectionView.Footer>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="entities:Position">
                        <!--
                            Strict-button list item to match DaySelectionPage's
                            tile pattern. The 3-column grid (*,2*,*) constrains
                            the button to the middle 50% of the row, with the
                            outer columns acting as flexible side margins, so
                            tile sizing matches the day picker visually.

                            Registered positions switch from the filled primary
                            tile to a tonal secondary look (Gray100/Gray800 fill,
                            Primary text, no drop shadow) — the same recessed
                            treatment M3SecondaryButtonStyle applies to the
                            primary button. The DataTrigger lives on a Style
                            local to the DataTemplate rather than via a global
                            converter so the registered/unregistered look stays
                            visible at a glance from the markup.
                        -->
                        <Grid ColumnDefinitions="*,2*,*">
                            <Button
                                Grid.Column="1"
                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:PositionSelectionViewModel}}, Path=SelectPositionCommand}"
                                CommandParameter="{Binding .}"
                                FontSize="18"
                                HeightRequest="72"
                                HorizontalOptions="Fill"
                                Text="{Binding LongName}">
                                <Button.Style>
                                    <Style BasedOn="{StaticResource M3TileButtonStyle}" TargetType="Button">
                                        <Style.Triggers>
                                            <DataTrigger
                                                Binding="{Binding Registered}"
                                                TargetType="Button"
                                                Value="True">
                                                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray800}}" />
                                                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                                                <Setter Property="Shadow" Value="{x:Null}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

                <CollectionView.EmptyView>
                    <VerticalStackLayout
                        Padding="40,60"
                        HorizontalOptions="Center"
                        Spacing="0"
                        VerticalOptions="Center">
                        <Label Style="{StaticResource M3EmptyStateIconStyle}" Text="👥" />
                        <Label Style="{StaticResource M3EmptyStateTitleStyle}" Text="No positions found" />
                        <Label Style="{StaticResource M3EmptyStateSubtitleStyle}" Text="No positions are currently available." />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>

            </CollectionView>
        </controls:PageScaffold.ContentBody>
    </controls:PageScaffold>

</ContentPage>
