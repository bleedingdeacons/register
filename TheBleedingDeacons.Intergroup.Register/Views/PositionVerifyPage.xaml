<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="TheBleedingDeacons.Intergroup.Register.Views.PositionVerifyPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:controls="clr-namespace:TheBleedingDeacons.Intergroup.Register.Controls"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:TheBleedingDeacons.Intergroup.Register.ViewModels"
             xmlns:entities="clr-namespace:TheBleedingDeacons.Unity.Intergroup.Entities;assembly=TheBleedingDeacons.Unity.Intergroup"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:DataType="viewmodels:VerifyPositionViewModel"
             Title="{Binding Title}">

    <ContentPage.Behaviors>
        <toolkit:StatusBarBehavior StatusBarColor="{AppThemeBinding Light=White, Dark=Black}"
                                   StatusBarStyle="{AppThemeBinding Light=DarkContent, Dark=LightContent}"/>
    </ContentPage.Behaviors>

    <controls:PageScaffold IsBusy="{Binding IsLoading}"
                           BusyMessage="Loading..."
                           HasActionBar="True">

        <!-- ═══ Body ═══ -->
        <controls:PageScaffold.ContentBody>
            <ScrollView>
                <VerticalStackLayout Spacing="16">

                    <!-- Header -->
                    <!--<VerticalStackLayout Spacing="4">
                        <Label Text="{Binding Position.ShortDescription}"
                               FontSize="24"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource Gray100}}"
                               LineBreakMode="WordWrap"/>
                        <Label Text="{Binding HolderCountText}"
                               Style="{StaticResource SecondaryTextStyle}"/>
                    </VerticalStackLayout>-->

                    <!-- Holder list -->
                    <CollectionView ItemsSource="{Binding ActiveHolders}"
                                    SelectionMode="None"
                                    IsVisible="{Binding HasActiveHolders}">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Vertical" ItemSpacing="0"/>
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="entities:Member">
                                <Border Style="{StaticResource M3CardStyle}"
                                        HorizontalOptions="Center"
                                        WidthRequest="560"
                                        MaximumWidthRequest="560">
                                    <VerticalStackLayout Spacing="6">
                                        <Label Text="Name" Style="{StaticResource FieldLabelStyle}"/>
                                        <Label Text="{Binding AnonymousName}" Style="{StaticResource ValueLabelStyle}"/>

                                        <Label Text="Personal Email" Style="{StaticResource FieldLabelStyle}"/>
                                        <controls:MaskedRevealLabel x:Name="EmailReveal"
                                                                    Value="{Binding PersonalEmail}"
                                                                    MaskType="Email"
                                                                    ShowRevealButton="False"
                                                                    FontSize="16"
                                                                    Margin="0,0,0,4"
                                                                    BackgroundColor="Transparent"
                                                                    TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource Gray100}}"/>

                                        <Label Text="Mobile Phone" Style="{StaticResource FieldLabelStyle}"/>
                                        <controls:MaskedRevealLabel x:Name="MobileReveal"
                                                                    Value="{Binding MobileNumber}"
                                                                    MaskType="Mobile"
                                                                    ShowRevealButton="False"
                                                                    FontSize="16"
                                                                    Margin="0,0,0,4"
                                                                    BackgroundColor="Transparent"
                                                                    TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource Gray100}}"/>

                                        <Label Text="Rotation Date" Style="{StaticResource FieldLabelStyle}"/>
                                        <Label Text="{Binding IntergroupPositionRotation}"
                                               Style="{StaticResource ValueLabelStyle}"/>

                                        <!-- Card-level Review toggle: reveals both fields while held -->
                                        <Button Text="Review"
                                                Style="{StaticResource M3SecondaryButtonStyle}"
                                                HorizontalOptions="Center"
                                                WidthRequest="160"
                                                HeightRequest="44"
                                                Margin="0,8,0,0"
                                                Pressed="OnReviewPressed"
                                                Released="OnReviewReleased"/>
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <!-- Empty state card -->
                    <Border Style="{StaticResource M3CardStyle}"
                            IsVisible="{Binding HasActiveHolders, Converter={StaticResource InvertedBoolConverter}}">
                        <VerticalStackLayout HorizontalOptions="Center" Spacing="6" Padding="12">
                            <Label Text="No Position Holders"
                                   Style="{StaticResource M3EmptyStateTitleStyle}"/>
                            <Label Text="Tap 'No' below to add a position holder."
                                   Style="{StaticResource M3EmptyStateSubtitleStyle}"/>
                        </VerticalStackLayout>
                    </Border>

                </VerticalStackLayout>
            </ScrollView>
        </controls:PageScaffold.ContentBody>

        <!-- ═══ Action bar: prompt, then Yes (primary, top) / No (secondary, bottom) ═══ -->
        <controls:PageScaffold.ActionBarBody>
            <VerticalStackLayout Spacing="12">
                <Label Text="Is this correct?"
                       FontSize="22"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"
                       Margin="0,0,0,4"
                       TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource Gray100}}"/>
                <Button Text="Yes"
                        Command="{Binding YesCommand}"
                        IsEnabled="{Binding CanRegister}"
                        Style="{StaticResource M3PrimaryButtonStyle}"/>
                <Button Text="No"
                        Command="{Binding NoCommand}"
                        Style="{StaticResource M3SecondaryButtonStyle}"/>
            </VerticalStackLayout>
        </controls:PageScaffold.ActionBarBody>

    </controls:PageScaffold>

</ContentPage>