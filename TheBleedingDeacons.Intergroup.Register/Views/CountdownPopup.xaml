<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
               x:Class="TheBleedingDeacons.Intergroup.Register.Views.CountdownPopup"
               CanBeDismissedByTappingOutsideOfPopup="False">

    <Border BackgroundColor="White"
            Stroke="LightGray"
            StrokeThickness="1"
            WidthRequest="640"
            HeightRequest="400">
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="12"/>
        </Border.StrokeShape>

        <StackLayout Padding="60" Spacing="30">

            <!-- Title -->
            <Label Text="{Binding Title}"
                   FontSize="48"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   TextColor="Black"/>

            <!-- Message -->
            <Label Text="{Binding Message}"
                   FontSize="24"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center"
                   VerticalTextAlignment="Center"
                   LineBreakMode="WordWrap"
                   Padding="20"/>

            <!-- Next Button -->
            <Button Text="{Binding NextButtonText}"
                    Command="{Binding NavigateAndCloseCommand}"
                    BackgroundColor="#007ACC"
                    TextColor="White"
                    WidthRequest="360"
                    HeightRequest="72"
                    FontSize="24"
                    HorizontalOptions="Center"/>

            <!-- Progress indicator -->
            <ProgressBar Progress="{Binding CountdownSeconds, Converter={StaticResource CountdownToProgressConverter}}"
                        ProgressColor="#007ACC"
                        HeightRequest="12"/>
        </StackLayout>
    </Border>
</toolkit:Popup>