<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup
    x:Class="TheBleedingDeacons.Intergroup.Register.Views.CountdownPopup"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:vm="clr-namespace:TheBleedingDeacons.Intergroup.Register.ViewModels"
    x:DataType="vm:CountdownPopupViewModel"
    BackgroundColor="Transparent"
    CanBeDismissedByTappingOutsideOfPopup="True">

    <Border
        x:DataType="vm:CountdownPopupViewModel"
        HeightRequest="400"
        Style="{StaticResource M3CardStyle}"
        WidthRequest="640">

        <VerticalStackLayout
            Padding="32"
            Spacing="24"
            VerticalOptions="Center">

            <!--  Title  -->
            <Label
                FontAttributes="Bold"
                FontSize="32"
                HorizontalOptions="Center"
                HorizontalTextAlignment="Center"
                LineBreakMode="WordWrap"
                Text="{Binding Title}"
                TextColor="{AppThemeBinding Light={StaticResource Gray900},
                                            Dark={StaticResource Gray100}}" />

            <!--  Message  -->
            <Label
                FontSize="18"
                HorizontalOptions="Center"
                HorizontalTextAlignment="Center"
                LineBreakMode="WordWrap"
                Text="{Binding Message}"
                TextColor="{AppThemeBinding Light={StaticResource Gray900},
                                            Dark={StaticResource Gray100}}"
                VerticalTextAlignment="Center" />

            <!--  Next Button  -->
            <Button
                Command="{Binding NavigateAndCloseCommand}"
                HorizontalOptions="Center"
                Style="{StaticResource M3PrimaryButtonStyle}"
                Text="{Binding NextButtonText}"
                WidthRequest="360" />

        </VerticalStackLayout>
    </Border>
</toolkit:Popup>
