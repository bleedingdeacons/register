<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="TheBleedingDeacons.Intergroup.Register.Views.GroupVerifyPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:controls="clr-namespace:TheBleedingDeacons.Intergroup.Register.Controls"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:TheBleedingDeacons.Intergroup.Register.ViewModels"
             xmlns:converters="clr-namespace:TheBleedingDeacons.Intergroup.Register.Converters"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:DataType="viewmodels:VerifyGroupViewModel"
             Title="{Binding Title}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <Style x:Key="HeaderLabelStyle" TargetType="Label">
                <Setter Property="FontSize" Value="24"/>
                <Setter Property="FontAttributes" Value="Bold"/>
                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"/>
                <Setter Property="Margin" Value="0,0,0,10"/>
            </Style>

            <Style x:Key="FieldLabelStyle" TargetType="Label">
                <Setter Property="FontSize" Value="20"/>
                <Setter Property="FontAttributes" Value="Bold"/>
                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}"/>
                <Setter Property="Margin" Value="0,0,0,5"/>
            </Style>

            <Style x:Key="ValueLabelStyle" TargetType="Label">
                <Setter Property="FontSize" Value="20"/>
                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource Gray100}}"/>
                <Setter Property="Margin" Value="0,0,0,15"/>
            </Style>

            <toolkit:InvertedBoolConverter x:Key="InvertedBoolConverter" />
            <converters:ObscurePhoneNumberConverter x:Key="ObscurePhoneNumber" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <ContentPage.Behaviors>
        <toolkit:StatusBarBehavior StatusBarColor="{AppThemeBinding Light=White, Dark=Black}" 
                                   StatusBarStyle="{AppThemeBinding Light=DarkContent, Dark=LightContent}" />
    </ContentPage.Behaviors>

    <Grid>
        <!-- Loading Indicator -->
        <ActivityIndicator IsVisible="{Binding IsLoading}" 
                          IsRunning="{Binding IsLoading}"
                          HorizontalOptions="Center"
                          VerticalOptions="Center"
                          Scale="1.5"
                          Color="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"/>

        <!-- Main Content -->
        <ScrollView IsVisible="{Binding IsLoading, Converter={StaticResource InvertedBoolConverter}}">
            <StackLayout Padding="20" Spacing="10">

                <!-- Group Name -->
                <Label Text="{Binding Group.Name}"
                       Style="{StaticResource HeaderLabelStyle}"/>

                <Label Text="Group Service Representative"
                       Style="{StaticResource FieldLabelStyle}"
                       Margin="0,0,0,10"/>

                <!-- GSR Name (Read-only) -->
                <Label Text="Name" Style="{StaticResource FieldLabelStyle}"/>
                <Label Text="{Binding PrimaryGsr.Name}" Style="{StaticResource ValueLabelStyle}"/>

                <!-- GSR Email (Read-only) -->
                <Label Text="Personal Email" Style="{StaticResource FieldLabelStyle}"/>
                <Label Text="{Binding PrimaryGsr.EmailPersonal}" Style="{StaticResource ValueLabelStyle}" />

                <!-- GSR Phone (Read-only, Obscured) -->
                <Label Text="Mobile Phone" Style="{StaticResource FieldLabelStyle}"/>
                <Label Text="{Binding PrimaryGsr.Phone, Converter={StaticResource ObscurePhoneNumber}}" 
                       Style="{StaticResource ValueLabelStyle}" />

                <!-- Standing In Section with Border -->
                <Border Stroke="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}"
                        StrokeThickness="2"
                        StrokeShape="RoundRectangle 10"
                        Padding="15"
                        Margin="0,10,0,15"
                        BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray900}}">
                    <StackLayout Spacing="10">
                        <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="10">
                            <Label Text="Are Standing In?" 
                                   Style="{StaticResource FieldLabelStyle}"
                                   VerticalOptions="Center"
                                   Margin="0"
                                   Grid.Column="0"/>
                            <CheckBox x:Name="StandingInCheckBox" 
                                      IsChecked="{Binding StandingIn, Mode=TwoWay}"
                                      Grid.Column="1"
                                      VerticalOptions="Center"/>
                        </Grid>

                        <!-- Stand-in Name and Email Entries -->
                        <StackLayout IsVisible="{Binding Source={x:Reference StandingInCheckBox}, Path=IsChecked}"
                                    Spacing="5">
                            <Label Text="Your Name" 
                                   Style="{StaticResource FieldLabelStyle}"
                                   Margin="0"/>
                            <controls:ClearableEntry x:Name="StandingInNameEntry"
                                       Text="{Binding StandinName}"
                                       Placeholder="Enter your name"
                                       Keyboard="Text"
                                       FontSize="18"
                                       BackgroundColor="{AppThemeBinding Light=White, Dark={StaticResource Gray800}}"
                                       TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource Gray100}}"/>

                            <Label Text="Your Email" 
                                   Style="{StaticResource FieldLabelStyle}"
                                   Margin="0"/>
                            <controls:ClearableEntry x:Name="StandingInEmailEntry"
                                       Text="{Binding StandinEmail}"
                                       Placeholder="Enter your email address"
                                       Keyboard="Email"
                                       FontSize="18"
                                       BackgroundColor="{AppThemeBinding Light=White, Dark={StaticResource Gray800}}"
                                       TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource Gray100}}"/>
                        </StackLayout>
                    </StackLayout>
                </Border>

                <Label FontSize="32"
                       FontAttributes="Bold"
                       Text="Is this correct?"
                       HorizontalOptions="Center"
                       Margin="0,10,0,0"/>

                <!-- Verify Mode Action Buttons -->
                <FlexLayout Direction="Row" 
                            JustifyContent="SpaceEvenly" 
                            AlignItems="Center"
                            Margin="0,20,0,0">

                    <Button Text="Yes" 
                            Command="{Binding YesCommand}"
                            IsEnabled="{Binding CanRegister}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            TextColor="White"
                            CornerRadius="25"
                            HeightRequest="100"
                            FlexLayout.Grow="1"
                            Margin="0,0,7.5,0"/>

                    <Button Text="No" 
                            Command="{Binding NoCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            TextColor="White"
                            CornerRadius="25"
                            HeightRequest="100"
                            FlexLayout.Grow="1"
                            Margin="7.5,0,0,0"/>
                </FlexLayout>

            </StackLayout>
        </ScrollView>
    </Grid>

</ContentPage>