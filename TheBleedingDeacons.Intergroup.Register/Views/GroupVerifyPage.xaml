<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="TheBleedingDeacons.Intergroup.Register.Views.GroupVerifyPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:controls="clr-namespace:TheBleedingDeacons.Intergroup.Register.Controls"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:TheBleedingDeacons.Intergroup.Register.ViewModels"
             xmlns:entities="clr-namespace:TheBleedingDeacons.Unity.Intergroup.Entities;assembly=TheBleedingDeacons.Unity.Intergroup"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:DataType="viewmodels:VerifyGroupViewModel"
             Title="{Binding Title}">

    <ContentPage.Behaviors>
        <toolkit:StatusBarBehavior StatusBarColor="{AppThemeBinding Light=White, Dark=Black}" 
                                   StatusBarStyle="{AppThemeBinding Light=DarkContent, Dark=LightContent}" />
    </ContentPage.Behaviors>

    <!-- Outer Grid: scrollable content on top, fixed buttons at bottom -->
    <Grid RowDefinitions="*,Auto" Padding="30,30,30,50">

        <!-- Scrollable content (Row 0) -->
            <StackLayout Grid.Row="0" Spacing="10">

                <Label Text="{Binding Group.Name}"
                       Style="{StaticResource HeaderLabelStyle}"/>

                <Label Text="{Binding GsrCountText}"
                       FontSize="18"
                       FontAttributes="Italic"
                       TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"
                       Margin="0,0,0,5"/>

                <CollectionView ItemsSource="{Binding ActiveGsrs}"
                                SelectionMode="None"
                                IsVisible="{Binding HasActiveGsrs}" HorizontalOptions="Center">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Horizontal" ItemSpacing="5" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="entities:Member">
                            <Border Style="{StaticResource MemberCardStyle}"
                                    MinimumWidthRequest="500"
                                    MinimumHeightRequest="180">
                                <StackLayout Spacing="4">
                                    <Label Text="Name" Style="{StaticResource FieldLabelStyle}"/>
                                    <Label Text="{Binding AnonymousName}" Style="{StaticResource ValueLabelStyle}"/>

                                    <Label Text="Personal Email" Style="{StaticResource FieldLabelStyle}"/>
                                    <Label Text="{Binding PersonalEmail}" Style="{StaticResource ValueLabelStyle}"/>

                                    <Label Text="Mobile Phone" Style="{StaticResource FieldLabelStyle}"/>
                                    <Label Text="{Binding MobileNumber, Converter={StaticResource ObscurePhoneNumber}}"
                                           Style="{StaticResource ValueLabelStyle}"/>
                                </StackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <Border IsVisible="{Binding HasActiveGsrs, Converter={StaticResource InvertedBoolConverter}}"
                        Stroke="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 10"
                        Padding="20"
                        Margin="0,10,0,10"
                        BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray900}}">
                    <StackLayout HorizontalOptions="Center" Spacing="10">
                        <Label Text="No GSRs Registered"
                               FontSize="20"
                               FontAttributes="Bold"
                               HorizontalOptions="Center"
                               TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"/>
                        <Label Text="Tap 'No' below to add a group service representative."
                               FontSize="16"
                               HorizontalOptions="Center"
                               HorizontalTextAlignment="Center"
                               TextColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray500}}"/>
                    </StackLayout>
                </Border>

            <Border IsVisible="{Binding HasActiveGsrs}"
        Stroke="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}"
        StrokeThickness="2"
        StrokeShape="RoundRectangle 10"
        Padding="15"
        Margin="0,10,0,15"
        HorizontalOptions="Center"
        BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray900}}">
                <StackLayout Spacing="10" x:Name="StandingIn" HorizontalOptions="Center">
                    <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="10" HorizontalOptions="Center">
                        <Label Text="Are Standing In?" 
                   FontSize="20"
                   FontAttributes="Bold"
                   TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}"
                   VerticalOptions="Center"
                   Grid.Column="0"/>
                        <CheckBox x:Name="StandingInCheckBox" 
                      IsChecked="{Binding StandingIn, Mode=TwoWay}"
                      Grid.Column="1"
                      VerticalOptions="Center"/>
                    </Grid>

                    <StackLayout IsVisible="{Binding Source={x:Reference StandingInCheckBox}, Path=IsChecked}"
                     Spacing="5"
                     HorizontalOptions="Center">
                        <Label Text="Your Name" 
                   FontSize="20"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}"/>
                        <controls:ClearableEntry x:Name="StandingInNameEntry"
                       Text="{Binding StandinName}"
                       Placeholder="Enter your name"
                       Keyboard="Text"
                       FontSize="18"
                       WidthRequest="300"
                       BackgroundColor="{AppThemeBinding Light=White, Dark={StaticResource Gray800}}"
                       TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource Gray100}}"/>
                    </StackLayout>
                </StackLayout>
            </Border>

            
            </StackLayout>
        
        <!-- Fixed action buttons at base of page (Row 1) -->
        <!-- Fixed action buttons at base of page (Row 1) -->
        <FlexLayout Grid.Row="1"
            Direction="Row"
            JustifyContent="SpaceEvenly"
            AlignItems="Center"
            IsVisible="{Binding IsLoading, Converter={StaticResource InvertedBoolConverter}}">

            <Label FontSize="Medium"
           FontAttributes="Bold"
           Text="Is this correct?"
           HorizontalOptions="Center"
           Margin="0,10,0,10"
           IsVisible="{Binding HasActiveGsrs}"/>

            <Button Text="Yes" 
            Command="{Binding YesCommand}"
            IsEnabled="{Binding CanRegister}"
            IsVisible="{Binding HasActiveGsrs}"
            Style="{StaticResource PrimaryButtonStyle}"
            TextColor="White"
            CornerRadius="25"
            HeightRequest="100"
            FlexLayout.Grow="1"
            Margin="0,0,7.5,0"/>

            <Button Text="{Binding NoButtonText}"
            Command="{Binding NoCommand}"
            Style="{StaticResource PrimaryButtonStyle}"
            TextColor="White"
            CornerRadius="25"
            HeightRequest="100"
            FlexLayout.Grow="1"
            Margin="7.5,0,0,0"/>
        </FlexLayout>

        <!-- Loading Indicator spans both rows -->
        <ActivityIndicator Grid.RowSpan="2"
                           IsVisible="{Binding IsLoading}" 
                           IsRunning="{Binding IsLoading}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           Scale="1.5"
                           Color="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"/>


    </Grid>

</ContentPage>