<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="TheBleedingDeacons.Intergroup.Register.Views.GroupVerifyPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:controls="clr-namespace:TheBleedingDeacons.Intergroup.Register.Controls"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:TheBleedingDeacons.Intergroup.Register.ViewModels"
             xmlns:entities="clr-namespace:TheBleedingDeacons.Unity.Intergroup.Entities;assembly=TheBleedingDeacons.Unity.Intergroup"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:DataType="viewmodels:VerifyGroupViewModel"
             Title="{Binding Title}">

    <ContentPage.Behaviors>
        <toolkit:StatusBarBehavior StatusBarColor="{AppThemeBinding Light=White, Dark=Black}"
                                   StatusBarStyle="{AppThemeBinding Light=DarkContent, Dark=LightContent}"/>
    </ContentPage.Behaviors>

    <controls:PageScaffold IsBusy="{Binding IsLoading}"
                           BusyMessage="Loading..."
                           HasActionBar="True">

        <!-- ═══ Body ═══ -->
        <controls:PageScaffold.ContentBody>
            <ScrollView>
                <VerticalStackLayout Spacing="16">

                    <!-- Header -->
                    <!--<VerticalStackLayout Spacing="4">
                        <Label Text="{Binding Group.Name}"
                               FontSize="24"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource Gray100}}"
                               LineBreakMode="WordWrap"/>
                        <Label Text="{Binding GsrCountText}"
                               Style="{StaticResource SecondaryTextStyle}"/>
                    </VerticalStackLayout>-->

                    <!-- Member list -->
                    <CollectionView ItemsSource="{Binding ActiveGsrs}"
                                    SelectionMode="None"
                                    IsVisible="{Binding HasActiveGsrs}">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Vertical" ItemSpacing="0"/>
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="entities:Member">
                                <Border Style="{StaticResource M3CardStyle}"
                                        HorizontalOptions="Center"
                                        WidthRequest="560"
                                        MaximumWidthRequest="560">
                                    <VerticalStackLayout Spacing="6">
                                        <Label Text="Name" Style="{StaticResource FieldLabelStyle}"/>
                                        <Label Text="{Binding AnonymousName}" Style="{StaticResource ValueLabelStyle}"/>

                                        <Label Text="Personal Email" Style="{StaticResource FieldLabelStyle}"/>
                                        <controls:MaskedRevealLabel x:Name="EmailReveal"
                                                                    Value="{Binding PersonalEmail}"
                                                                    MaskType="Email"
                                                                    ShowRevealButton="False"
                                                                    FontSize="16"
                                                                    Margin="0,0,0,4"
                                                                    BackgroundColor="Transparent"
                                                                    TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource Gray100}}"/>

                                        <Label Text="Mobile Phone" Style="{StaticResource FieldLabelStyle}"/>
                                        <controls:MaskedRevealLabel x:Name="MobileReveal"
                                                                    Value="{Binding MobileNumber}"
                                                                    MaskType="Mobile"
                                                                    ShowRevealButton="False"
                                                                    FontSize="16"
                                                                    Margin="0,0,0,4"
                                                                    BackgroundColor="Transparent"
                                                                    TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource Gray100}}"/>

                                        <!-- Card-level Review toggle: reveals both fields while held -->
                                        <Button Text="Review"
                                                Style="{StaticResource M3SecondaryButtonStyle}"
                                                HorizontalOptions="Center"
                                                WidthRequest="160"
                                                HeightRequest="44"
                                                Margin="0,8,0,0"
                                                Pressed="OnReviewPressed"
                                                Released="OnReviewReleased"/>
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <!-- Empty state card -->
                    <Border Style="{StaticResource M3CardStyle}"
                            IsVisible="{Binding HasActiveGsrs, Converter={StaticResource InvertedBoolConverter}}">
                        <VerticalStackLayout HorizontalOptions="Center" Spacing="6" Padding="12">
                            <Label Text="No GSRs Registered"
                                   Style="{StaticResource M3EmptyStateTitleStyle}"/>
                            <Label Text="Tap 'No' below to add a group service representative."
                                   Style="{StaticResource M3EmptyStateSubtitleStyle}"/>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Standing-in card (only when there ARE active GSRs) -->
                    <Border Style="{StaticResource M3CardStyle}"
                            IsVisible="{Binding HasActiveGsrs}"
                            HorizontalOptions="Center"
                            WidthRequest="560"
                            MaximumWidthRequest="560">
                        <!--
                            Two rows:
                              1. Prompt + checkbox, centred as a pair.
                              2. "Your Name" label + entry, centred,
                                 shown only while the checkbox is ticked.
                        -->
                        <VerticalStackLayout Spacing="12">

                            <!-- Row 1: prompt + checkbox, centred -->
                            <HorizontalStackLayout Spacing="8"
                                                   HorizontalOptions="Center"
                                                   VerticalOptions="Center">
                                <Label Text="Are you standing in?"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       VerticalOptions="Center"
                                       TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource Gray100}}"/>
                                <CheckBox x:Name="StandingInCheckBox"
                                          IsChecked="{Binding StandingIn, Mode=TwoWay}"
                                          VerticalOptions="Center"/>
                            </HorizontalStackLayout>

                            <!-- Row 2: "Your Name" label + entry, centred, only when ticked -->
                            <VerticalStackLayout Spacing="6"
                                                 HorizontalOptions="Center"
                                                 WidthRequest="360"
                                                 MaximumWidthRequest="360"
                                                 IsVisible="{Binding Source={x:Reference StandingInCheckBox}, Path=IsChecked}">
                                <Label Text="Your Name"
                                       HorizontalOptions="Center"
                                       Style="{StaticResource FieldLabelStyle}"/>
                                <controls:CloseableEntry x:Name="StandingInNameEntry"
                                                         Text="{Binding StandinName}"
                                                         Placeholder="Enter your name"
                                                         Keyboard="Text"
                                                         FontSize="16"
                                                         HorizontalOptions="Fill"
                                                         HorizontalTextAlignment="Center"
                                                         VerticalOptions="Center"
                                                         BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource Gray800}}"
                                                         TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource Gray100}}"/>
                            </VerticalStackLayout>

                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </ScrollView>
        </controls:PageScaffold.ContentBody>

        <!-- ═══ Action bar: prompt, then No (left) / Yes (right) horizontally ═══ -->
        <!--
             Buttons are arranged horizontally, side by side. The pair
             together occupies half the screen width and is centred via the
             outer three-column Grid (*,2*,*). The action-bar Border itself
             (in PageScaffold) sizes to its content height, so the bar is
             just tall enough to hold the prompt + one row of buttons.

             When there are no active GSRs, only the No button is shown and
             it is centred on its own at the same half-screen width.
        -->
        <controls:PageScaffold.ActionBarBody>
            <VerticalStackLayout Spacing="12">
                <Label Text="Is this correct?"
                       FontSize="22"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"
                       Margin="0,0,0,4"
                       TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource Gray100}}"
                       IsVisible="{Binding HasActiveGsrs}"/>

                <!-- With active GSRs: No (left) / Yes (right) -->
                <Grid ColumnDefinitions="*,2*,*"
                      IsVisible="{Binding HasActiveGsrs}">
                    <Grid Grid.Column="1"
                          ColumnDefinitions="*,*"
                          ColumnSpacing="12">
                        <Button Grid.Column="0"
                                Text="{Binding NoButtonText}"
                                Command="{Binding NoCommand}"
                                Style="{StaticResource M3SecondaryButtonStyle}"
                                HorizontalOptions="Fill"/>
                        <Button Grid.Column="1"
                                Text="Yes"
                                Command="{Binding YesCommand}"
                                IsEnabled="{Binding CanRegister}"
                                Style="{StaticResource M3PrimaryButtonStyle}"
                                HorizontalOptions="Fill"/>
                    </Grid>
                </Grid>

                <!-- No active GSRs: single No button, half-width, centred -->
                <Grid ColumnDefinitions="*,2*,*"
                      IsVisible="{Binding HasActiveGsrs, Converter={StaticResource InvertedBoolConverter}}">
                    <Button Grid.Column="1"
                            Text="{Binding NoButtonText}"
                            Command="{Binding NoCommand}"
                            Style="{StaticResource M3SecondaryButtonStyle}"
                            HorizontalOptions="Fill"/>
                </Grid>
            </VerticalStackLayout>
        </controls:PageScaffold.ActionBarBody>

    </controls:PageScaffold>

</ContentPage>