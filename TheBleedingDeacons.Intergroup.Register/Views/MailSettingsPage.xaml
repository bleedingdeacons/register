<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="TheBleedingDeacons.Intergroup.Register.Views.MailSettingsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:TheBleedingDeacons.Intergroup.Register.Controls"
    xmlns:tc="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:vm="clr-namespace:TheBleedingDeacons.Intergroup.Register.ViewModels"
    Title="Mail Settings"
    x:DataType="vm:MailSettingsViewModel">

    <ContentPage.Resources>
        <tc:BoolToObjectConverter
            x:Key="BoolToColorConverter"
            FalseObject="Green"
            TrueObject="Red" />
        <tc:BoolToObjectConverter
            x:Key="BoolToTestButtonTextConverter"
            FalseObject="Test Connection"
            TrueObject="Testing Connection..." />
        <tc:BoolToObjectConverter
            x:Key="BoolToSaveButtonTextConverter"
            FalseObject="Save Settings"
            TrueObject="Saving..." />
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">

            <Label
                FontAttributes="Bold"
                FontSize="24"
                Text="SMTP Configuration" />

            <!--  Status Message  -->
            <Frame
                Padding="15"
                BackgroundColor="{Binding IsStatusError, Converter={StaticResource BoolToColorConverter}}"
                BorderColor="Transparent"
                IsVisible="{Binding IsStatusVisible}">
                <Label
                    FontAttributes="Bold"
                    Text="{Binding StatusMessage}"
                    TextColor="White" />
            </Frame>

            <!--  SMTP Server Settings + Authentication (side-by-side)  -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="15">

                <!--  SMTP Server Settings  -->
                <Frame
                    Grid.Column="0"
                    BackgroundColor="{AppThemeBinding Light=White,
                                                     Dark=#2D2D30}"
                    BorderColor="{AppThemeBinding Light=LightGray,
                                                  Dark=Gray}">
                    <VerticalStackLayout Spacing="15">

                        <Label
                            FontAttributes="Bold"
                            FontSize="18"
                            Text="SMTP Server Settings" />

                        <VerticalStackLayout>
                            <Label Text="SMTP Host *" />
                            <controls:ClearableEntry Placeholder="smtp.gmail.com" Text="{Binding Host}" />
                        </VerticalStackLayout>

                        <Grid ColumnDefinitions="2*,*" ColumnSpacing="10">
                            <VerticalStackLayout Grid.Column="0">
                                <Label Text="Port *" />
                                <controls:ClearableEntry
                                    Keyboard="Numeric"
                                    Placeholder="587"
                                    Text="{Binding Port}" />
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Column="1">
                                <Label Text="Enable SSL" />
                                <Switch IsToggled="{Binding EnableSsl}" VerticalOptions="Center" />
                            </VerticalStackLayout>
                        </Grid>

                    </VerticalStackLayout>
                </Frame>

                <!--  Authentication  -->
                <Frame
                    Grid.Column="1"
                    BackgroundColor="{AppThemeBinding Light=White,
                                                     Dark=#2D2D30}"
                    BorderColor="{AppThemeBinding Light=LightGray,
                                                  Dark=Gray}">
                    <VerticalStackLayout Spacing="15">

                        <Label
                            FontAttributes="Bold"
                            FontSize="18"
                            Text="Authentication" />

                        <VerticalStackLayout>
                            <Label Text="Email Address *" />
                            <controls:ClearableEntry
                                Keyboard="Email"
                                Placeholder="your-email@gmail.com"
                                Text="{Binding Username}" />
                        </VerticalStackLayout>

                        <VerticalStackLayout>
                            <Label Text="Password / App Password *" />
                            <controls:ClearableEntry
                                IsPassword="True"
                                Placeholder="Enter password or app password"
                                Text="{Binding Password}" />
                        </VerticalStackLayout>

                        <VerticalStackLayout>
                            <Label Text="From Display Name" />
                            <controls:ClearableEntry Placeholder="Your App Name" Text="{Binding FromDisplayName}" />
                        </VerticalStackLayout>

                    </VerticalStackLayout>
                </Frame>

            </Grid>

            <!--  Help Section  -->
            <Frame BackgroundColor="{AppThemeBinding Light=#E3F2FD, Dark=#1E3A8A}" BorderColor="{AppThemeBinding Light=#2196F3, Dark=#3B82F6}">
                <VerticalStackLayout>
                    <Label
                        FontAttributes="Bold"
                        Text="&#x1F4A1; Gmail Users"
                        TextColor="{AppThemeBinding Light=#1976D2,
                                                    Dark=#60A5FA}" />
                    <Label TextColor="{AppThemeBinding Light=#1565C0, Dark=#93C5FD}">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="• Use smtp.gmail.com, Port 587, SSL enabled" />
                                <Span Text="&#x0a;• Use App Password instead of regular password" />
                                <Span Text="&#x0a;• Enable 2FA and generate App Password in Google Account settings" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                </VerticalStackLayout>
            </Frame>

            <!--  Action Buttons (side-by-side)  -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <Button
                    Grid.Column="0"
                    BackgroundColor="{AppThemeBinding Light=#4CAF50,
                                                      Dark=#22C55E}"
                    Command="{Binding TestConnectionCommand}"
                    IsEnabled="{Binding IsFormValid}"
                    Text="{Binding IsTestingConnection, Converter={StaticResource BoolToTestButtonTextConverter}}"
                    TextColor="White">
                    <Button.Triggers>
                        <DataTrigger
                            Binding="{Binding IsTestingConnection}"
                            TargetType="Button"
                            Value="True">
                            <Setter Property="BackgroundColor" Value="Gray" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>

                <Button
                    Grid.Column="1"
                    BackgroundColor="{AppThemeBinding Light=#2196F3,
                                                      Dark=#3B82F6}"
                    Command="{Binding SaveSettingsCommand}"
                    IsEnabled="{Binding IsFormValid}"
                    Text="{Binding IsSaving, Converter={StaticResource BoolToSaveButtonTextConverter}}"
                    TextColor="White">
                    <Button.Triggers>
                        <DataTrigger
                            Binding="{Binding IsSaving}"
                            TargetType="Button"
                            Value="True">
                            <Setter Property="BackgroundColor" Value="Gray" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
            </Grid>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
