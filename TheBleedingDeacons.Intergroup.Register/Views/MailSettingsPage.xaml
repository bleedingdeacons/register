<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="TheBleedingDeacons.Intergroup.Register.Views.MailSettingsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:tc="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:vm="clr-namespace:TheBleedingDeacons.Intergroup.Register.ViewModels"
    Title="Mail Settings"
    x:DataType="vm:MailSettingsViewModel">

    <ContentPage.Resources>
        <tc:BoolToObjectConverter
            x:Key="BoolToColorConverter"
            FalseObject="Green"
            TrueObject="Red" />
        <tc:BoolToObjectConverter
            x:Key="BoolToTestButtonTextConverter"
            FalseObject="Test Connection"
            TrueObject="Testing Connection..." />
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">

            <Label
                FontAttributes="Bold"
                FontSize="24"
                Text="SMTP Configuration" />

            <Label FontSize="13" Text="These settings come from the site, through Freedom. Change them there; the tablet picks them up on its next sync." />

            <!--  Not set up  -->
            <Frame
                Padding="15"
                BackgroundColor="{AppThemeBinding Light=#FFF3E0, Dark=#4E342E}"
                BorderColor="{AppThemeBinding Light=#FB8C00, Dark=#FFB74D}"
                IsVisible="{Binding IsNotConfigured}">
                <Label Text="SMTP is not set up for this tablet. Sign in to Freedom under API Settings, and check the register application's smtp.* values on the site." />
            </Frame>

            <!--  Status Message  -->
            <Frame
                Padding="15"
                BackgroundColor="{Binding IsStatusError, Converter={StaticResource BoolToColorConverter}}"
                BorderColor="Transparent"
                IsVisible="{Binding IsStatusVisible}">
                <Label
                    FontAttributes="Bold"
                    Text="{Binding StatusMessage}"
                    TextColor="White" />
            </Frame>

            <Frame BackgroundColor="{AppThemeBinding Light=White, Dark=#2D2D30}" BorderColor="{AppThemeBinding Light=LightGray, Dark=Gray}">
                <Grid
                    ColumnDefinitions="Auto,*"
                    ColumnSpacing="20"
                    RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
                    RowSpacing="12">

                    <Label Grid.Row="0" FontAttributes="Bold" Text="Host" />
                    <Label Grid.Row="0" Grid.Column="1" Text="{Binding Host}" />

                    <Label Grid.Row="1" FontAttributes="Bold" Text="Port" />
                    <Label Grid.Row="1" Grid.Column="1" Text="{Binding Port}" />

                    <Label Grid.Row="2" FontAttributes="Bold" Text="Security" />
                    <Label Grid.Row="2" Grid.Column="1" Text="{Binding Security}" />

                    <Label Grid.Row="3" FontAttributes="Bold" Text="Username" />
                    <Label Grid.Row="3" Grid.Column="1" Text="{Binding Username}" />

                    <Label Grid.Row="4" FontAttributes="Bold" Text="Password" />
                    <Label Grid.Row="4" Grid.Column="1" Text="{Binding Password}" />

                    <Label Grid.Row="5" FontAttributes="Bold" Text="From name" />
                    <Label Grid.Row="5" Grid.Column="1" Text="{Binding FromDisplayName}" />
                </Grid>
            </Frame>

            <Button
                BackgroundColor="{AppThemeBinding Light=#4CAF50,
                                                  Dark=#22C55E}"
                Command="{Binding TestConnectionCommand}"
                Text="{Binding IsTestingConnection, Converter={StaticResource BoolToTestButtonTextConverter}}"
                TextColor="White">
                <Button.Triggers>
                    <DataTrigger
                        Binding="{Binding IsTestingConnection}"
                        TargetType="Button"
                        Value="True">
                        <Setter Property="BackgroundColor" Value="Gray" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
