<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="TheBleedingDeacons.Intergroup.Register.Views.RegistrationOverviewPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:TheBleedingDeacons.Intergroup.Register.ViewModels"
             xmlns:controls="clr-namespace:TheBleedingDeacons.Intergroup.Register.Controls"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:DataType="vm:RegistrationOverviewViewModel"
             Title="Registrations">

    <ContentPage.Behaviors>
        <toolkit:StatusBarBehavior StatusBarColor="{AppThemeBinding Light=White, Dark=Black}"
                                   StatusBarStyle="{AppThemeBinding Light=DarkContent, Dark=LightContent}"/>
    </ContentPage.Behaviors>

    <controls:PageScaffold IsBusy="{Binding IsLoading}"
                           BusyMessage="Loading registrations..."
                           ContentPadding="0">

        <controls:PageScaffold.ContentBody>
            <Grid RowDefinitions="Auto,Auto,*">

                <!-- ═══ Row 0: Tab bar with active underline ═══ -->
                <Grid Grid.Row="0"
                      ColumnDefinitions="*,*"
                      BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource Gray900}}">

                    <!-- Groups tab -->
                    <Grid Grid.Column="0"
                          RowDefinitions="*,3">
                        <Button Grid.Row="0"
                                Text="Groups"
                                Command="{Binding ShowGroupsTabCommand}"
                                Style="{StaticResource M3TabButtonStyle}">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button"
                                             Binding="{Binding IsGroupsTabSelected}"
                                             Value="True">
                                    <Setter Property="TextColor"
                                            Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"/>
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>
                        <BoxView Grid.Row="1"
                                 Color="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                                 IsVisible="{Binding IsGroupsTabSelected}"/>
                    </Grid>

                    <!-- Positions tab -->
                    <Grid Grid.Column="1"
                          RowDefinitions="*,3">
                        <Button Grid.Row="0"
                                Text="Positions"
                                Command="{Binding ShowPositionsTabCommand}"
                                Style="{StaticResource M3TabButtonStyle}">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button"
                                             Binding="{Binding IsPositionsTabSelected}"
                                             Value="True">
                                    <Setter Property="TextColor"
                                            Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"/>
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>
                        <BoxView Grid.Row="1"
                                 Color="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                                 IsVisible="{Binding IsPositionsTabSelected}"/>
                    </Grid>

                    <!-- Full-width tab underline baseline -->
                    <BoxView Grid.Column="0"
                             Grid.ColumnSpan="2"
                             HeightRequest="1"
                             VerticalOptions="End"
                             Color="{AppThemeBinding Light={StaticResource CardBorder}, Dark={StaticResource CardBorderDim}}"/>
                </Grid>

                <!-- ═══ Row 1: Summary strip (changes with selected tab) ═══ -->
                <Label Grid.Row="1"
                       Text="{Binding GroupsSummary}"
                       IsVisible="{Binding IsGroupsTabSelected}"
                       FontSize="13"
                       Padding="16,12,16,4"
                       Style="{StaticResource SecondaryTextStyle}"/>
                <Label Grid.Row="1"
                       Text="{Binding PositionsSummary}"
                       IsVisible="{Binding IsPositionsTabSelected}"
                       FontSize="13"
                       Padding="16,12,16,4"
                       Style="{StaticResource SecondaryTextStyle}"/>

                <!-- ═══ Row 2: Content ═══ -->
                <Grid Grid.Row="2">

                    <!-- ─── GROUPS TAB ─── -->
                    <RefreshView Command="{Binding LoadCommand}"
                                 IsRefreshing="{Binding IsLoading, Mode=OneWay}"
                                 IsVisible="{Binding IsGroupsTabSelected}">
                        <CollectionView ItemsSource="{Binding Groups}"
                                        SelectionMode="None">
                            <CollectionView.ItemsLayout>
                                <LinearItemsLayout Orientation="Vertical" ItemSpacing="0"/>
                            </CollectionView.ItemsLayout>
                            <CollectionView.Header>
                                <Grid HeightRequest="8"/>
                            </CollectionView.Header>
                            <CollectionView.Footer>
                                <Grid HeightRequest="16"/>
                            </CollectionView.Footer>
                            <CollectionView.EmptyView>
                                <VerticalStackLayout Padding="40,60" HorizontalOptions="Center" VerticalOptions="Center" Spacing="0">
                                    <Label Text="📋" Style="{StaticResource M3EmptyStateIconStyle}"/>
                                    <Label Text="No groups" Style="{StaticResource M3EmptyStateTitleStyle}"/>
                                    <Label Text="No groups in the local database."
                                           Style="{StaticResource M3EmptyStateSubtitleStyle}"/>
                                </VerticalStackLayout>
                            </CollectionView.EmptyView>
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="vm:OverviewGroup">
                                    <Border Style="{StaticResource M3ListItemCardStyle}"
                                            Margin="16,0,16,8">

                                        <Grid ColumnDefinitions="Auto,*,Auto,Auto"
                                              ColumnSpacing="12"
                                              RowDefinitions="Auto,Auto">

                                            <!-- Registered indicator -->
                                            <Label Grid.Row="0" Grid.RowSpan="2" Grid.Column="0"
                                                   FontSize="20"
                                                   VerticalOptions="Center"
                                                   WidthRequest="24"
                                                   HorizontalTextAlignment="Center">
                                                <Label.Triggers>
                                                    <DataTrigger TargetType="Label" Binding="{Binding IsRegistered}" Value="True">
                                                        <Setter Property="Text" Value="✓"/>
                                                        <Setter Property="TextColor"
                                                                Value="{AppThemeBinding Light={StaticResource SuccessAccent}, Dark={StaticResource SuccessAccentDim}}"/>
                                                        <Setter Property="FontAttributes" Value="Bold"/>
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="Label" Binding="{Binding IsRegistered}" Value="False">
                                                        <Setter Property="Text" Value="○"/>
                                                        <Setter Property="TextColor"
                                                                Value="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}"/>
                                                    </DataTrigger>
                                                </Label.Triggers>
                                            </Label>

                                            <!-- Group name -->
                                            <Label Grid.Row="0" Grid.Column="1"
                                                   Text="{Binding Entity.Name}"
                                                   FontSize="16"
                                                   FontAttributes="Bold"
                                                   LineBreakMode="TailTruncation"
                                                   TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource Gray100}}"/>

                                            <!-- GSR / proxy name -->
                                            <Label Grid.Row="1" Grid.Column="1"
                                                   Text="{Binding DisplayGsr}"
                                                   FontSize="13"
                                                   LineBreakMode="TailTruncation"
                                                   Style="{StaticResource SecondaryTextStyle}"/>

                                            <!-- Switch -->
                                            <Switch Grid.Row="0" Grid.Column="2"
                                                    Grid.RowSpan="2"
                                                    VerticalOptions="Center"
                                                    IsToggled="{Binding IsRegistered, Mode=TwoWay}"/>

                                            <!-- Details text button -->
                                            <Button Grid.Row="0" Grid.Column="3"
                                                    Grid.RowSpan="2"
                                                    Text="Details"
                                                    Style="{StaticResource M3TextButtonStyle}"
                                                    VerticalOptions="Center"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:RegistrationOverviewViewModel}}, Path=OpenGroupDetailsCommand}"
                                                    CommandParameter="{Binding .}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </RefreshView>

                    <!-- ─── POSITIONS TAB ─── -->
                    <RefreshView Command="{Binding LoadCommand}"
                                 IsRefreshing="{Binding IsLoading, Mode=OneWay}"
                                 IsVisible="{Binding IsPositionsTabSelected}">
                        <CollectionView ItemsSource="{Binding Positions}"
                                        SelectionMode="None">
                            <CollectionView.ItemsLayout>
                                <LinearItemsLayout Orientation="Vertical" ItemSpacing="0"/>
                            </CollectionView.ItemsLayout>
                            <CollectionView.Header>
                                <Grid HeightRequest="8"/>
                            </CollectionView.Header>
                            <CollectionView.Footer>
                                <Grid HeightRequest="16"/>
                            </CollectionView.Footer>
                            <CollectionView.EmptyView>
                                <VerticalStackLayout Padding="40,60" HorizontalOptions="Center" VerticalOptions="Center" Spacing="0">
                                    <Label Text="📋" Style="{StaticResource M3EmptyStateIconStyle}"/>
                                    <Label Text="No positions" Style="{StaticResource M3EmptyStateTitleStyle}"/>
                                    <Label Text="No positions in the local database."
                                           Style="{StaticResource M3EmptyStateSubtitleStyle}"/>
                                </VerticalStackLayout>
                            </CollectionView.EmptyView>
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="vm:OverviewPosition">
                                    <Border Style="{StaticResource M3ListItemCardStyle}"
                                            Margin="16,0,16,8">

                                        <Grid ColumnDefinitions="Auto,*,Auto,Auto"
                                              ColumnSpacing="12"
                                              RowDefinitions="Auto,Auto">

                                            <Label Grid.Row="0" Grid.RowSpan="2" Grid.Column="0"
                                                   FontSize="20"
                                                   VerticalOptions="Center"
                                                   WidthRequest="24"
                                                   HorizontalTextAlignment="Center">
                                                <Label.Triggers>
                                                    <DataTrigger TargetType="Label" Binding="{Binding IsRegistered}" Value="True">
                                                        <Setter Property="Text" Value="✓"/>
                                                        <Setter Property="TextColor"
                                                                Value="{AppThemeBinding Light={StaticResource SuccessAccent}, Dark={StaticResource SuccessAccentDim}}"/>
                                                        <Setter Property="FontAttributes" Value="Bold"/>
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="Label" Binding="{Binding IsRegistered}" Value="False">
                                                        <Setter Property="Text" Value="○"/>
                                                        <Setter Property="TextColor"
                                                                Value="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}"/>
                                                    </DataTrigger>
                                                </Label.Triggers>
                                            </Label>

                                            <Label Grid.Row="0" Grid.Column="1"
                                                   Text="{Binding Entity.ShortDescription}"
                                                   FontSize="16"
                                                   FontAttributes="Bold"
                                                   LineBreakMode="TailTruncation"
                                                   TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource Gray100}}"/>

                                            <Label Grid.Row="1" Grid.Column="1"
                                                   Text="{Binding DisplayHolder}"
                                                   FontSize="13"
                                                   LineBreakMode="TailTruncation"
                                                   Style="{StaticResource SecondaryTextStyle}"/>

                                            <Switch Grid.Row="0" Grid.Column="2"
                                                    Grid.RowSpan="2"
                                                    VerticalOptions="Center"
                                                    IsToggled="{Binding IsRegistered, Mode=TwoWay}"/>

                                            <Button Grid.Row="0" Grid.Column="3"
                                                    Grid.RowSpan="2"
                                                    Text="Details"
                                                    Style="{StaticResource M3TextButtonStyle}"
                                                    VerticalOptions="Center"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:RegistrationOverviewViewModel}}, Path=OpenPositionDetailsCommand}"
                                                    CommandParameter="{Binding .}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </RefreshView>

                </Grid>
            </Grid>
        </controls:PageScaffold.ContentBody>
    </controls:PageScaffold>

</ContentPage>
