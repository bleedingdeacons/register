<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="TheBleedingDeacons.Intergroup.Register.Views.EditPositionPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:TheBleedingDeacons.Intergroup.Register.Controls"
    xmlns:converters="clr-namespace:TheBleedingDeacons.Intergroup.Register.Converters"
    xmlns:entities="clr-namespace:TheBleedingDeacons.Unity.Intergroup.Entities;assembly=TheBleedingDeacons.Unity.Intergroup"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:viewmodels="clr-namespace:TheBleedingDeacons.Intergroup.Register.ViewModels"
    Title="{Binding Title}"
    x:DataType="viewmodels:PositionEditViewModel">

    <ContentPage.Behaviors>
        <toolkit:StatusBarBehavior StatusBarColor="{AppThemeBinding Light=White, Dark=Black}" StatusBarStyle="{AppThemeBinding Light=DarkContent, Dark=LightContent}" />
    </ContentPage.Behaviors>

    <controls:PageScaffold
        BusyMessage="Loading..."
        HasActionBar="True"
        IsBusy="{Binding IsLoading}">

        <!--  ═══ Body ═══  -->
        <controls:PageScaffold.ContentBody>
            <ScrollView>
                <VerticalStackLayout Spacing="16">

                    <!--  ═══════════════════════════════════════════════════════  -->
                    <!--  HOLDER LIST (visible when NOT editing a specific holder)  -->
                    <!--  ═══════════════════════════════════════════════════════  -->
                    <VerticalStackLayout IsVisible="{Binding IsEditing, Converter={StaticResource InvertedBoolConverter}}" Spacing="16">

                        <!--  Displayed Holders  -->
                        <!--
                            Single horizontal CollectionView holding both active
                            holders and holders staged for removal. Pending
                            removals are appended at the end of the list — the
                            DataTemplate's IsPending DataTriggers swap the card
                            into the strikethrough / Undo variant in place, so
                            the user swipes through one continuous strip rather
                            than two stacked sections.
                            
                            HorizontalOptions="Center" centres the whole card block.
                            When the combined card width exceeds the viewport the
                            CollectionView scrolls normally, with the scroll window
                            starting centred on the content.
                            
                            The Grid lets us overlay left/right chevron buttons on
                            the CollectionView's edges. The chevrons' IsVisible is
                            driven from code-behind in response to the Scrolled
                            event, so they only appear when scrolling is possible
                            in that direction.
                        -->
                        <Grid IsVisible="{Binding HasActiveHolders}">
                            <CollectionView
                                x:Name="DisplayedHoldersCollectionView"
                                HeightRequest="500"
                                HorizontalOptions="Center"
                                ItemsSource="{Binding DisplayedHolders}"
                                ItemsUpdatingScrollMode="KeepScrollOffset"
                                Scrolled="DisplayedHoldersCollectionView_Scrolled"
                                SelectionMode="None">
                                <CollectionView.ItemsLayout>
                                    <LinearItemsLayout
                                        ItemSpacing="12"
                                        Orientation="Horizontal"
                                        SnapPointsType="None" />
                                </CollectionView.ItemsLayout>
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="viewmodels:MemberCardItem">
                                        <!--
                                            Border style switches between active (M3CardStyle) and
                                            pending-removal (DeletedCardStyle) via a DataTrigger on
                                            IsPending.
                                        -->
                                        <Border
                                            MaximumWidthRequest="560"
                                            Style="{StaticResource M3CardStyle}"
                                            WidthRequest="560">
                                            <Border.Triggers>
                                                <DataTrigger
                                                    Binding="{Binding IsPending}"
                                                    TargetType="Border"
                                                    Value="True">
                                                    <Setter Property="Style" Value="{StaticResource DeletedCardStyle}" />
                                                </DataTrigger>
                                            </Border.Triggers>
                                            <!--
                                                Action buttons sit OUTSIDE PositionMemberCard, as a
                                                sibling within the Border. Putting them in the
                                                control's ActionSlot would reparent them under the
                                                card's inner stack, where BindingContext is reset
                                                to the underlying Member — breaking
                                                CommandParameter="{Binding Member}" and IsVisible
                                                triggers on IsPending. Out here, BindingContext
                                                is unambiguously the MemberCardItem wrapper.
                                            -->
                                            <VerticalStackLayout Spacing="0">
                                                <controls:PositionMemberCard
                                                    IsStruckThrough="{Binding IsPending}"
                                                    Member="{Binding Member}"
                                                    ShowRevealButton="{Binding IsPending, Converter={StaticResource InvertedBoolConverter}}" />

                                                <!--
                                                    Two button groups, mutually exclusive on
                                                    IsPending: Edit/Remove for active cards,
                                                    Undo for cards staged for removal.
                                                -->
                                                <Grid Margin="0,8,0,0">
                                                    <!--  Active card actions: Edit / Remove  -->
                                                    <Grid
                                                        ColumnDefinitions="*,*"
                                                        ColumnSpacing="12"
                                                        IsVisible="{Binding IsPending, Converter={StaticResource InvertedBoolConverter}}">
                                                        <Button
                                                            Grid.Column="0"
                                                            Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:PositionEditViewModel}}, Path=SelectMemberCommand}"
                                                            CommandParameter="{Binding Member}"
                                                            HeightRequest="44"
                                                            Style="{StaticResource M3SecondaryButtonStyle}"
                                                            Text="Edit" />
                                                        <Button
                                                            Grid.Column="1"
                                                            Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:PositionEditViewModel}}, Path=RemoveMemberCommand}"
                                                            CommandParameter="{Binding Member}"
                                                            HeightRequest="44"
                                                            Style="{StaticResource M3SecondaryButtonStyle}"
                                                            Text="Remove"
                                                            TextColor="{AppThemeBinding Light={StaticResource DangerDark},
                                                                                        Dark={StaticResource DangerLight}}" />
                                                    </Grid>

                                                    <!--  Pending-removal card actions: Undo  -->
                                                    <Button
                                                        Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:PositionEditViewModel}}, Path=UndoRemoveMemberCommand}"
                                                        CommandParameter="{Binding Member}"
                                                        HeightRequest="44"
                                                        HorizontalOptions="Center"
                                                        IsVisible="{Binding IsPending}"
                                                        Style="{StaticResource M3SecondaryButtonStyle}"
                                                        Text="Undo"
                                                        WidthRequest="160" />
                                                </Grid>
                                            </VerticalStackLayout>
                                        </Border>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>

                            <!--
                                Left / right scroll chevrons — overlaid on the
                                CollectionView's edges, visibility driven from
                                code-behind via the Scrolled handler.
                            -->
                            <Button
                                x:Name="DisplayedHoldersScrollLeftButton"
                                Margin="8,0,0,0"
                                Padding="0"
                                BackgroundColor="{AppThemeBinding Light={StaticResource Surface},
                                                                  Dark={StaticResource Gray900}}"
                                Clicked="DisplayedHoldersScrollLeftButton_Clicked"
                                CornerRadius="22"
                                FontSize="32"
                                HeightRequest="44"
                                HorizontalOptions="Start"
                                IsVisible="False"
                                Text="‹"
                                TextColor="{AppThemeBinding Light={StaticResource TextBody},
                                                            Dark={StaticResource TextBodyDim}}"
                                VerticalOptions="Center"
                                WidthRequest="44" />
                            <Button
                                x:Name="DisplayedHoldersScrollRightButton"
                                Margin="0,0,8,0"
                                Padding="0"
                                BackgroundColor="{AppThemeBinding Light={StaticResource Surface},
                                                                  Dark={StaticResource Gray900}}"
                                Clicked="DisplayedHoldersScrollRightButton_Clicked"
                                CornerRadius="22"
                                FontSize="32"
                                HeightRequest="44"
                                HorizontalOptions="End"
                                IsVisible="False"
                                Text="›"
                                TextColor="{AppThemeBinding Light={StaticResource TextBody},
                                                            Dark={StaticResource TextBodyDim}}"
                                VerticalOptions="Center"
                                WidthRequest="44" />
                        </Grid>

                        <!--
                            Add button — sits below the card list, 2/3 card width.
                            Visibility is gated on the IsAddPositionHolderEnabled
                            feature toggle; off by default since holders are
                            normally managed centrally via the Unity API.
                        -->
                        <Button
                            Command="{Binding AddNewMemberCommand}"
                            HeightRequest="44"
                            HorizontalOptions="Center"
                            IsVisible="{Binding IsAddPositionHolderEnabled}"
                            Style="{StaticResource M3SecondaryButtonStyle}"
                            Text="+ Add"
                            WidthRequest="373" />

                        <!--  Empty state card  -->
                        <Border
                            HorizontalOptions="Center"
                            IsVisible="{Binding HasActiveHolders, Converter={StaticResource InvertedBoolConverter}}"
                            MaximumWidthRequest="560"
                            Style="{StaticResource M3CardStyle}"
                            WidthRequest="560">
                            <VerticalStackLayout
                                Padding="12"
                                HorizontalOptions="Center"
                                Spacing="6">
                                <Label Style="{StaticResource M3EmptyStateTitleStyle}" Text="No Position Holders" />
                                <Label
                                    IsVisible="{Binding IsAddPositionHolderEnabled}"
                                    Style="{StaticResource M3EmptyStateSubtitleStyle}"
                                    Text="Tap '+ Add' above to create a new position holder." />
                                <Label
                                    IsVisible="{Binding IsAddPositionHolderEnabled, Converter={StaticResource InvertedBoolConverter}}"
                                    Style="{StaticResource M3EmptyStateSubtitleStyle}"
                                    Text="Holders for this position are managed centrally." />
                            </VerticalStackLayout>
                        </Border>

                    </VerticalStackLayout>

                    <!--  ═══════════════════════════════════════════════════════  -->
                    <!--  EDIT/CREATE FORM (visible when editing a specific holder)  -->
                    <!--  ═══════════════════════════════════════════════════════  -->
                    <VerticalStackLayout IsVisible="{Binding IsEditing}" Spacing="16">

                        <!--  Form card  -->
                        <Border
                            HorizontalOptions="Center"
                            MaximumWidthRequest="560"
                            Style="{StaticResource M3CardStyle}"
                            WidthRequest="560">
                            <VerticalStackLayout Spacing="6">

                                <!--  Section header  -->
                                <Label
                                    Margin="0,0,0,8"
                                    FontAttributes="Bold"
                                    FontSize="20"
                                    HorizontalOptions="Center"
                                    TextColor="{AppThemeBinding Light={StaticResource Gray900},
                                                                Dark={StaticResource Gray100}}">
                                    <Label.Triggers>
                                        <DataTrigger
                                            Binding="{Binding IsCreatingNew}"
                                            TargetType="Label"
                                            Value="True">
                                            <Setter Property="Text" Value="New Holder" />
                                        </DataTrigger>
                                        <DataTrigger
                                            Binding="{Binding IsCreatingNew}"
                                            TargetType="Label"
                                            Value="False">
                                            <Setter Property="Text" Value="Edit Holder" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>

                                <!--  Name Field  -->
                                <Label Style="{StaticResource FieldLabelStyle}" Text="Name" />
                                <controls:ClearableEntry
                                    x:Name="EditNameEntry"
                                    Margin="0,0,0,4"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource Surface},
                                                                      Dark={StaticResource Gray800}}"
                                    FontSize="18"
                                    HeightRequest="50"
                                    Placeholder="Tap to enter name..."
                                    PlaceholderColor="{AppThemeBinding Light={StaticResource Gray500},
                                                                       Dark={StaticResource Gray400}}"
                                    Text="{Binding EditName, Mode=TwoWay}"
                                    TextColor="{AppThemeBinding Light={StaticResource Gray900},
                                                                Dark={StaticResource Gray100}}" />
                                <Label
                                    Margin="0,0,0,4"
                                    FontSize="14"
                                    IsVisible="{Binding HasNameError}"
                                    Text="{Binding NameError}"
                                    TextColor="{AppThemeBinding Light={StaticResource DangerDark},
                                                                Dark={StaticResource DangerLight}}" />

                                <!--  Phone Field  -->
                                <Label Style="{StaticResource FieldLabelStyle}" Text="Mobile Phone" />
                                <controls:ClearableEntry
                                    x:Name="EditPhoneEntry"
                                    Margin="0,0,0,4"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource Surface},
                                                                      Dark={StaticResource Gray800}}"
                                    FontSize="18"
                                    HeightRequest="50"
                                    Keyboard="Telephone"
                                    Placeholder="Tap to enter phone number..."
                                    PlaceholderColor="{AppThemeBinding Light={StaticResource Gray500},
                                                                       Dark={StaticResource Gray400}}"
                                    Text="{Binding EditPhone, Mode=TwoWay}"
                                    TextColor="{AppThemeBinding Light={StaticResource Gray900},
                                                                Dark={StaticResource Gray100}}" />
                                <Label
                                    Margin="0,0,0,4"
                                    FontSize="14"
                                    IsVisible="{Binding HasPhoneError}"
                                    Text="{Binding PhoneError}"
                                    TextColor="{AppThemeBinding Light={StaticResource DangerDark},
                                                                Dark={StaticResource DangerLight}}" />

                                <!--  Email Field  -->
                                <Label Style="{StaticResource FieldLabelStyle}" Text="Personal Email" />
                                <controls:ClearableEntry
                                    x:Name="EditEmailEntry"
                                    Margin="0,0,0,4"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource Surface},
                                                                      Dark={StaticResource Gray800}}"
                                    FontSize="18"
                                    HeightRequest="50"
                                    Keyboard="Email"
                                    Placeholder="Tap to enter email address..."
                                    PlaceholderColor="{AppThemeBinding Light={StaticResource Gray500},
                                                                       Dark={StaticResource Gray400}}"
                                    Text="{Binding EditEmail, Mode=TwoWay}"
                                    TextColor="{AppThemeBinding Light={StaticResource Gray900},
                                                                Dark={StaticResource Gray100}}" />
                                <Label
                                    Margin="0,0,0,4"
                                    FontSize="14"
                                    IsVisible="{Binding HasEmailError}"
                                    Text="{Binding EmailError}"
                                    TextColor="{AppThemeBinding Light={StaticResource DangerDark},
                                                                Dark={StaticResource DangerLight}}" />

                                <!--  Rotation Date Field  -->
                                <Label Style="{StaticResource FieldLabelStyle}" Text="Rotation Date" />
                                <Label
                                    Margin="0,0,0,4"
                                    FontSize="14"
                                    IsVisible="{Binding RotationDateSelected, Converter={StaticResource InvertedBoolConverter}}"
                                    Text="Please select a rotation date"
                                    TextColor="{AppThemeBinding Light={StaticResource Gray500},
                                                                Dark={StaticResource Gray400}}" />
                                <DatePicker
                                    x:Name="EditRotationDatePicker"
                                    Margin="0,0,0,4"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource Surface},
                                                                      Dark={StaticResource Gray800}}"
                                    Date="{Binding EditRotationDate, Mode=TwoWay}"
                                    FontSize="18"
                                    Format="yyyy-MM-dd"
                                    MaximumDate="2040-12-31"
                                    MinimumDate="2020-01-01"
                                    TextColor="{AppThemeBinding Light={StaticResource Gray900},
                                                                Dark={StaticResource Gray100}}" />
                                <Label
                                    Margin="0,0,0,4"
                                    FontSize="14"
                                    IsVisible="{Binding HasRotationDateError}"
                                    Text="{Binding RotationDateError}"
                                    TextColor="{AppThemeBinding Light={StaticResource DangerDark},
                                                                Dark={StaticResource DangerLight}}" />

                            </VerticalStackLayout>
                        </Border>

                    </VerticalStackLayout>

                </VerticalStackLayout>
            </ScrollView>
        </controls:PageScaffold.ContentBody>

        <!--  ═══ Action bar: swaps between list-mode (Cancel/OK) and edit-mode (Save/Cancel) ═══  -->
        <!--
            Buttons are arranged horizontally, side by side. The pair
            together occupies half the screen width and is centred via the
            outer three-column Grid (*,2*,*). The action-bar Border itself
            (in PageScaffold) sizes to its content height, so the bar is
            just tall enough to hold one row of buttons.
        -->
        <controls:PageScaffold.ActionBarBody>
            <Grid ColumnDefinitions="*,2*,*">
                <!--  List mode (IsEditing = false): Cancel (left) / OK (right) side-by-side in the middle 50%  -->
                <Grid
                    Grid.Column="1"
                    ColumnDefinitions="*,*"
                    ColumnSpacing="12"
                    IsVisible="{Binding IsEditing, Converter={StaticResource InvertedBoolConverter}}">
                    <Button
                        Grid.Column="0"
                        Command="{Binding CancelPageCommand}"
                        HorizontalOptions="Fill"
                        Style="{StaticResource M3SecondaryButtonStyle}"
                        Text="Cancel" />
                    <Button
                        Grid.Column="1"
                        Command="{Binding DoneCommand}"
                        HorizontalOptions="Fill"
                        Style="{StaticResource M3PrimaryButtonStyle}"
                        Text="OK" />
                </Grid>

                <!--  Edit mode (IsEditing = true): Cancel (left) / Save (right) side-by-side in the middle 50%  -->
                <Grid
                    Grid.Column="1"
                    ColumnDefinitions="*,*"
                    ColumnSpacing="12"
                    IsVisible="{Binding IsEditing}">
                    <Button
                        Grid.Column="0"
                        Command="{Binding CancelEditCommand}"
                        HorizontalOptions="Fill"
                        Style="{StaticResource M3SecondaryButtonStyle}"
                        Text="Cancel" />
                    <Button
                        Grid.Column="1"
                        Command="{Binding SaveMemberCommand}"
                        HorizontalOptions="Fill"
                        Style="{StaticResource M3PrimaryButtonStyle}"
                        Text="{Binding SaveButtonText}" />
                </Grid>
            </Grid>
        </controls:PageScaffold.ActionBarBody>

    </controls:PageScaffold>

</ContentPage>
