<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="TheBleedingDeacons.Intergroup.Register.Views.MeetingSelectionPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:TheBleedingDeacons.Intergroup.Register.ViewModels"
             xmlns:models="clr-namespace:TheBleedingDeacons.Intergroup.Register.Models"
             x:DataType="vm:MeetingSelectionViewModel"
             Title="{Binding Title}">

    <Grid>
        <!-- Main content - hidden while loading -->
        <Grid RowDefinitions="Auto,Auto,*" IsVisible="{Binding IsDataLoaded}" Margin="10">

            <!-- Header with selected day -->
            <Border Grid.Row="0" 
                    BackgroundColor="{StaticResource Primary}"
                    Padding="20,15"
                    Margin="0,0,0,10">
                <StackLayout Orientation="Horizontal" 
                            HorizontalOptions="CenterAndExpand"
                            Spacing="10">
                    <Label Text="📅" 
                           FontSize="24" 
                           VerticalOptions="Center" />
                    <Label Text="{Binding Header}" 
                           FontSize="20" 
                           FontAttributes="Bold"
                           TextColor="White" 
                           VerticalOptions="Center" />
                </StackLayout>
            </Border>

            <!-- Meetings list -->
            <CollectionView Grid.Row="2"
                           ItemsSource="{Binding Meetings}"                          
                           SelectionMode="None">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="5" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Meeting">
                        <Border BackgroundColor="White"
                               StrokeShape="RoundRectangle 8"
                               Stroke="{StaticResource Gray200}"
                               StrokeThickness="1"
                               Margin="15,5">

                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:MeetingSelectionViewModel}}, Path=SelectMeetingCommand}"
                                                     CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>

                            <Grid Padding="15" 
                                  RowDefinitions="Auto,Auto,Auto,Auto" 
                                  ColumnDefinitions="*,Auto">

                                <!-- Meeting Name -->
                                <Label Grid.Row="0" Grid.Column="0"
                                       Text="{Binding Name}"
                                       FontSize="24"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource Gray900}" />

                                <Label Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                       Text="{Binding Time}"
                                       FontSize="18"                                       
                                       TextColor="{StaticResource Primary}"
                                       Margin="0,5,0,0" />

                                <StackLayout Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                           Orientation="Horizontal"
                                           Spacing="5"
                                           Margin="0,8,0,0">
                                    <Label Text="Location:"
                                           FontSize="18"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource Gray600}" />
                                    <Label Text="{Binding Location}"
                                           FontSize="18"
                                           TextColor="{StaticResource Gray700}" />
                                    <Label Text="Address:"
                                           FontSize="18"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource Gray600}" />
                                    <Label Text="{Binding Address}"
                                           FontSize="18"
                                           TextColor="{StaticResource Gray700}" />
                                </StackLayout>

                                <!-- Contact Info -->
                                <StackLayout Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"
                                           Spacing="2"
                                           Margin="0,8,0,0">

                                </StackLayout>

                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>

            <!-- Empty state -->
            <StackLayout Grid.Row="2"
                        Padding="40"
                        VerticalOptions="Center"
                        IsVisible="{Binding IsDataLoaded, Converter={StaticResource InvertedBoolConverter}}">
            </StackLayout>

        </Grid>

        <!-- Loading indicator - centered and visible while loading -->
        <StackLayout IsVisible="{Binding IsLoading}"
                     VerticalOptions="CenterAndExpand"
                     HorizontalOptions="CenterAndExpand">
            <ActivityIndicator IsRunning="{Binding IsLoading}"
                              Color="{StaticResource Primary}"
                              Scale="1.5" />
            <Label Text="Finding meetings..."
                   HorizontalOptions="Center"
                   Margin="0,20,0,0"
                   FontSize="16"
                   TextColor="{StaticResource Gray600}" />
        </StackLayout>

    </Grid>

</ContentPage>
