<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:controls="clr-namespace:TheBleedingDeacons.Intergroup.Register.Controls"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:TheBleedingDeacons.Intergroup.Register.ViewModels"
             xmlns:converters="clr-namespace:TheBleedingDeacons.Intergroup.Register.Converters"
             x:Class="TheBleedingDeacons.Intergroup.Register.Views.PositionEditPage"
             x:DataType="viewmodels:PositionEditViewModel"
             Title="{Binding Title}">
    <ContentPage.Resources>
        <converters:ObscurePhoneNumberConverter x:Key="ObscurePhoneNumber" />
    </ContentPage.Resources>
    <ScrollView>
        <Grid Padding="20"
              RowSpacing="15">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Question Label at Top -->
            <Label Grid.Row="0"
                   Text="Is this information correct?"
                   HorizontalOptions="Center"                    
                   Style="{StaticResource Question}">
                <Label.IsVisible>
                    <MultiBinding Converter="{StaticResource QuestionVisibilityConverter}">
                        <Binding Path="IsEditing" />
                        <Binding Path="HasValidationErrors" />
                    </MultiBinding>
                </Label.IsVisible>
            </Label>

            <!-- Frame with Drop Shadow containing Member fields -->
            <Frame Grid.Row="1"
                   BackgroundColor="White"
                   HasShadow="True"
                   Style="{StaticResource GsrDetails}">

                <Grid RowSpacing="15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Label Text="Position Member" 
                               Style="{StaticResource HeaderLabelStyle}"/>
                    </Grid>

                    <!-- Member Name Field -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackLayout Grid.Column="0" Orientation="Horizontal" VerticalOptions="Center">
                            <Label Text="Name:"                                   
                                   Style="{StaticResource FieldLabelStyle}" />
                            <Label Text="*"
                                   TextColor="Red"
                                   FontAttributes="Bold" />
                        </StackLayout>

                        <Label Grid.Column="1"                               
                               Text="{Binding DisplayMemberAnonymousName}"
                               VerticalOptions="Center"
                               IsVisible="{Binding IsEditing, Converter={StaticResource InvertedBoolConverter}}" 
                               Style="{StaticResource ValueLabelStyle}" />

                        <controls:ClearableEntry x:Name="EditMemberNameEntry"
                               Grid.Column="1"
                               Text="{Binding EditMemberAnonymousName}"
                               IsVisible="{Binding IsEditing}"
                               Placeholder="Tap to enter your name.."/>
                    </Grid>

                    <!-- Member Email Field -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackLayout Grid.Column="0" Orientation="Horizontal" VerticalOptions="Center">
                            <Label Text="Email:"                                   
                                   Style="{StaticResource FieldLabelStyle}" />
                            <Label Text="*"
                                   TextColor="Orange"
                                   FontAttributes="Bold"
                                   ToolTipProperties.Text="Either email or mobile required" />
                        </StackLayout>

                        <Label Grid.Column="1"
                               Text="{Binding DisplayMemberPersonalEmail}"
                               VerticalOptions="Center"
                               Style="{StaticResource ValueLabelStyle}"
                               IsVisible="{Binding IsEditing, Converter={StaticResource InvertedBoolConverter}}" />

                        <controls:ClearableEntry Grid.Column="1"
                               Text="{Binding EditMemberPersonalEmail}"
                               IsVisible="{Binding IsEditing}"
                               Keyboard="Email"                               
                               Placeholder="Tap to enter your email address.." 
                               Style="{StaticResource EntryEdit}"/>
                    </Grid>

                    <!-- Member Mobile Field -->
                    <Grid Grid.Row="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackLayout Grid.Column="0" Orientation="Horizontal" VerticalOptions="Center">
                            <Label Text="Mobile:"                                   
                                   Style="{StaticResource FieldLabelStyle}" />
                            <Label Text="*"
                                   TextColor="Orange"
                                   FontAttributes="Bold"
                                   ToolTipProperties.Text="Either email or mobile required" />
                        </StackLayout>

                        <Label Grid.Column="1"
                               Text="{Binding DisplayMemberMobile, Converter={StaticResource ObscurePhoneNumber}}"
                               VerticalOptions="Center"
                               IsVisible="{Binding IsEditing, Converter={StaticResource InvertedBoolConverter}}" 
                               Style="{StaticResource ValueLabelStyle}" />

                        <controls:ClearableEntry Grid.Column="1"
                               Text="{Binding EditMemberMobile}"
                               IsVisible="{Binding IsEditing}"
                               Keyboard="Telephone"                               
                               Placeholder="Tap to enter your mobile number.."  />
                    </Grid>
                </Grid>
            </Frame>

            <!-- Position Details Frame (Read-only) -->
            <Frame Grid.Row="2"
                   BackgroundColor="LightGray"
                   HasShadow="False"
                   Opacity="0.8">
                <Grid RowSpacing="15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0">
                        <Label Text="Position Details" Style="{StaticResource HeaderLabelStyle}"/>
                    </Grid>

                    <!-- Position Name and Email Side by Side -->
                    <Grid Grid.Row="1" ColumnSpacing="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Position Name -->
                        <Grid Grid.Column="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Label Grid.Row="0"
                                   Text="Position:"
                                   HorizontalOptions="Start"
                                   Style="{StaticResource FieldLabelStyle}" />

                            <Label Grid.Row="1"
                                   Text="{Binding Position.PositionName}"
                                   HorizontalOptions="Start"
                                   Style="{StaticResource ValueLabelStyle}" />
                        </Grid>

                        <!-- Position Email -->
                        <Grid Grid.Column="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Label Grid.Row="0"
                                   Text="Position Email:"
                                   HorizontalOptions="Start"
                                   Style="{StaticResource FieldLabelStyle}" />

                            <Label Grid.Row="1"
                                   Text="{Binding Position.PositionGenericEmail}"
                                   HorizontalOptions="Start"
                                   Style="{StaticResource ValueLabelStyle}" />
                        </Grid>
                    </Grid>
                </Grid>
            </Frame>

            <!-- Validation Message (only visible when not editing and has errors) -->
            <Label Grid.Row="3"
                   Text="{Binding ValidationMessage}"
                   FontSize="14"
                   TextColor="Red"
                   HorizontalOptions="Center"
                   Margin="0,10,0,10">
                <Label.IsVisible>
                    <MultiBinding Converter="{StaticResource ValidationVisibilityConverter}">
                        <Binding Path="IsEditing" />
                        <Binding Path="HasValidationErrors" />
                    </MultiBinding>
                </Label.IsVisible>
            </Label>

            <!-- Spacer -->
            <BoxView Grid.Row="4" />

            <!-- Button Panel -->
            <Grid Grid.Row="5"
                  ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Yes Button (when not editing) -->
                <Button Grid.Column="0"
                        Text="Yes"
                        Command="{Binding ConfirmCommand}"
                        TextColor="White"
                        IsEnabled="{Binding CanConfirm}"
                        IsVisible="{Binding IsEditing, Converter={StaticResource InvertedBoolConverter}}"
                        Style="{StaticResource PrimaryButtonStyle}" />

                <!-- Save Button (when editing) -->
                <Button Grid.Column="0"
                        Text="Save"
                        Command="{Binding SaveCommand}"
                        TextColor="White"
                        IsEnabled="{Binding CanSave}"
                        IsVisible="{Binding IsEditing}"
                        Style="{StaticResource PrimaryButtonStyle}"/>

                <!-- No Button (when not editing) -->
                <Button Grid.Column="1"
                        Text="No"
                        Command="{Binding StartEditCommand}"
                        BackgroundColor="Orange"
                        TextColor="White"
                        IsVisible="{Binding IsEditing, Converter={StaticResource InvertedBoolConverter}}"
                        Style="{StaticResource PrimaryButtonStyle}"/>

                <!-- Cancel Button (when editing) -->
                <Button Grid.Column="1"
                        Text="Cancel"
                        Command="{Binding CancelCommand}"
                        BackgroundColor="Orange"
                        TextColor="White"
                        IsVisible="{Binding IsEditing}"
                        Style="{StaticResource PrimaryButtonStyle}"/>
            </Grid>
        </Grid>
    </ScrollView>
</ContentPage>