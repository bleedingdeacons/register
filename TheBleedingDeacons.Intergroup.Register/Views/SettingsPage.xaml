<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:vm="clr-namespace:TheBleedingDeacons.Intergroup.Register.ViewModels"
             x:Class="TheBleedingDeacons.Intergroup.Register.Views.SettingsPage"
             x:DataType="vm:SettingsViewModel"
             Title="Settings">

    <ScrollView>
        <StackLayout Orientation="Vertical"
                     Spacing="20"
                     Margin="20"
                     VerticalOptions="Start">

            <Label Text="Settings"
                   FontSize="32"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   Margin="0,0,0,30"/>

            <Button x:Name="ImportExportButton"
                    Text="Import/Export"
                    FontSize="18"
                    BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                    TextColor="White"
                    CornerRadius="8"
                    HeightRequest="60"
                    Command="{Binding NavigateToImportExportCommand}"/>

            <Button x:Name="MailSettingButton"
                    Text="Mail Settings"
                    FontSize="18"
                    BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                    TextColor="White"
                    CornerRadius="8"
                    HeightRequest="60"
                    Command="{Binding NavigateToMailSettingCommand}"/>

            <Button x:Name="UnitySettingButton"
                    Text="Unity API Settings"
                    FontSize="18"
                    BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                    TextColor="White"
                    CornerRadius="8"
                    HeightRequest="60"
                    Command="{Binding NavigateToUnitySettingCommand}"/>

            <Button x:Name="BackupButton"
                    Text="Database Backup"
                    FontSize="18"
                    BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                    TextColor="White"
                    CornerRadius="8"
                    HeightRequest="60"
                    Command="{Binding NavigateToBackupCommand}"/>

            <Button x:Name="EmailStatusButton"
                    Text="Email Status"
                    FontSize="18"
                    BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                    TextColor="White"
                    CornerRadius="8"
                    HeightRequest="60"
                    Command="{Binding NavigateToMailStatusCommand}"/>

            <!-- Purge Database -->
            <BoxView HeightRequest="1"
                     Color="{AppThemeBinding Light=#E0E0E0, Dark=#424242}"
                     Margin="0,10,0,0"/>

            <Label Text="Danger Zone"
                   FontSize="14"
                   FontAttributes="Bold"
                   TextColor="{AppThemeBinding Light=#D32F2F, Dark=#EF5350}"
                   HorizontalOptions="Start"
                   Margin="0,0,0,0"/>

            <Button x:Name="PurgeDatabaseButton"
                    Text="Purge Database"
                    FontSize="18"
                    BackgroundColor="{AppThemeBinding Light=#D32F2F, Dark=#C62828}"
                    TextColor="White"
                    CornerRadius="8"
                    HeightRequest="60"
                    IsEnabled="{Binding IsPurging, Converter={toolkit:InvertedBoolConverter}}"
                    Command="{Binding PurgeDatabaseCommand}"/>

            <Label Text="{Binding PurgeStatusMessage}"
                   FontSize="14"
                   IsVisible="{Binding IsPurgeStatusVisible}"
                   HorizontalOptions="Center">
                <Label.Triggers>
                    <DataTrigger TargetType="Label"
                                 Binding="{Binding IsPurgeStatusError}"
                                 Value="True">
                        <Setter Property="TextColor"
                                Value="{AppThemeBinding Light=#D32F2F, Dark=#EF5350}"/>
                    </DataTrigger>
                    <DataTrigger TargetType="Label"
                                 Binding="{Binding IsPurgeStatusError}"
                                 Value="False">
                        <Setter Property="TextColor"
                                Value="{AppThemeBinding Light=#388E3C, Dark=#66BB6A}"/>
                    </DataTrigger>
                </Label.Triggers>
            </Label>

        </StackLayout>
    </ScrollView>

</ContentPage>
