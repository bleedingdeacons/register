<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:vm="clr-namespace:TheBleedingDeacons.Intergroup.Register.ViewModels"
             x:Class="TheBleedingDeacons.Intergroup.Register.Views.SettingsPage"
             x:DataType="vm:SettingsViewModel"
             Title="Settings">

    <ContentPage.Resources>
        <toolkit:BoolToObjectConverter x:Key="BoolToSyncColorConverter" TrueObject="Red" FalseObject="Green" />
        <toolkit:BoolToObjectConverter x:Key="BoolToSyncButtonTextConverter" TrueObject="Syncing..." FalseObject="Sync from Unity" />
    </ContentPage.Resources>

    <ScrollView>
        <StackLayout Orientation="Vertical" 
                     Spacing="20" 
                     Margin="20"
                     VerticalOptions="Start">

            <Label Text="Settings" 
                   FontSize="32" 
                   FontAttributes="Bold" 
                   HorizontalOptions="Center" 
                   Margin="0,0,0,30"/>

            <!-- Sync from Unity -->
            <Frame BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#2D2D30}"
                   Padding="15"
                   CornerRadius="8">
                <StackLayout Spacing="10">
                    <Label Text="Unity Sync"
                           FontSize="18"
                           FontAttributes="Bold"/>
                    <Label Text="Replace all local data with the latest from Unity."
                           FontSize="14"
                           TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}"/>

                    <Button Text="{Binding IsSyncing, Converter={StaticResource BoolToSyncButtonTextConverter}}"
                            FontSize="18"
                            BackgroundColor="{AppThemeBinding Light=#FF6F00, Dark=#FFA726}"
                            TextColor="White"
                            CornerRadius="8"
                            HeightRequest="60"
                            Command="{Binding SyncFromUnityCommand}"
                            IsEnabled="{Binding IsSyncing, Converter={toolkit:InvertedBoolConverter}}"/>

                    <!-- Sync Status -->
                    <Frame IsVisible="{Binding IsSyncStatusVisible}"
                           BackgroundColor="{Binding IsSyncStatusError, Converter={StaticResource BoolToSyncColorConverter}}"
                           BorderColor="Transparent"
                           Padding="10"
                           CornerRadius="5">
                        <Label Text="{Binding SyncStatusMessage}"
                               TextColor="White"
                               FontAttributes="Bold"/>
                    </Frame>
                </StackLayout>
            </Frame>

            <Button x:Name="ImportExportButton"
                    Text="Import/Export"
                    FontSize="18"
                    BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                    TextColor="White"
                    CornerRadius="8"
                    HeightRequest="60"
                    Command="{Binding NavigateToImportExportCommand}"/>

            <Button x:Name="MailSettingButton"
                    Text="Mail Settings"
                    FontSize="18"
                    BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                    TextColor="White"
                    CornerRadius="8"
                    HeightRequest="60"
                    Command="{Binding NavigateToMailSettingCommand}"/>

            <Button x:Name="UnitySettingButton"
                    Text="Unity API Settings"
                    FontSize="18"
                    BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                    TextColor="White"
                    CornerRadius="8"
                    HeightRequest="60"
                    Command="{Binding NavigateToUnitySettingCommand}"/>

            <Button x:Name="BackupButton"
                    Text="Database Backup"
                    FontSize="18"
                    BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                    TextColor="White"
                    CornerRadius="8"
                    HeightRequest="60"
                    Command="{Binding NavigateToBackupCommand}"/>

            <Button x:Name="EmailStatusButton"
                    Text="Email Status"
                    FontSize="18"
                    BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                    TextColor="White"
                    CornerRadius="8"
                    HeightRequest="60"
                    Command="{Binding NavigateToMailStatusCommand}"/>

        </StackLayout>
    </ScrollView>

</ContentPage>