<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="TheBleedingDeacons.Intergroup.Register.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:vm="clr-namespace:TheBleedingDeacons.Intergroup.Register.ViewModels"
    Title="Settings"
    x:DataType="vm:SettingsViewModel">

    <ScrollView>
        <StackLayout
            Margin="20"
            Orientation="Vertical"
            Spacing="20"
            VerticalOptions="Start">

            <Label
                Margin="0,0,0,30"
                FontAttributes="Bold"
                FontSize="32"
                HorizontalOptions="Center"
                Text="Settings" />

            <Grid ColumnDefinitions="*,*" ColumnSpacing="20">
                <Button
                    x:Name="MailSettingButton"
                    Grid.Column="0"
                    BackgroundColor="{AppThemeBinding Light={StaticResource Primary},
                                                      Dark={StaticResource PrimaryDark}}"
                    Command="{Binding NavigateToMailSettingCommand}"
                    CornerRadius="8"
                    FontSize="18"
                    HeightRequest="60"
                    Text="Mail Settings"
                    TextColor="White" />

                <Button
                    x:Name="EmailStatusButton"
                    Grid.Column="1"
                    BackgroundColor="{AppThemeBinding Light={StaticResource Primary},
                                                      Dark={StaticResource PrimaryDark}}"
                    Command="{Binding NavigateToMailStatusCommand}"
                    CornerRadius="8"
                    FontSize="18"
                    HeightRequest="60"
                    Text="Email Status"
                    TextColor="White" />
            </Grid>

            <Button
                x:Name="ApiSettingsButton"
                BackgroundColor="{AppThemeBinding Light={StaticResource Primary},
                                                  Dark={StaticResource PrimaryDark}}"
                Command="{Binding NavigateToApiSettingsCommand}"
                CornerRadius="8"
                FontSize="18"
                HeightRequest="60"
                Text="API Settings"
                TextColor="White" />

            <Button
                x:Name="BackupButton"
                BackgroundColor="{AppThemeBinding Light={StaticResource Primary},
                                                  Dark={StaticResource PrimaryDark}}"
                Command="{Binding NavigateToBackupCommand}"
                CornerRadius="8"
                FontSize="18"
                HeightRequest="60"
                Text="Database Backup"
                TextColor="White" />

            <!--
                ═══════════════════════════════════════════════════════
                Durability
                ═══════════════════════════════════════════════════════
            -->
            <BoxView
                Margin="0,10,0,0"
                HeightRequest="1"
                Color="{AppThemeBinding Light=#E0E0E0,
                                        Dark=#424242}" />

            <Label
                FontAttributes="Bold"
                FontSize="14"
                HorizontalOptions="Start"
                Text="Durability"
                TextColor="{AppThemeBinding Light={StaticResource Gray600},
                                            Dark={StaticResource Gray300}}" />

            <Border
                Padding="15,12"
                BackgroundColor="{AppThemeBinding Light=White,
                                                  Dark=#2D2D30}"
                Stroke="{AppThemeBinding Light=#E0E0E0,
                                         Dark=#424242}"
                StrokeShape="RoundRectangle 10"
                StrokeThickness="1">
                <Grid
                    ColumnDefinitions="*,Auto"
                    ColumnSpacing="12"
                    RowDefinitions="Auto,Auto"
                    RowSpacing="4">

                    <Label
                        Grid.Row="0"
                        Grid.Column="0"
                        FontAttributes="Bold"
                        FontSize="16"
                        Text="Registration Event Log"
                        VerticalOptions="Center" />

                    <Switch
                        Grid.Row="0"
                        Grid.RowSpan="2"
                        Grid.Column="1"
                        IsToggled="{Binding IsRegistrationEventLogEnabled, Mode=TwoWay}"
                        VerticalOptions="Center" />

                    <Label
                        Grid.Row="1"
                        Grid.Column="0"
                        FontSize="13"
                        LineBreakMode="WordWrap"
                        Text="Records each registration to a crash-durable log so nothing is lost if the app is killed mid-meeting. Recommended on."
                        TextColor="{AppThemeBinding Light={StaticResource Gray600},
                                                    Dark={StaticResource Gray300}}" />
                </Grid>
            </Border>

            <!--
                ═══════════════════════════════════════════════════════
                Feature Toggles
                ═══════════════════════════════════════════════════════
            -->
            <BoxView
                Margin="0,10,0,0"
                HeightRequest="1"
                Color="{AppThemeBinding Light=#E0E0E0,
                                        Dark=#424242}" />

            <Label
                FontAttributes="Bold"
                FontSize="14"
                HorizontalOptions="Start"
                Text="Feature Toggles"
                TextColor="{AppThemeBinding Light={StaticResource Gray600},
                                            Dark={StaticResource Gray300}}" />

            <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="12">

                <Border
                    Grid.Column="0"
                    Padding="15,12"
                    BackgroundColor="{AppThemeBinding Light=White,
                                                      Dark=#2D2D30}"
                    Stroke="{AppThemeBinding Light=#E0E0E0,
                                             Dark=#424242}"
                    StrokeShape="RoundRectangle 10"
                    StrokeThickness="1">
                    <Grid
                        ColumnDefinitions="*,Auto"
                        ColumnSpacing="12"
                        RowDefinitions="Auto,Auto"
                        RowSpacing="4">

                        <Label
                            Grid.Row="0"
                            Grid.Column="0"
                            FontAttributes="Bold"
                            FontSize="16"
                            Text="Auto-register Officers"
                            VerticalOptions="Center" />

                        <Switch
                            Grid.Row="0"
                            Grid.Column="1"
                            IsToggled="{Binding IsAutoRegisterPositionsOnGroupEnabled, Mode=TwoWay}"
                            VerticalOptions="Center" />

                        <Label
                            Grid.Row="1"
                            Grid.Column="0"
                            Grid.ColumnSpan="2"
                            FontSize="13"
                            LineBreakMode="WordWrap"
                            Text="When a group is registered, also register any intergroup position held by a member of that group. Saves tapping twice when an officer is also their group's GSR."
                            TextColor="{AppThemeBinding Light={StaticResource Gray600},
                                                        Dark={StaticResource Gray300}}" />
                    </Grid>
                </Border>

                <Border
                    Grid.Column="1"
                    Padding="15,12"
                    BackgroundColor="{AppThemeBinding Light=White,
                                                      Dark=#2D2D30}"
                    Stroke="{AppThemeBinding Light=#E0E0E0,
                                             Dark=#424242}"
                    StrokeShape="RoundRectangle 10"
                    StrokeThickness="1">
                    <Grid
                        ColumnDefinitions="*,Auto"
                        ColumnSpacing="12"
                        RowDefinitions="Auto,Auto"
                        RowSpacing="4">

                        <Label
                            Grid.Row="0"
                            Grid.Column="0"
                            FontAttributes="Bold"
                            FontSize="16"
                            Text="Single-GSR Shortcut"
                            VerticalOptions="Center" />

                        <Switch
                            Grid.Row="0"
                            Grid.Column="1"
                            IsToggled="{Binding IsSingleGsrShortcutEnabled, Mode=TwoWay}"
                            VerticalOptions="Center" />

                        <Label
                            Grid.Row="1"
                            Grid.Column="0"
                            Grid.ColumnSpan="2"
                            FontSize="13"
                            LineBreakMode="WordWrap"
                            Text="When a group has only one Group Service Representative, tapping No skips the picker and opens that record's edit form directly. Tapping Finished returns straight to registration without an extra Yes tap."
                            TextColor="{AppThemeBinding Light={StaticResource Gray600},
                                                        Dark={StaticResource Gray300}}" />
                    </Grid>
                </Border>

                <Border
                    Grid.Column="2"
                    Padding="15,12"
                    BackgroundColor="{AppThemeBinding Light=White,
                                                      Dark=#2D2D30}"
                    Stroke="{AppThemeBinding Light=#E0E0E0,
                                             Dark=#424242}"
                    StrokeShape="RoundRectangle 10"
                    StrokeThickness="1">
                    <Grid
                        ColumnDefinitions="*,Auto"
                        ColumnSpacing="12"
                        RowDefinitions="Auto,Auto"
                        RowSpacing="4">

                        <Label
                            Grid.Row="0"
                            Grid.Column="0"
                            FontAttributes="Bold"
                            FontSize="16"
                            Text="Welcome Email on Registration"
                            VerticalOptions="Center" />

                        <Switch
                            Grid.Row="0"
                            Grid.Column="1"
                            IsToggled="{Binding IsWelcomeEmailOnRegistrationEnabled, Mode=TwoWay}"
                            VerticalOptions="Center" />

                        <Label
                            Grid.Row="1"
                            Grid.Column="0"
                            Grid.ColumnSpan="2"
                            FontSize="13"
                            LineBreakMode="WordWrap"
                            Text="When on, each successful registration queues a confirmation email to every affected member who has a personal email on file, including a copy of the privacy statement they accepted. Off by default — turn on only after SMTP is configured and tested."
                            TextColor="{AppThemeBinding Light={StaticResource Gray600},
                                                        Dark={StaticResource Gray300}}" />
                    </Grid>
                </Border>

                <Border
                    Grid.Column="3"
                    Padding="15,12"
                    BackgroundColor="{AppThemeBinding Light=White,
                                                      Dark=#2D2D30}"
                    Stroke="{AppThemeBinding Light=#E0E0E0,
                                             Dark=#424242}"
                    StrokeShape="RoundRectangle 10"
                    StrokeThickness="1">
                    <Grid
                        ColumnDefinitions="*,Auto"
                        ColumnSpacing="12"
                        RowDefinitions="Auto,Auto"
                        RowSpacing="4">

                        <Label
                            Grid.Row="0"
                            Grid.Column="0"
                            FontAttributes="Bold"
                            FontSize="16"
                            Text="Add Position Holder Button"
                            VerticalOptions="Center" />

                        <Switch
                            Grid.Row="0"
                            Grid.Column="1"
                            IsToggled="{Binding IsAddPositionHolderEnabled, Mode=TwoWay}"
                            VerticalOptions="Center" />

                        <Label
                            Grid.Row="1"
                            Grid.Column="0"
                            Grid.ColumnSpan="2"
                            FontSize="13"
                            LineBreakMode="WordWrap"
                            Text="When on, the Edit Position page shows an + Add button for creating new holders directly on the device. Off by default — holders are normally managed centrally via the Unity API."
                            TextColor="{AppThemeBinding Light={StaticResource Gray600},
                                                        Dark={StaticResource Gray300}}" />
                    </Grid>
                </Border>
            </Grid>

            <!--
                ═══════════════════════════════════════════════════════
                Logging
                ═══════════════════════════════════════════════════════
            -->
            <BoxView
                Margin="0,10,0,0"
                HeightRequest="1"
                Color="{AppThemeBinding Light=#E0E0E0,
                                        Dark=#424242}" />

            <Label
                FontAttributes="Bold"
                FontSize="14"
                HorizontalOptions="Start"
                Text="Logging"
                TextColor="{AppThemeBinding Light={StaticResource Gray600},
                                            Dark={StaticResource Gray300}}" />

            <Border
                Padding="15,12"
                BackgroundColor="{AppThemeBinding Light=White,
                                                  Dark=#2D2D30}"
                Stroke="{AppThemeBinding Light=#E0E0E0,
                                         Dark=#424242}"
                StrokeShape="RoundRectangle 10"
                StrokeThickness="1">
                <StackLayout Spacing="8">

                    <Label
                        FontAttributes="Bold"
                        FontSize="16"
                        Text="Device Label" />

                    <Label
                        FontSize="13"
                        LineBreakMode="WordWrap"
                        Text="A short name that identifies this device in the live log view. Set a different label on each tablet (e.g. 'Front Desk', 'Tablet A — Android 15') so you can tell them apart when troubleshooting. Leave blank to use the auto-detected default."
                        TextColor="{AppThemeBinding Light={StaticResource Gray600},
                                                    Dark={StaticResource Gray300}}" />

                    <Entry
                        ClearButtonVisibility="WhileEditing"
                        Placeholder="{Binding DeviceLabelPlaceholder}"
                        Text="{Binding DeviceLabel, Mode=TwoWay}" />

                    <Button
                        BackgroundColor="{AppThemeBinding Light={StaticResource Primary},
                                                          Dark={StaticResource PrimaryDark}}"
                        Command="{Binding SaveDeviceLabelCommand}"
                        CornerRadius="8"
                        FontSize="16"
                        HeightRequest="44"
                        HorizontalOptions="End"
                        Text="Save Label"
                        TextColor="White"
                        WidthRequest="160" />

                    <Label
                        FontSize="13"
                        IsVisible="{Binding IsDeviceLabelStatusVisible}"
                        Text="{Binding DeviceLabelStatusMessage}"
                        TextColor="{AppThemeBinding Light=#388E3C,
                                                    Dark=#66BB6A}" />
                </StackLayout>
            </Border>

            <!--
                ═══════════════════════════════════════════════════════
                Privacy Policy
                ═══════════════════════════════════════════════════════
                Displays the on-device cached active policy populated
                by the sync stage. Reads from Preferences synchronously
                so the page is useful offline. The Refresh button does
                a live Scrutiny fetch + cache update — same code path
                the sync stage runs — so an operator can manually pull
                the latest active policy without running a full data
                sync.
            -->
            <BoxView
                Margin="0,10,0,0"
                HeightRequest="1"
                Color="{AppThemeBinding Light=#E0E0E0,
                                        Dark=#424242}" />

            <Label
                FontAttributes="Bold"
                FontSize="14"
                HorizontalOptions="Start"
                Text="Privacy Policy"
                TextColor="{AppThemeBinding Light={StaticResource Gray600},
                                            Dark={StaticResource Gray300}}" />

            <Border
                Padding="15,12"
                BackgroundColor="{AppThemeBinding Light=White,
                                                  Dark=#2D2D30}"
                Stroke="{AppThemeBinding Light=#E0E0E0,
                                         Dark=#424242}"
                StrokeShape="RoundRectangle 10"
                StrokeThickness="1">
                <StackLayout Spacing="8">

                    <Label
                        FontAttributes="Bold"
                        FontSize="16"
                        Text="Active Privacy Policy" />

                    <Label
                        FontSize="13"
                        LineBreakMode="WordWrap"
                        Text="The active policy cached on this device, populated by the sync stage. Compliance acceptance flows record the version shown here against each member who agrees. Tap Refresh to pull the latest active policy from Scrutiny."
                        TextColor="{AppThemeBinding Light={StaticResource Gray600},
                                                    Dark={StaticResource Gray300}}" />

                    <!--
                        Details block. Hidden until the cache contains
                        a policy so the placeholder layout never flashes
                        a row of empty fields on first paint.
                    -->
                    <Grid
                        ColumnDefinitions="Auto,*"
                        ColumnSpacing="12"
                        IsVisible="{Binding HasActivePrivacyPolicy}"
                        RowDefinitions="Auto,Auto,Auto,Auto"
                        RowSpacing="4">

                        <Label
                            Grid.Row="0"
                            Grid.Column="0"
                            FontSize="13"
                            Text="Title"
                            TextColor="{AppThemeBinding Light={StaticResource Gray600},
                                                        Dark={StaticResource Gray300}}"
                            VerticalOptions="Center" />
                        <Label
                            Grid.Row="0"
                            Grid.Column="1"
                            FontAttributes="Bold"
                            FontSize="14"
                            LineBreakMode="WordWrap"
                            Text="{Binding PrivacyPolicyTitle}" />

                        <Label
                            Grid.Row="1"
                            Grid.Column="0"
                            FontSize="13"
                            Text="Version"
                            TextColor="{AppThemeBinding Light={StaticResource Gray600},
                                                        Dark={StaticResource Gray300}}"
                            VerticalOptions="Center" />
                        <Label
                            Grid.Row="1"
                            Grid.Column="1"
                            FontAttributes="Bold"
                            FontSize="14"
                            Text="{Binding PrivacyPolicyVersion}" />

                        <Label
                            Grid.Row="2"
                            Grid.Column="0"
                            FontSize="13"
                            Text="Modified"
                            TextColor="{AppThemeBinding Light={StaticResource Gray600},
                                                        Dark={StaticResource Gray300}}"
                            VerticalOptions="Center" />
                        <Label
                            Grid.Row="2"
                            Grid.Column="1"
                            FontSize="14"
                            Text="{Binding PrivacyPolicyModified}" />

                        <Label
                            Grid.Row="3"
                            Grid.Column="0"
                            FontSize="13"
                            Text="Cached"
                            TextColor="{AppThemeBinding Light={StaticResource Gray600},
                                                        Dark={StaticResource Gray300}}"
                            VerticalOptions="Center" />
                        <Label
                            Grid.Row="3"
                            Grid.Column="1"
                            FontSize="14"
                            Text="{Binding PrivacyPolicyCachedAt}" />
                    </Grid>

                    <!--
                        Refresh + activity row. ActivityIndicator runs
                        only while the live Scrutiny call is in flight;
                        the button disables itself during the same
                        window so the operator can't queue overlapping
                        requests.
                    -->
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">

                        <ActivityIndicator
                            Grid.Column="0"
                            IsRunning="{Binding IsPrivacyPolicyLoading}"
                            IsVisible="{Binding IsPrivacyPolicyLoading}"
                            VerticalOptions="Center"
                            WidthRequest="20" />

                        <Button
                            Grid.Column="2"
                            BackgroundColor="{AppThemeBinding Light={StaticResource Primary},
                                                              Dark={StaticResource PrimaryDark}}"
                            Command="{Binding RefreshFromScrutinyCommand}"
                            CornerRadius="8"
                            FontSize="16"
                            HeightRequest="44"
                            HorizontalOptions="End"
                            IsEnabled="{Binding IsPrivacyPolicyLoading, Converter={toolkit:InvertedBoolConverter}}"
                            Text="Refresh"
                            TextColor="White"
                            WidthRequest="160" />
                    </Grid>

                    <!--
                        Status row. Reuses the green-on-success / red-on-
                        error pattern used elsewhere on this page (cf.
                        the Reset Device status label) via DataTriggers
                        on IsPrivacyPolicyStatusError.
                    -->
                    <Label
                        FontSize="13"
                        IsVisible="{Binding IsPrivacyPolicyStatusVisible}"
                        Text="{Binding PrivacyPolicyStatusMessage}">
                        <Label.Triggers>
                            <DataTrigger
                                Binding="{Binding IsPrivacyPolicyStatusError}"
                                TargetType="Label"
                                Value="True">
                                <Setter Property="TextColor" Value="{AppThemeBinding Light=#D32F2F, Dark=#EF5350}" />
                            </DataTrigger>
                            <DataTrigger
                                Binding="{Binding IsPrivacyPolicyStatusError}"
                                TargetType="Label"
                                Value="False">
                                <Setter Property="TextColor" Value="{AppThemeBinding Light=#388E3C, Dark=#66BB6A}" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>

                    <!--
                        Compliance email. Lives inside the Privacy Policy
                        card because it's the recipient address used by
                        the compliance service for audit-trail copies of
                        acceptance / revocation events tied to the policy
                        shown above. Empty value = no recipient configured;
                        the send is silently skipped. The Save button
                        validates with EmailAddressAttribute before
                        persisting — a validation failure surfaces in the
                        status label below in red and leaves the stored
                        value untouched.
                    -->
                    <BoxView
                        Margin="0,8,0,0"
                        HeightRequest="1"
                        Color="{AppThemeBinding Light=#E0E0E0,
                                                Dark=#424242}" />

                    <Label
                        FontAttributes="Bold"
                        FontSize="16"
                        Text="Compliance Email" />

                    <Label
                        FontSize="13"
                        LineBreakMode="WordWrap"
                        Text="The address the compliance service uses as the recipient for audit-trail copies of acceptance and revocation events. Leave blank to disable — sends with no recipient configured are silently skipped."
                        TextColor="{AppThemeBinding Light={StaticResource Gray600},
                                                    Dark={StaticResource Gray300}}" />

                    <Entry
                        ClearButtonVisibility="WhileEditing"
                        Keyboard="Email"
                        Placeholder="compliance@example.org"
                        Text="{Binding ComplianceEmail, Mode=TwoWay}" />

                    <Button
                        BackgroundColor="{AppThemeBinding Light={StaticResource Primary},
                                                          Dark={StaticResource PrimaryDark}}"
                        Command="{Binding SaveComplianceEmailCommand}"
                        CornerRadius="8"
                        FontSize="16"
                        HeightRequest="44"
                        HorizontalOptions="End"
                        Text="Save Email"
                        TextColor="White"
                        WidthRequest="160" />

                    <Label
                        FontSize="13"
                        IsVisible="{Binding IsComplianceEmailStatusVisible}"
                        Text="{Binding ComplianceEmailStatusMessage}">
                        <Label.Triggers>
                            <DataTrigger
                                Binding="{Binding IsComplianceEmailStatusError}"
                                TargetType="Label"
                                Value="True">
                                <Setter Property="TextColor" Value="{AppThemeBinding Light=#D32F2F, Dark=#EF5350}" />
                            </DataTrigger>
                            <DataTrigger
                                Binding="{Binding IsComplianceEmailStatusError}"
                                TargetType="Label"
                                Value="False">
                                <Setter Property="TextColor" Value="{AppThemeBinding Light=#388E3C, Dark=#66BB6A}" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                </StackLayout>
            </Border>

            <!--
                ═══════════════════════════════════════════════════════
                Reset Device
                ═══════════════════════════════════════════════════════
            -->
            <BoxView
                Margin="0,10,0,0"
                HeightRequest="1"
                Color="{AppThemeBinding Light=#E0E0E0,
                                        Dark=#424242}" />

            <Label
                Margin="0,0,0,0"
                FontAttributes="Bold"
                FontSize="14"
                HorizontalOptions="Start"
                Text="Danger Zone"
                TextColor="{AppThemeBinding Light=#D32F2F,
                                            Dark=#EF5350}" />

            <Label
                FontSize="14"
                HorizontalOptions="Center"
                IsVisible="{Binding IsPurgeStatusVisible}"
                Text="{Binding PurgeStatusMessage}">
                <Label.Triggers>
                    <DataTrigger
                        Binding="{Binding IsPurgeStatusError}"
                        TargetType="Label"
                        Value="True">
                        <Setter Property="TextColor" Value="{AppThemeBinding Light=#D32F2F, Dark=#EF5350}" />
                    </DataTrigger>
                    <DataTrigger
                        Binding="{Binding IsPurgeStatusError}"
                        TargetType="Label"
                        Value="False">
                        <Setter Property="TextColor" Value="{AppThemeBinding Light=#388E3C, Dark=#66BB6A}" />
                    </DataTrigger>
                </Label.Triggers>
            </Label>

            <Button
                x:Name="PurgeDatabaseButton"
                BackgroundColor="{AppThemeBinding Light=#D32F2F,
                                                  Dark=#C62828}"
                Command="{Binding PurgeDatabaseCommand}"
                CornerRadius="8"
                FontSize="18"
                HeightRequest="60"
                IsEnabled="{Binding IsPurging, Converter={toolkit:InvertedBoolConverter}}"
                Text="Reset Device"
                TextColor="White" />

        </StackLayout>
    </ScrollView>

</ContentPage>
