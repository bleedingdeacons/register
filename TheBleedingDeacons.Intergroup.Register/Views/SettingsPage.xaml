<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:vm="clr-namespace:TheBleedingDeacons.Intergroup.Register.ViewModels"
             x:Class="TheBleedingDeacons.Intergroup.Register.Views.SettingsPage"
             x:DataType="vm:SettingsViewModel"
             Title="Settings">

    <ScrollView>
        <StackLayout Orientation="Vertical"
                     Spacing="20"
                     Margin="20"
                     VerticalOptions="Start">

            <Label Text="Settings"
                   FontSize="32"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   Margin="0,0,0,30"/>

            <Button x:Name="MailSettingButton"
                    Text="Mail Settings"
                    FontSize="18"
                    BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                    TextColor="White"
                    CornerRadius="8"
                    HeightRequest="60"
                    Command="{Binding NavigateToMailSettingCommand}"/>

            <Button x:Name="UnitySettingButton"
                    Text="Unity API Settings"
                    FontSize="18"
                    BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                    TextColor="White"
                    CornerRadius="8"
                    HeightRequest="60"
                    Command="{Binding NavigateToUnitySettingCommand}"/>

            <Button x:Name="BetterStackSettingButton"
                    Text="Better Stack Settings"
                    FontSize="18"
                    BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                    TextColor="White"
                    CornerRadius="8"
                    HeightRequest="60"
                    Command="{Binding NavigateToBetterStackSettingCommand}"/>

            <Button x:Name="BackupButton"
                    Text="Database Backup"
                    FontSize="18"
                    BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                    TextColor="White"
                    CornerRadius="8"
                    HeightRequest="60"
                    Command="{Binding NavigateToBackupCommand}"/>

            <Button x:Name="EmailStatusButton"
                    Text="Email Status"
                    FontSize="18"
                    BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                    TextColor="White"
                    CornerRadius="8"
                    HeightRequest="60"
                    Command="{Binding NavigateToMailStatusCommand}"/>

            <!-- ═══════════════════════════════════════════════════════
                 Durability
                 ═══════════════════════════════════════════════════════ -->
            <BoxView HeightRequest="1"
                     Color="{AppThemeBinding Light=#E0E0E0, Dark=#424242}"
                     Margin="0,10,0,0"/>

            <Label Text="Durability"
                   FontSize="14"
                   FontAttributes="Bold"
                   TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}"
                   HorizontalOptions="Start"/>

            <Border StrokeShape="RoundRectangle 10"
                    StrokeThickness="1"
                    Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#424242}"
                    BackgroundColor="{AppThemeBinding Light=White, Dark=#2D2D30}"
                    Padding="15,12">
                <Grid ColumnDefinitions="*,Auto"
                      RowDefinitions="Auto,Auto"
                      ColumnSpacing="12"
                      RowSpacing="4">

                    <Label Grid.Row="0" Grid.Column="0"
                           Text="Registration Event Log"
                           FontSize="16"
                           FontAttributes="Bold"
                           VerticalOptions="Center"/>

                    <Switch Grid.Row="0" Grid.Column="1"
                            Grid.RowSpan="2"
                            VerticalOptions="Center"
                            IsToggled="{Binding IsRegistrationEventLogEnabled, Mode=TwoWay}"/>

                    <Label Grid.Row="1" Grid.Column="0"
                           Text="Records each registration to a crash-durable log so nothing is lost if the app is killed mid-meeting. Recommended on."
                           FontSize="13"
                           TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}"
                           LineBreakMode="WordWrap"/>
                </Grid>
            </Border>

            <!-- ═══════════════════════════════════════════════════════
                 Reset Device
                 ═══════════════════════════════════════════════════════ -->
            <BoxView HeightRequest="1"
                     Color="{AppThemeBinding Light=#E0E0E0, Dark=#424242}"
                     Margin="0,10,0,0"/>

            <Label Text="Danger Zone"
                   FontSize="14"
                   FontAttributes="Bold"
                   TextColor="{AppThemeBinding Light=#D32F2F, Dark=#EF5350}"
                   HorizontalOptions="Start"
                   Margin="0,0,0,0"/>

            <Label Text="{Binding PurgeStatusMessage}"
                   FontSize="14"
                   IsVisible="{Binding IsPurgeStatusVisible}"
                   HorizontalOptions="Center">
                <Label.Triggers>
                    <DataTrigger TargetType="Label"
                                 Binding="{Binding IsPurgeStatusError}"
                                 Value="True">
                        <Setter Property="TextColor"
                                Value="{AppThemeBinding Light=#D32F2F, Dark=#EF5350}"/>
                    </DataTrigger>
                    <DataTrigger TargetType="Label"
                                 Binding="{Binding IsPurgeStatusError}"
                                 Value="False">
                        <Setter Property="TextColor"
                                Value="{AppThemeBinding Light=#388E3C, Dark=#66BB6A}"/>
                    </DataTrigger>
                </Label.Triggers>
            </Label>

            <Button x:Name="PurgeDatabaseButton"
                    Text="Reset Device"
                    FontSize="18"
                    BackgroundColor="{AppThemeBinding Light=#D32F2F, Dark=#C62828}"
                    TextColor="White"
                    CornerRadius="8"
                    HeightRequest="60"
                    IsEnabled="{Binding IsPurging, Converter={toolkit:InvertedBoolConverter}}"
                    Command="{Binding PurgeDatabaseCommand}"/>

        </StackLayout>
    </ScrollView>

</ContentPage>
