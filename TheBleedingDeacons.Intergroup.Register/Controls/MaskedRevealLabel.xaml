<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="TheBleedingDeacons.Intergroup.Register.Controls.MaskedRevealLabel"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Name="RootView">

    <Border
        BackgroundColor="{Binding BackgroundColor, Source={x:Reference RootView}}"
        Stroke="{Binding BorderColor, Source={x:Reference RootView}}"
        StrokeThickness="{Binding BorderThickness, Source={x:Reference RootView}}">
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="{Binding CornerRadius, Source={x:Reference RootView}}" />
        </Border.StrokeShape>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Label
                x:Name="InternalLabel"
                Grid.Column="0"
                Margin="10,0,0,0"
                BackgroundColor="Transparent"
                FontSize="{Binding FontSize, Source={x:Reference RootView}}"
                HeightRequest="{Binding ControlHeight, Source={x:Reference RootView}}"
                HorizontalTextAlignment="{Binding HorizontalTextAlignment, Source={x:Reference RootView}}"
                LineBreakMode="TailTruncation"
                Text="{Binding DisplayText, Source={x:Reference RootView}}"
                TextColor="{Binding TextColor, Source={x:Reference RootView}}"
                VerticalTextAlignment="{Binding VerticalTextAlignment, Source={x:Reference RootView}}" />

            <Button
                x:Name="RevealButton"
                Grid.Column="1"
                BackgroundColor="{Binding RevealButtonColor, Source={x:Reference RootView}}"
                BorderWidth="0"
                FontSize="16"
                IsVisible="{Binding IsRevealButtonVisible, Source={x:Reference RootView}}"
                Pressed="OnRevealPressed"
                Released="OnRevealReleased"
                Text="Show"
                TextColor="White" />
        </Grid>
    </Border>

</ContentView>