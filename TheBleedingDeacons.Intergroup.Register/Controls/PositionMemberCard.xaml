<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="TheBleedingDeacons.Intergroup.Register.Controls.PositionMemberCard"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:TheBleedingDeacons.Intergroup.Register.Controls"
    xmlns:entities="clr-namespace:TheBleedingDeacons.Unity.Intergroup.Entities;assembly=TheBleedingDeacons.Unity.Intergroup"
    x:Name="PositionMemberCardRoot">

    <!--
        Reusable card-body view for displaying a position-holder Member's
        Name / Personal Email / Mobile Phone / Rotation Date, with a
        hold-to-reveal Reveal button that unmasks the masked fields while
        held. Mirrors GroupMemberCard but adds the Rotation Date row used on
        position pages (Verify Position, Edit Position).

        Kept as a separate control rather than composing GroupMemberCard so each
        card has a flat, obvious structure and an independent layout — the
        position pages can evolve their card without dragging GroupMemberCard
        with them. The trade-off is some duplication of the field bindings
        and Reveal handler.

        See GroupMemberCard.xaml for the same notes on the explicit
        <ContentView.Content> wrapper, BindingContext-on-stack pattern,
        and ActionContent slot.
    -->
    <ContentView.Content>
        <!--
            Outer Grid: the inner stack fills the cell, while the Reveal button
            is overlaid in the top-right corner. See GroupMemberCard.xaml for
            the rationale on this pattern.
        -->
        <Grid>
            <VerticalStackLayout
                BindingContext="{Binding Member, Source={x:Reference PositionMemberCardRoot}, x:DataType=controls:PositionMemberCard}"
                x:DataType="entities:Member"
                Spacing="6">

                <Label Style="{StaticResource FieldLabelStyle}" Text="Name" />
                <Label
                    Style="{StaticResource ValueLabelStyle}"
                    Text="{Binding AnonymousName}"
                    TextDecorations="{Binding ValueTextDecorations, Source={x:Reference PositionMemberCardRoot}, x:DataType=controls:PositionMemberCard}" />

                <Label Style="{StaticResource FieldLabelStyle}" Text="Personal Email" />
                <controls:MaskedRevealLabel
                    x:Name="EmailReveal"
                    Margin="0,0,0,4"
                    BackgroundColor="Transparent"
                    FontSize="16"
                    MaskType="Email"
                    ShowRevealButton="False"
                    TextColor="{AppThemeBinding Light={StaticResource Gray900},
                                                Dark={StaticResource Gray100}}"
                    Value="{Binding PersonalEmail}" />

                <Label Style="{StaticResource FieldLabelStyle}" Text="Mobile Phone" />
                <controls:MaskedRevealLabel
                    x:Name="MobileReveal"
                    Margin="0,0,0,4"
                    BackgroundColor="Transparent"
                    FontSize="16"
                    MaskType="Mobile"
                    ShowRevealButton="False"
                    TextColor="{AppThemeBinding Light={StaticResource Gray900},
                                                Dark={StaticResource Gray100}}"
                    Value="{Binding MobileNumber}" />

                <Label Style="{StaticResource FieldLabelStyle}" Text="Rotation Date" />
                <Label
                    Style="{StaticResource ValueLabelStyle}"
                    Text="{Binding IntergroupPositionRotation}"
                    TextDecorations="{Binding ValueTextDecorations, Source={x:Reference PositionMemberCardRoot}, x:DataType=controls:PositionMemberCard}" />

                <!--
                    Action slot. The caller-supplied view is parented here in code
                    via the ActionContent property-changed handler — see code-behind.
                -->
                <ContentView x:Name="ActionSlot" />

            </VerticalStackLayout>

            <!--
                Hold-to-reveal Reveal button — pinned to the top-right corner of
                the card. Hidden when ShowRevealButton is false (e.g. on the
                "removed members" variant where revealing PII feels wrong).
            -->
            <Button
                HeightRequest="36"
                HorizontalOptions="End"
                IsVisible="{Binding ShowRevealButton, Source={x:Reference PositionMemberCardRoot}, x:DataType=controls:PositionMemberCard}"
                Pressed="OnRevealPressed"
                Released="OnRevealReleased"
                Style="{StaticResource M3SecondaryButtonStyle}"
                Text="Reveal"
                VerticalOptions="Start"
                WidthRequest="100" />
        </Grid>
    </ContentView.Content>

</ContentView>
