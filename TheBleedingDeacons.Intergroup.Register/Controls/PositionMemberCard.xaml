<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="TheBleedingDeacons.Intergroup.Register.Controls.PositionMemberCard"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:TheBleedingDeacons.Intergroup.Register.Controls"
    x:Name="PositionMemberCardRoot">

    <!--
        Reusable card-body view for displaying a position-holder Member's
        Name / Personal Email / Mobile Phone / Rotation Date, with a
        hold-to-reveal Reveal button that unmasks the masked fields while
        held. Mirrors MemberCard but adds the Rotation Date row used on
        position pages (Verify Position, Edit Position).

        Kept as a separate control rather than composing MemberCard so each
        card has a flat, obvious structure and an independent layout — the
        position pages can evolve their card without dragging MemberCard
        with them. The trade-off is some duplication of the field bindings
        and Reveal handler.

        See MemberCard.xaml for the same notes on the explicit
        <ContentView.Content> wrapper, BindingContext-on-stack pattern,
        and ActionContent slot.
    -->
    <ContentView.Content>
        <VerticalStackLayout BindingContext="{Binding Member, Source={x:Reference PositionMemberCardRoot}}" Spacing="6">

            <Label Style="{StaticResource FieldLabelStyle}" Text="Name" />
            <Label
                Style="{StaticResource ValueLabelStyle}"
                Text="{Binding AnonymousName}"
                TextDecorations="{Binding ValueTextDecorations, Source={x:Reference PositionMemberCardRoot}}" />

            <Label Style="{StaticResource FieldLabelStyle}" Text="Personal Email" />
            <controls:MaskedRevealLabel
                x:Name="EmailReveal"
                Margin="0,0,0,4"
                BackgroundColor="Transparent"
                FontSize="16"
                MaskType="Email"
                ShowRevealButton="False"
                TextColor="{AppThemeBinding Light={StaticResource Gray900},
                                            Dark={StaticResource Gray100}}"
                Value="{Binding PersonalEmail}" />

            <Label Style="{StaticResource FieldLabelStyle}" Text="Mobile Phone" />
            <controls:MaskedRevealLabel
                x:Name="MobileReveal"
                Margin="0,0,0,4"
                BackgroundColor="Transparent"
                FontSize="16"
                MaskType="Mobile"
                ShowRevealButton="False"
                TextColor="{AppThemeBinding Light={StaticResource Gray900},
                                            Dark={StaticResource Gray100}}"
                Value="{Binding MobileNumber}" />

            <Label Style="{StaticResource FieldLabelStyle}" Text="Rotation Date" />
            <Label
                Style="{StaticResource ValueLabelStyle}"
                Text="{Binding IntergroupPositionRotation}"
                TextDecorations="{Binding ValueTextDecorations, Source={x:Reference PositionMemberCardRoot}}" />

            <!--  Hold-to-reveal Reveal button. Hidden when ShowRevealButton is false.  -->
            <Button
                Margin="0,8,0,0"
                HeightRequest="44"
                HorizontalOptions="Center"
                IsVisible="{Binding ShowRevealButton, Source={x:Reference PositionMemberCardRoot}}"
                Pressed="OnRevealPressed"
                Released="OnRevealReleased"
                Style="{StaticResource M3SecondaryButtonStyle}"
                Text="Reveal"
                WidthRequest="160" />

            <!--
                Action slot. The caller-supplied view is parented here in code
                via the ActionContent property-changed handler — see code-behind.
            -->
            <ContentView x:Name="ActionSlot" />

        </VerticalStackLayout>
    </ContentView.Content>

</ContentView>
