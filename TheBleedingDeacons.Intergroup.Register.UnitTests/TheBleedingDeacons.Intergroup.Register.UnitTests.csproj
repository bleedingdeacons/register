<Project Sdk="Microsoft.NET.Sdk">

	<!--
		Unit tests for the Register MAUI app.

		WHY net9.0-windows AND NOT net9.0:
		The app under test is a MAUI single-project app whose only target
		frameworks are platform heads (android / ios / maccatalyst / windows).
		A plain net9.0 test project cannot reference it — there is no
		platform-neutral head to resolve against. The Windows head is the one
		that can host an ordinary console test runner on an ordinary machine,
		so the tests target it and run in-process against the same assembly the
		Windows app ships.

		Consequence: this project builds and runs on Windows only. The existing
		net9.0 Unity.Intergroup.Tests project stays on the Ubuntu CI runner;
		these tests belong on a windows-latest runner (see README notes).

		WHY NOT UseMaui=true HERE:
		Setting it would pull in the MAUI/WinUI *application* plumbing, which
		forces OutputType to WinExe — and xUnit v3 refuses to build a test
		project that is not a plain Exe. The tests only need MAUI's reference
		assemblies (for types like IValueConverter), so Microsoft.Maui.Controls
		is referenced as an ordinary package instead and the test host stays a
		console app. No WinUI type is ever constructed by these tests; see the
		"MAUI statics" note in the test plan for what that rules out.
	-->
	<PropertyGroup>
		<TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
		<SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<Platforms>AnyCPU</Platforms>

		<!-- xUnit v3 test projects are executables that host Microsoft.Testing.Platform. -->
		<OutputType>Exe</OutputType>
		<IsPackable>false</IsPackable>
		<IsTestProject>true</IsTestProject>
		<!-- Run through Microsoft.Testing.Platform (not VSTest) under `dotnet test`. -->
		<TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
		<UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>

		<!--
			Belt and braces: keep the Windows App SDK from injecting its
			bootstrap module initializer into the test assembly too. See the
			longer note on the ProjectReference below for why this matters.
		-->
		<WindowsAppSdkBootstrapInitialize>false</WindowsAppSdkBootstrapInitialize>
		<WindowsAppSdkDeploymentManagerInitialize>false</WindowsAppSdkDeploymentManagerInitialize>

		<!-- Test project: exempt from the repo's strict analyzer gate. -->
		<RunAnalyzers>false</RunAnalyzers>

		<!--
			The app under test raises XAML binding warnings to errors. That gate
			belongs to the app build, not to a project that compiles no XAML.
		-->
		<WarningsAsErrors />
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="xunit.v3" Version="3.2.2" />
		<PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
		<!-- Reference assemblies only — see the OutputType note above. Keep the
		     version in step with the app's own Microsoft.Maui.Controls reference. -->
		<PackageReference Include="Microsoft.Maui.Controls" Version="9.0.120" />
		<!--
			Coverage is collected with the coverlet.console tool (see
			.config/dotnet-tools.json), which wraps the Microsoft.Testing.Platform
			test executable. coverlet's collector/msbuild integrations hook VSTest,
			which MTP does not use, so they are intentionally not referenced here.
		-->
		<!-- In-memory SQLite for the MailDbContext / UnityDbContext tests. -->
		<PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="9.0.9" />
	</ItemGroup>

	<ItemGroup>
		<!--
			Three properties are forced onto the app for the test-time build.

			UseDevCredentials=false matters more than it looks. The app's default
			is true, which defines USE_DEV_CREDENTIALS and makes
			ConfigurationService short-circuit to an embedded devsettings.json
			for SMTP, Unity and compliance-email values — bypassing the
			Preferences/SecureStorage logic that the tests exist to cover, and
			binding the results to a git-ignored file that CI does not have.
			Building the app the way it ships keeps the tests deterministic and
			pointed at the code that actually runs in production.

			RegisterWindowsOnly narrows the app to its Windows head so building
			these tests needs only the maui-windows workload — no Android SDK,
			no JDK, no iOS/MacCatalyst. Set here rather than on the command line
			so a plain `dotnet build`/`dotnet test` of this project Just Works.

			WindowsAppSdk*Initialize=false is load-bearing. A MAUI Windows app
			is an MSIX app, so the Windows App SDK compiles a module initializer
			into the *app* assembly that bootstraps the WindowsAppRuntime. In a
			console test host there is no package identity and no registered
			runtime, so that initializer throws REGDB_E_CLASSNOTREG the instant
			any type from the app assembly is touched — every test fails before
			its body runs, with a stack trace that names WinRT and not your code.
			Turning it off costs nothing here because these tests never construct
			a WinUI object.

			Consequence: the app's obj/bin for the Windows head is rebuilt when
			you alternate between building the app and building these tests,
			because the global property set differs. That is a rebuild cost, not
			a correctness problem — the only difference in the emitted assembly
			is the absence of the bootstrap initializer.
		-->
		<ProjectReference Include="..\TheBleedingDeacons.Intergroup.Register\TheBleedingDeacons.Intergroup.Register.csproj">
			<AdditionalProperties>RegisterWindowsOnly=true;UseDevCredentials=false;WindowsAppSdkBootstrapInitialize=false;WindowsAppSdkDeploymentManagerInitialize=false</AdditionalProperties>
		</ProjectReference>
	</ItemGroup>

</Project>
