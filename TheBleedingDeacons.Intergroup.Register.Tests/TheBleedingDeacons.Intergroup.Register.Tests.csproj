<Project Sdk="Microsoft.NET.Sdk">

  <!--
    xUnit v3 over Register.Core: the edges.

    Where the inputs that misbehave live - a torn line in an event log, an
    SMTP server that refuses the password, a Scrutiny that answers HTML, a
    Freedom value that is not a number. The behaviour, in the words a meeting
    would use for it, belongs to the specification (Register.Specs); this is
    the part that reads better as method names than as sentences. Link
    splits its suites the same way, for the same reason.

    It references Register.Core for the reason Core exists at all: nothing
    can reference the app, whose only target frameworks are platform heads.

    Coverage is collected in CI by coverlet.console (see
    .config/dotnet-tools.json and the workflow), merged with
    Unity.Intergroup.Tests' run. coverlet's collector/msbuild integrations
    hook VSTest, which Microsoft.Testing.Platform does not use, so they are
    deliberately not referenced here.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- xUnit v3 test projects are executables that host Microsoft.Testing.Platform. -->
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Run through Microsoft.Testing.Platform (not VSTest) under `dotnet test`. -->
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <!-- Test project: exempt from the repo's strict analyzer gate. -->
    <RunAnalyzers>false</RunAnalyzers>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
    <!-- In-memory SQLite for the mail queue and the Unity replica, as Unity.Intergroup.Tests does. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TheBleedingDeacons.Intergroup.Register.Core\TheBleedingDeacons.Intergroup.Register.Core.csproj" />
  </ItemGroup>

</Project>
