<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!--
    Integrity.Client is published to GitHub Packages from the integrity-sharp
    repo. The GitHub Packages NuGet registry requires authentication even for
    packages from public repositories, hence the credentials below.

    <clear /> drops any machine- or user-level sources so restore resolves the
    same way everywhere, then re-adds nuget.org explicitly.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="bleedingdeacons" value="https://nuget.pkg.github.com/bleedingdeacons/index.json" />
  </packageSources>

  <!--
    Without source mapping NuGet queries every source for every package, so a
    GitHub Packages auth failure can fail the restore of unrelated nuget.org
    packages. Mapping pins each package to exactly one source: Integrity.* to
    the private feed, everything else to nuget.org.

    Note this is exhaustive — a package matching no pattern will not be found,
    so new first-party package prefixes must be added here.
  -->
  <packageSourceMapping>
    <packageSource key="bleedingdeacons">
      <package pattern="Integrity.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>

  <!--
    %GITHUB_PACKAGES_TOKEN% is expanded by NuGet at restore time, so no token is
    stored in this file and it is safe to commit. Set it to a PAT with the
    read:packages scope — read-only; do not reuse integrity-sharp's publishing
    token, which also carries write:packages and repo.

        [Environment]::SetEnvironmentVariable('GITHUB_PACKAGES_TOKEN', '<token>', 'User')

    The username is not meaningful to GitHub Packages — the token authenticates
    the request — but it has to be non-empty.
  -->
  <packageSourceCredentials>
    <bleedingdeacons>
      <add key="Username" value="bleedingdeacons" />
      <add key="ClearTextPassword" value="%GITHUB_PACKAGES_TOKEN%" />
    </bleedingdeacons>
  </packageSourceCredentials>

</configuration>
